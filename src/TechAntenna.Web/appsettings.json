  "HuggingFacePapers": {
    "Enabled": true
  },
  "Arxiv": {
    "Enabled": true,
    "MaxResults": 20,
    "DelaySeconds": 3
  },
  "Jstage": {
    "Enabled": true,
    "MaxResults": 20,
    "WithinYears": 2,
    "DelaySeconds": 3
  },
  "Connpass": {
    "Keywords": [ "AI", "生成AI", "LLM", "AIエージェント", "機械学習" ],
    "Sweep": {
      "MinParticipants": 100,
      "Months": 2,
      "DelayBetweenRequestsSeconds": 5
    }
  },
  "Doorkeeper": {
    "Keywords": [
      "AI",
      "生成AI",
      "LLM",
      "AIエージェント",
      "機械学習"
    ],
    "Sweep": {
      "MinParticipants": 100,
      "Months": 2,
      "DelayBetweenRequestsSeconds": 2
    }
  },
  "TechPlay": {
    "FeedUrl": "https://rss.techplay.jp/event/w3c-rss-format/rss.xml"
  },
  "Books": {
    "DelayBetweenKeywordsSeconds": 2,
    "UseOpenBd": true,
    "MinReviewCount": 0,
    "CoverLookupDelaySeconds": 1
  },
  "NewReleases": {
    "Enabled": true,
    "WindowMonths": 6,
    "MaxItems": 600,
    "NdcCodes": [ "007" ],
    "DelayBetweenPagesSeconds": 1
  },
  "Qiita": {
    "Enabled": true,
    "Queries": [
      "tag:技術書 stocks:>100",
      "tag:書籍 stocks:>20",
      "おすすめ 技術書 stocks:>100"
    ],
    "MaxArticles": 200,
    "DelaySeconds": 1,
    "Citations": {
      "Enabled": true,
      "Queries": [ "tag:{topic} stocks:>50" ],
      "MaxArticles": 100
    }
  },
  "Rakuten": {
    "DelaySeconds": 1
  },
  "Anthropic": {
    "Model": "claude-opus-5",
    "BatchSize": 20
  },
  "Chiezo": {
    "BaseUrl": "",
    "TimeoutSeconds": 300
  },
  "ClaudeCode": {
    "ExecutablePath": "claude",
    "Model": "claude-sonnet-5",
    "TimeoutSeconds": 300
  },
  "Digest": {
    "WindowHours": 48,
    "TrendingCount": 12,
    "InterestCount": 10,
    "EventCount": 8,
    "EventWindowDays": 14
  },
  "Ntfy": {
    "ClickUrl": ""
  }
