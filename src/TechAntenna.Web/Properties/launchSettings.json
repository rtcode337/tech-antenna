{
  "$schema": "https://json.schemastore.org/launchsettings.json",
    "profiles": {
      "http": {
        "commandName": "Project",
        "dotnetRunMessages": true,
        "launchBrowser": true,
        "applicationUrl": "http://localhost:7020",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "watch": {
        "commandName": "Project",
        "dotnetRunMessages": true,
        "launchBrowser": false,
        // LAN・VPN の他の端末から見えるよう 0.0.0.0 に bind する(localhost だと
        // loopback だけになり、スマホや外出先からは届かない)。
        // このマシンからは http://localhost:7022 でそのまま開ける
        "applicationUrl": "http://0.0.0.0:7022",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "https": {
        "commandName": "Project",
        "dotnetRunMessages": true,
        "launchBrowser": true,
        "applicationUrl": "https://localhost:7023;http://localhost:7020",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      }
    }
  }
