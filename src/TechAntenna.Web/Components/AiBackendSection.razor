@using TechAntenna.Infrastructure.Chiezo
@using TechAntenna.Web.Services
@inject ChiezoAi Chiezo
@inject ApiCredentials Credentials

@* どの AI に書かせるかを選ぶ部品。**置き場は外部連携の画面の一番上**(かつては
   `/settings/ai` という別ページだった)—— キーの設定と同じ「外の相手をどう使うか」の話で、
   別ページに分けると、要約が動かないときに見る場所が2つに割れる。
   `/settings/ai` は外部連携へリダイレクトする(ブックマークを切らさないため)。

   **相手は Chiezo(LAN 内の知識サーバー)に登録してあるものから選ぶ** —— 鍵はあちらが
   持っているので、こちらは相手を選ぶだけでよい。Chiezo の URL が未設定なら、
   この部品は設定の仕方を出すだけ(従来どおりサイドカーの CLI ブリッジ / Anthropic API で動く) *@

<h2 class="axis">どの AI に書かせるか</h2>

<p class="page-note text-muted">
    要約・翻訳・タグの仕分け・今日のサマリーを<strong>どの AI に書かせるか</strong>を選びます。
    相手は <strong>Chiezo に登録してあるもの</strong>から選べます(鍵は Chiezo が持っているので、
    こちらにキーを入れる必要はありません)。
    <strong>サブの AI は今日のサマリーだけ</strong>メインと同時に書き、
    ホームでタブを切り替えて読み比べられます。
</p>

@if (!Chiezo.IsConfigured)
{
    <p class="text-muted">
        <strong>Chiezo の URL が未設定です。</strong>
        環境変数 <code>Chiezo__BaseUrl</code>(compose なら <code>CHIEZO_URL</code>)に
        <code>http://chiezo-api:7010</code> のような URL を入れて起動すると、ここで相手を選べます。
        未設定のあいだは<strong>従来どおり</strong> Claude Code(CLI ブリッジ)か
        Anthropic API で動きます。
    </p>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <p class="text-danger">@_error</p>
    }
    else if (_message is { Length: > 0 })
    {
        <p class="text-body-secondary">@_message</p>
    }

    @if (_backends is null)
    {
        <p>Chiezo(@Chiezo.BaseUrl)に問い合わせ中…</p>
    }
    else if (_backends.Count == 0)
    {
        <p class="text-muted">
            Chiezo に話せる相手がいません。Chiezo の管理画面(<code>/admin</code>)で
            「答える」層を有効にし、使う相手を on にしてください。
        </p>
    }
    else
    {
        @* **1 つのフォームにまとめる。** メインとサブは同時に決まっていないと、
           「サブに選んだ相手がメインでもある」状態を作れてしまう *@
        <form method="post" @formname="ai" @onsubmit="SaveAsync" class="ai-form">
            <AntiforgeryToken />
            @* スマホでは 1 行 1 枚のカードに畳む(選択欄が入るので詰めても収まらない。app.css の .table.stack) *@
            <table class="table stack">
                <thead>
                    <tr>
                        <th scope="col">相手</th>
                        <th scope="col">使い方</th>
                        <th scope="col">モデル</th>
                        <th scope="col">考える量</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var backend in _backends)
                    {
                        var role = RoleOf(backend.Id);
                        <tr>
                            <th scope="row">@backend.Label</th>
                            <td class="ai-role" data-label="使い方">
                                @* メインは1つだけ(ラジオ)、サブは何個でも(チェック)。
                                   同じ相手をメインとサブの両方にはできない *@
                                <label>
                                    <input type="radio" name="main" value="@backend.Id"
                                           checked="@(role == "main")" />
                                    メイン
                                </label>
                                <label>
                                    <input type="checkbox" name="sub" value="@backend.Id"
                                           checked="@(role == "sub")" />
                                    @* 但し書きは広い画面だけに出す —— カード表示では
                                       「メイン」と横並びにしたいので、字数を削る
                                       (意味は表の下の注記に書いてある) *@
                                    サブ<span class="wide-only">(サマリーのみ)</span>
                                </label>
                            </td>
                            <td data-label="モデル">
                                <select name="@($"model-{backend.Id}")" class="form-select">
                                    @if (!backend.ModelRequired)
                                    {
                                        <option value="" selected="@(ModelOf(backend.Id) is null or "")">
                                            相手の既定に任せる
                                        </option>
                                    }
                                    @foreach (var model in backend.Models)
                                    {
                                        <option value="@model" selected="@(ModelOf(backend.Id) == model)">
                                            @model
                                        </option>
                                    }
                                </select>
                            </td>
                            <td data-label="考える量">
                                @if (backend.Efforts.Count == 0)
                                {
                                    @* **選べない相手には出さない**(Chiezo が「無い」と言っている) *@
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <select name="@($"effort-{backend.Id}")" class="form-select">
                                        <option value="" selected="@(EffortOf(backend.Id) is null or "")">
                                            相手の既定に任せる
                                        </option>
                                        @foreach (var effort in backend.Efforts)
                                        {
                                            <option value="@effort" selected="@(EffortOf(backend.Id) == effort)">
                                                @effort
                                            </option>
                                        }
                                    </select>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <p class="text-muted">
                メインを選ばないと Chiezo は使いません(従来どおり Claude Code / Anthropic API で動きます)。
                サブは最大 @AiSettings.MaxSubs 個までです。
            </p>

            <button type="submit" class="btn btn-primary">保存</button>
        </form>
    }
}

@code {
    [CascadingParameter]
    HttpContext? HttpContext { get; set; }

    /// <summary>押されたことだけ分かればよい(値は HttpContext から読む)。</summary>
    [SupplyParameterFromForm(FormName = "ai", Name = "Submitted")]
    public string? Submitted { get; set; }

    IReadOnlyList<ChiezoBackend>? _backends;
    AiConfig _config = AiConfig.Empty;
    string? _message;
    string? _error;

    protected override async Task OnInitializedAsync()
    {
        _config = AiSettings.Load(Credentials);
        await LoadBackendsAsync();
    }

    async Task LoadBackendsAsync()
    {
        if (Chiezo.Client() is not { } client)
        {
            return;
        }

        try
        {
            _backends = await client.GetBackendsAsync();
        }
        catch (Exception ex)
        {
            // 繋がらない理由(URL 違い・Chiezo 側で無効)はそのまま出す —— 直しようが分かる
            _backends = [];
            _error = ex.Message;
        }
    }

    string RoleOf(string backendId) =>
        _config.Main?.Backend == backendId ? "main"
            : _config.Subs.Any(sub => sub.Backend == backendId) ? "sub"
            : "";

    string? ModelOf(string backendId) => Choice(backendId)?.Model;

    string? EffortOf(string backendId) => Choice(backendId)?.Effort;

    AiChoice? Choice(string backendId) =>
        _config.Main?.Backend == backendId
            ? _config.Main
            : _config.Subs.FirstOrDefault(sub => sub.Backend == backendId);

    async Task SaveAsync()
    {
        if (HttpContext is null || _backends is null)
        {
            return;
        }

        var form = HttpContext.Request.Form;
        var mainId = form["main"].ToString();
        var subIds = form["sub"].ToArray();

        var main = _backends.FirstOrDefault(b => b.Id == mainId);
        if (main is null)
        {
            _error = "メインの AI を選んでください。";
            return;
        }

        // **メインをサブから外す。** 同じ相手に2回書かせても比べる意味が無い
        var subs = _backends
            .Where(b => subIds.Contains(b.Id) && b.Id != main.Id)
            .Take(AiSettings.MaxSubs)
            .Select(ToChoice)
            .ToList();

        _config = new AiConfig(ToChoice(main), subs);
        await AiSettings.SaveAsync(Credentials, _config);
        _error = null;
        _message = subs.Count > 0
            ? $"メインを {main.Label}、サブを {subs.Count} 個 保存しました。再起動なしで反映されます。"
            : $"メインを {main.Label} に保存しました。再起動なしで反映されます。";

        AiChoice ToChoice(ChiezoBackend backend) => new(
            backend.Id,
            backend.Label,
            Value(form[$"model-{backend.Id}"].ToString()),
            Value(form[$"effort-{backend.Id}"].ToString()));

        static string? Value(string raw) => string.IsNullOrWhiteSpace(raw) ? null : raw;
    }
}
