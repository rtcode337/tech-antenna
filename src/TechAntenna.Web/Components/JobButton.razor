@using TechAntenna.Web.Services
@inject NavigationManager Navigation

@* ジョブ1件。定期実行のチェックと実行ボタンを同じ行に置くので、
   この部品は form を作らず、ページ側の1つのフォームの中に置く(form は入れ子にできない)。
   押された行は submit ボタンの value(`run:<キー>`)で見分ける —— タグの画面と同じ流儀。

   見た目は2つ。一覧に並ぶときは表の行(`AsRow`。定期実行 / ジョブ / 状態 / 今すぐ実行)、
   単独で置くときは横並びの div。表にするのは、ジョブが 10 個あってボタンの幅も結果の
   文言の長さもばらばらだと、チェック・ボタン・状態が行ごとに違う位置に来て
   読み比べられないため。

   表では名前とボタンを分ける。名前は「ジョブ」の列に文字として置き(説明があれば
   その下)、押すところは一番右の「今すぐ実行」に固定する —— ボタンの文字が名前を
   兼ねていた頃は、名前の長さでボタンの幅が変わって押す位置が行ごとに動いた。

   実行はバックグラウンドで開始してすぐ応答を返す。数分かかるジョブを await すると、
   全ページ静的 SSR のこのアプリでは押した人が白い画面を待つことになる。
   実行中は meta refresh の自動リロードで進捗(Runner.Progress)を追う(JS は使わない)。
   結果の文言は Runner(LastMessage / LastError)が持つ —— ページのフィールドに置くと
   自動リロードのたびに消える。 *@

@{
    @* チェックは「この時刻の回に含めるか」。同じ行に置く —— 別の場所に一覧を作ると、
       どのボタンの設定なのかを名前で照合することになる。
       name を共有した配列で受ける(値がジョブのキー)。
       ScheduleKey が無い行(定期実行そのものを走らせるボタン)にはチェックを出さない。
       チェックは触った時点で保存される(wwwroot/job-schedule.js)—— 素の HTML
       としては従来どおりフォームの一部で、JS が動かなくても「定期実行の設定を保存」で保存できる *@
    RenderFragment scheduleCell =
    @<text>
        @if (ScheduleKey is { Length: > 0 } key)
        {
            <label class="job-schedule"
                   title="@($"定期実行に含める（{Order} 番目に走ります）")">
                <input type="checkbox" name="Jobs" value="@key" checked="@Enabled"
                       aria-label="@($"{Name} を定期実行に含める")" />
                <span class="job-order" aria-hidden="true">@Order</span>
            </label>
        }
    </text>;

    @* 未設定でもボタンは消さずに disabled で出す —— 消すと「そういう機能がある」
       こと自体が画面から分からず、何を設定すれば使えるのかへも辿り着けない。
       表では字は「実行」だけ(名前は左の列にある)。同じ字のボタンが縦に並ぶので、
       読み上げ向けに aria-label でどのジョブかを言う *@
    RenderFragment runButton =
    @<text>
        <button type="submit" name="Action" value="@Action"
                class="btn btn-outline-primary btn-sm"
                aria-label="@(AsRow ? $"{Name} を今すぐ実行" : null)"
                disabled="@(!Runner.IsConfigured || Runner.IsRunning)">
            @(AsRow ? "実行" : Name)
        </button>
    </text>;

    RenderFragment status =
    @<text>
        @if (Runner.IsRunningOperation(Key))
        {
            @* 実行中は 3 秒ごとに自動リロードして進捗を出す。URL を明示した GET にするのは、
               POST 応答の再読み込みでフォームが再送されるのを避けるため *@
            <HeadContent>
                <meta http-equiv="refresh" content="3;url=@CurrentPath" />
            </HeadContent>
            <span class="running">@(Runner.Progress ?? "実行中…")</span>
        }
        else if (!Runner.IsConfigured)
        {
            <span class="text-body-secondary">
                @(Runner.NotConfiguredReason ?? "設定が足りないため実行できません。")
                <a href="/settings/integrations">外部連携</a>から設定できます。
            </span>
        }
        else if (Runner.IsRunning)
        {
            @* 同じ Runner の別の入口が走っている(トピックの整備は話題度と仕分けで1つ)。
               ボタンが押せない理由を書いておく —— 黙って disabled だと壊れて見える *@
            <span class="text-body-secondary">別の操作が実行中です。</span>
        }
        else if (Runner.LastErrorOf(Key) is { Length: > 0 } error)
        {
            <span class="text-danger">失敗: @error</span>
        }
        else if (Runner.LastMessageOf(Key) is { Length: > 0 } message)
        {
            <span class="text-body-secondary">@message</span>
        }
    </text>;
}

@if (AsRow)
{
    @* どのセルにも `data-label` を付ける。スマホ(.table.stack)では
       `data-label` の無いセルがカードの題(太字)になるが、ジョブの名前は列の1つ
       (一番左は定期実行)なので、題として太く大きく出ると見出しの無い塊に見える ——
       他の列と同じように「ジョブ」の見出しを添えて、字も普通のままにする *@
    <tr>
        <td data-label="定期実行">@scheduleCell</td>
        <td class="job-name-cell" data-label="ジョブ">
            <span class="job-name">@Name</span>
            @if (ChildContent is not null)
            {
                @* 説明・注意・説明チップの ? は名前の下へ。押す前に読むものなので、
                   状態の列(押した後に読むところ)には置かない *@
                <div class="job-desc">@ChildContent</div>
            }
        </td>
        <td class="job-status" data-label="状態">@status</td>
        <td data-label="今すぐ実行">@runButton</td>
    </tr>
}
else
{
    <div class="job-row">
        @scheduleCell
        @runButton
        @status
        @ChildContent
    </div>
}

@code {
    /// <summary>実行中・未設定・結果の判定に使う Runner。</summary>
    [Parameter, EditorRequired]
    public JobRunner Runner { get; set; } = default!;

    /// <summary>
    /// ジョブの名前。表では「ジョブ」の列に出し、単独の div ではボタンの文字になる。
    /// </summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    /// <summary>押されたことを見分ける submit の value(ページ側が振り分ける)。</summary>
    [Parameter, EditorRequired]
    public string Action { get; set; } = "";

    /// <summary>
    /// 実行中・結果の文言を引く入口の名前(<see cref="JobRunner"/> に渡すもの)。
    /// 1つの Runner に入口が2つあるジョブで、片方を走らせたときにもう片方の行にも
    /// 「実行中…」が出ないようにするために要る。省略すると <see cref="Action"/>。
    /// </summary>
    [Parameter]
    public string? Operation { get; set; }

    string Key => Operation ?? Action;

    /// <summary>
    /// 定期実行の設定キー。null なら定期実行のチェックを出さない
    /// (定期実行そのものを走らせるボタンは、自分を定期実行に入れられない)。
    /// </summary>
    [Parameter]
    public string? ScheduleKey { get; set; }

    /// <summary>定期実行での順番(1 始まり)。画面の並びは実行順と違うので行に出す。</summary>
    [Parameter]
    public int Order { get; set; }

    /// <summary>定期実行に含める設定になっているか(チェックの初期値)。</summary>
    [Parameter]
    public bool Enabled { get; set; }

    /// <summary>
    /// 表の行(<c>&lt;tr&gt;</c>)として描くか。一覧に並ぶジョブは表、
    /// 単独で置くボタン(「定期実行を今すぐ実行」)は横並びの div。
    /// </summary>
    [Parameter]
    public bool AsRow { get; set; }

    /// <summary>
    /// ジョブの説明(説明チップの「?」や、押す前に知らせたい注意)。
    /// 表では名前の下に出る —— 押す前に読むものなので、状態の列には置かない。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    string CurrentPath =>
        "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
}
