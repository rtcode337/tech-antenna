@using TechAntenna.Web.Services
@inject NavigationManager Navigation

@* ジョブを手動で走らせるボタン。開発環境では定期実行を止めてあるので、ここから起動する。

   静的 SSR のフォーム POST。押すとジョブを**バックグラウンドで開始してすぐ応答を返し**、
   実行中は meta refresh の自動リロードで進捗(Runner.Progress)を追う —— 数分かかる
   ジョブを await で待つと、押した人は応答が返るまで白い画面を見続けることになる。
   JS も対話回線(WebSocket)も使わない(このアプリは全ページ静的 SSR)。

   結果の文言は Runner(LastMessage / LastError)が持つ。POST をまたいで表示するためで、
   ページ側のフィールドでは自動リロードのたびに消えてしまう。
   @formname はフォームを見分けるのに使われるので、ページ内で重複しない名前を渡すこと。 *@

@if (Runner.IsConfigured)
{
    <form method="post" @formname="@FormName" @onsubmit="RunAsync" class="mb-3">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-outline-primary btn-sm" disabled="@Runner.IsRunning">
            @(Label is { Length: > 0 } label ? label : Runner.Name)
        </button>
        @if (Runner.IsRunning)
        {
            @* 実行中は 3 秒ごとに自動リロードして進捗を出す。URL を明示した GET にするのは、
               POST 応答の再読み込みでフォームが再送されるのを避けるため *@
            <HeadContent>
                <meta http-equiv="refresh" content="3;url=@CurrentPath" />
            </HeadContent>
            <span class="ms-2 running">@(Runner.Progress ?? "実行中…")</span>
        }
        else if (Runner.LastError is { Length: > 0 } error)
        {
            <span class="ms-2 text-danger">失敗: @error</span>
        }
        else if (Runner.LastMessage is { Length: > 0 } message)
        {
            <span class="ms-2 text-body-secondary">@message</span>
        }
    </form>
}
else
{
    @* 未設定でも**ボタンは消さずに disabled で出す** —— 消すと「そういう機能がある」
       こと自体が画面から分からず、何を設定すれば使えるのかへも辿り着けない *@
    <div class="mb-3">
        <button type="button" class="btn btn-outline-primary btn-sm" disabled>
            @(Label is { Length: > 0 } label ? label : Runner.Name)
        </button>
        <span class="ms-2 text-body-secondary">
            @(Runner.NotConfiguredReason ?? "設定が足りないため実行できません。")
            <a href="/integrations">外部連携</a>から設定できます。
        </span>
    </div>
}

@code {
    /// <summary>ボタンが動かすジョブ。未設定(IsConfigured=false)なら disabled で出し、
    /// 理由(NotConfiguredReason)と外部連携への導線を添える。</summary>
    [Parameter, EditorRequired]
    public JobRunner Runner { get; set; } = default!;

    /// <summary>フォームの識別子。同じページに複数置くときは別々の値にする。</summary>
    [Parameter, EditorRequired]
    public string FormName { get; set; } = "";

    /// <summary>ボタンが押されたときの処理。中で Runner.StartInBackground を呼ぶこと。</summary>
    [Parameter, EditorRequired]
    public EventCallback OnRun { get; set; }

    /// <summary>
    /// ボタンの文字。省略すると Runner.Name。**1 つの Runner に入口が 2 つある**ジョブ
    /// (トピックの整備)で、どちらを押すのかを書き分けるために持つ。
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    string CurrentPath =>
        "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    Task RunAsync() => OnRun.InvokeAsync();
}
