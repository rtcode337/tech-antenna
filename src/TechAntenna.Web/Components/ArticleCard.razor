@using TechAntenna.Core.Models

@* 記事1件ぶんのカード。親(/articles の注目)と子(記事一覧・ニュース・論文)で同じものを使う。

   ブックマーク数は**多いほど目立つ段階バッジ**で出す。並び順は新着のまま変えない ——
   並びまで人気順にすると「今日なにが出たか」を追う導線が壊れるため。 *@

<li class="article @(Selected ? "selected" : "")">
    @* 訳題があればそれを見出しにし、原題は下に小さく残す
       —— 原題を消すと他の文献と突き合わせられなくなる *@
    @if (Article.TitleJa is { Length: > 0 } titleJa)
    {
        <a href="@Article.Url" target="_blank" rel="noopener">@titleJa</a>
        <div class="original-title">@Article.Title</div>
    }
    else
    {
        <a href="@Article.Url" target="_blank" rel="noopener">@Article.Title</a>
    }
    @if (!string.IsNullOrEmpty(Article.Summary))
    {
        <div class="text-body-secondary">@Article.Summary</div>
    }
    <small class="text-muted">
        @if (Article.BookmarkCount is { } users and > 0)
        {
            <span class="users @Tier(users)" title="はてなブックマーク数">@users users</span>
        }
        @Article.SourceName
        @if (Article.PublishedAt is { } publishedAt)
        {
            <text> — @publishedAt.ToString("yyyy-MM-dd HH:mm zzz")</text>
        }
        @* 選んだトピックのタグだけ色を変える(なぜ強調されているかが分かるように) *@
        @foreach (var tag in Article.Tags)
        {
            <span class="badge ms-1 @(SelectedTags.Contains(tag) ? "bg-primary" : "bg-secondary")">@tag</span>
        }
    </small>
</li>

@code {
    [Parameter, EditorRequired]
    public Article Article { get; set; } = default!;

    /// <summary>選んだトピックの記事として強調するか。</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>選択中のトピックのキー(タグのバッジの色分けに使う)。</summary>
    [Parameter]
    public IReadOnlySet<string> SelectedTags { get; set; } = new HashSet<string>();

    /// <summary>
    /// ブックマーク数の段階。閾値ははてブの肌感 ——
    /// 10 users で「読まれている」、100 users で「話題になっている」。
    /// </summary>
    static string Tier(int users) => users switch
    {
        >= 100 => "users-high",
        >= 10 => "users-mid",
        _ => "users-low",
    };
}
