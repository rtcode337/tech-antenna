@page "/topics"
@using System.Text.Json
@using TechAntenna.Core
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Topics
@using TechAntenna.Infrastructure.Topics
@using TechAntenna.Web.Services
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject ITagStore TagStore
@inject TopicReorganizationRunner ReorganizationRunner
@inject TopicImporter Importer

<PageTitle>トピック - tech-antenna</PageTitle>

<h1>トピック</h1>

<p><a href="/settings">← 設定</a></p>

<p class="page-note text-muted">
    あらかじめ用意した語彙・外部トレンドで見つかった語・集めた記事などのタグを
    まとめてトピック一覧にします。<strong>収集対象に選んだトピックは消えない</strong>ので、
    選択が勝手に外れることはありません。
    トピック名を押すと、その語の<strong>同義語と親子ツリー</strong>、紐づいた記事・イベント・書籍が見られます。
    トピック名の横の「記事 N」は<strong>その語がタグに付いた記事の件数</strong>(配下は含みません)、
    後ろのかっこ書きが<strong>用語の一言説明</strong>です
    (幅に収まらない分はカーソルを当てると全文が出ます。スマホでは <code>?</code> を押すと出ます)。
    一覧に出るのは<strong>語彙(ツリー)に入っている語</strong>です
    (<strong>話題度 0 でも消えません</strong>)。まだ語彙に入っていない語は
    <a href="/tags">タグ</a>の画面にあり、そこで<strong>仕分けを手で直せます</strong>。
</p>

<p class="page-note text-muted">
    <strong>親を選ぶと、その配下のトピックもまとめて収集対象になります</strong>
    (保存のときに広げるので、チェックが外れていた子も選択されます)。
    イベントと書籍は<strong>トピック 1 つごとに外部へ問い合わせる</strong>ので、
    大きな親を選ぶとリクエスト数もその配下のぶんだけ増えます。
    子だけを外したいときは、親のチェックを外してから選び直してください。
</p>

@* 挙動が画面から分かるようにしておく(説明は再編成の実装と揃えること) *@
<details class="score-help">
    <summary>「トピックを再編成」は何をしている?</summary>
    <ol class="text-muted">
        <li><strong>話題度を取り直す</strong> —— Qiita の新着記事と、はてなブックマークの
            人気エントリーを<strong>押した時点でその場から</strong>取得します
            (記事の収集をいつ回したかには依存しません)</li>
        <li><strong>タグを作り直す(1 回目)</strong> —— 保存済みの記事・イベント・書籍のタグを
            生タグとカタログから組み直します。<strong>分類の前に走らせるのが要点</strong> ——
            正規化の規則やカタログを変えると、そこで初めて現れる語があり、
            後段だけで回すとその語は次に押すまで分類されません</li>
        <li><strong>未知の語を LLM が分類</strong> —— 上の「次の再編成で LLM に聞く語」に
            出ている語をそのまま渡します(<strong>今回のトレンドで新しく見つかった語は渡しません</strong> ——
            行として残り、次の回の対象になります)。
            既存トピックと同じ意味なら<strong>別名として吸収</strong>、
            粒度が違う語なら<strong>親付きの新トピック</strong>としてツリーへ、
            トピックでない語(メディア名・一般語)は<strong>一覧から取り除きます</strong>。
            判断できなかった語は 1 週間おいて再挑戦します。
            1 回に渡すのは 300 語までで、残りは次回に続きから。
            LLM が未設定ならこの手順は飛ばします(語は候補のまま残る)</li>
        <li><strong>用語の説明を埋める</strong> —— 説明がまだ無い用語に LLM が一言説明を付けます
            (トピック名の後ろのかっこ書きと、詳細ページに出ます)。<strong>新しく見つかった語の説明は
            手順 3(分類)の応答に相乗り</strong>していて追加の呼び出しはありません。ここで聞くのは
            以前から一覧にあって説明だけ無い語で、1 回に 300 語まで・<strong>1 語につき 1 回だけ</strong>
            (結果は保存され、次回は聞き直しません)。収集対象に選んだトピックから先に埋めます</li>
        <li><strong>タグを作り直す(2 回目)</strong> —— 今回の分類で増えた別名を、
            保存済みの記事・イベント・書籍のタグへ反映します</li>
        <li><strong>一覧を組み立てる</strong> —— 語彙・話題度・タグの件数を突き合わせて
            トピック一覧を書き込みます。話題度は親へも合算します</li>
    </ol>
</details>

@* 数字の意味が画面から分かるようにしておく(算出はトピック収集の実装と揃えること) *@
<details class="score-help">
    <summary>話題度はどう算出している?</summary>
    <ul class="text-muted">
        <li>算出は上の<strong>「トピックを再編成」の手順 1</strong> で行われます
            (別のタイミングで集めているわけではありません)</li>
        <li>材料は2つ、どちらも<strong>押した時点でその場から取得</strong>します。
            <strong>Qiita の新着記事(直近 7 日)</strong>は「いいね数」を、
            <strong>はてなブックマークの人気エントリー</strong>は「ブックマーク数」を
            重み(どちらも最低 1)として、記事に付いているタグとタイトルに出てくる
            トピックへ加算します</li>
        <li>別名(<code>人工知能</code> など)は正式表記(<code>AI</code>)へ寄せてから数えます</li>
        <li>材料ごとに<strong>合計を 100 とした割合</strong>に直してから足し合わせます
            (数値の桁が違う材料どうしを混ぜられるように。1 材料あたり最大 100)</li>
        <li><strong>ツリー表示の値は配下のトピックも合算</strong>した話題度、
            <strong>ランキング表示はその用語単体</strong>の話題度です</li>
        <li>「トピックを再編成」を押した時点の値で、自動では更新されません</li>
    </ul>
</details>

@* **次の再編成で LLM に聞く語**。対象は2つの束からできていて、片方(トレンド)は
   押すまで確定しない。候補の数だけを出していると「候補 1 語のはずが 30 語聞いている」と
   見えて挙動が読めないので、**前回実際に聞いた語も並べて出す** *@
<details class="score-help">
    <summary>次の再編成で LLM に聞く語(@NextCount 語@(NextOverflow > 0 ? $" / 次回以降に {NextOverflow} 語" : ""))</summary>
    <ul class="text-muted">
        <li>ここに出ている語が<strong>そのまま次の対象</strong>です。多いときは先頭
            <strong>@TopicReorganizationRunner.MaxTagsPerClassification 語</strong>までを 1 回で聞き、
            残りは次の回に回します(並びは「件数 + 話題度」の大きい順)</li>
        <li><strong>集めたデータのタグから</strong> —— まだ語彙に無く、<strong>3 回以上</strong>付いた語
            (バッジの括弧内が件数)。1〜2 回の語は誤記や一過性のタグが多いので聞きません</li>
        <li><strong>前回までのトレンドで見つかった語</strong> —— Qiita・はてブに現れた未分類の語
            (バッジの括弧内が話題度)。<strong>見つけた回では聞かず、次の回に回します</strong> ——
            その場で足すと、押すまで何語 LLM に流れるか分からなくなるため</li>
        <li><strong>一度聞いた語は聞き直しません</strong>(判断できなかった語だけ 1 週間後に再挑戦)</li>
    </ul>
    @if (_pending is { Count: > 0 })
    {
        <p class="candidate-list">
            @foreach (var candidate in _pending.Take(TopicReorganizationRunner.MaxTagsPerClassification))
            {
                <span class="badge bg-secondary">@CandidateLabel(candidate)</span>
            }
        </p>
        @if (NextOverflow > 0)
        {
            <p class="text-muted">次回以降に回る語(@NextOverflow 語):</p>
            <p class="candidate-list">
                @foreach (var candidate in _pending.Skip(TopicReorganizationRunner.MaxTagsPerClassification))
                {
                    <span class="badge bg-light">@CandidateLabel(candidate)</span>
                }
            </p>
        }
    }
    else
    {
        <p class="text-muted">聞く語はありません(語彙に入っていない新しい語が現れると、ここに出ます)。</p>
    }

    @if (_lastAsked.Count > 0)
    {
        <p class="text-muted">
            前回の実行で実際に聞いた語(@_lastAsked.Count 語@(_lastAskedAt is { } at
                ? $"。{at.ToLocalTime():yyyy-MM-dd HH:mm} 時点" : "")):
        </p>
        <p class="candidate-list">
            @foreach (var tag in _lastAsked)
            {
                <span class="badge bg-secondary">@tag</span>
            }
        </p>
    }
</details>

<JobButton Runner="ReorganizationRunner" FormName="reorganize-topics" OnRun="Reorganize" />

@* **語彙と仕分けをファイルで運ぶ。** LLM の仕分けは呼ぶたびに枠を使うので、本番で仕分けた
   結果を開発サーバーへ持って行けるようにしてある(逆向き・バックアップにも使える)。
   畳んであるのは、日々の操作ではないため *@
<details class="score-help transfer">
    <summary>ファイルで持ち出す / 取り込む</summary>
    <p>
        <strong>語彙(トピック)とタグの仕分けだけ</strong>を JSON で運びます。
        <strong>件数・話題度は入りません</strong> —— それは各環境が集めたデータの話なので、
        取り込んだ先では次の「トピックを再編成」が集め直します。
        取り込みは<strong>足し込みで、この環境にしか無い語彙や仕分けは消しません</strong>。
        <strong>画面から手で直した仕分けは守ります</strong>(ファイル側で上書きしません)。
    </p>

    <p><a class="btn btn-outline-primary btn-sm" href="/export/topics.json" download>JSON で書き出す</a></p>

    @* ファイルの受け取りは HttpContext から読む(静的 SSR のフォームはファイルを束縛しない) *@
    <form method="post" enctype="multipart/form-data" @formname="import-topics" @onsubmit="ImportAsync">
        <AntiforgeryToken />
        <p>
            <input type="file" name="file" accept=".json,application/json" required
                   aria-label="取り込むトピックのファイル" />
        </p>
        <p>
            <label>
                <input type="checkbox" name="import-selection" value="true" />
                収集対象の選択も取り込む
            </label>
            <span class="text-muted">
                （既定では取り込みません。イベントと書籍の検索語が黙って変わらないようにするためです）
            </span>
        </p>
        <button type="submit" class="btn btn-outline-primary btn-sm">ファイルを取り込む</button>
    </form>

    @if (_importMessage is { Length: > 0 })
    {
        <p class="import-result">@_importMessage</p>
    }
    @if (_importError is { Length: > 0 })
    {
        <p class="import-error">@_importError</p>
    }
</details>

@if (_topics is null)
{
    <p>読み込み中…</p>
}
else if (_topics.Count == 0)
{
    <p>まだトピックがありません。「トピックを再編成」を実行してください。</p>
}
else
{
    @* トピックの検索。**GET のフォーム**なので静的 SSR のまま動く(JS も回線も使わない)。
       選択の form とは入れ子にできないので、外に置いてある *@
    <form class="topic-search" method="get" action="/topics">
        @if (IsRanking)
        {
            <input type="hidden" name="view" value="ranking" />
        }
        <label for="topic-search">トピックを検索</label>
        <input id="topic-search" type="search" name="q" value="@Query"
               placeholder="生成AI / 人工知能 / rag …" />
        <button type="submit" class="btn btn-outline-primary btn-sm">検索</button>
        @if (HasQuery)
        {
            <a href="@(IsRanking ? "/topics?view=ranking" : "/topics")">クリア</a>
        }
    </form>

    @if (HasQuery)
    {
        <p class="search-result">
            @if (_matches.Count > 0)
            {
                <text>
                    「@Query」に一致するトピック <strong>@_matches.Count 件</strong>を開いて、
                    先頭にカーソルを合わせました（別名でも当たります）。
                </text>
            }
            else if (_glossaryHits.Count > 0)
            {
                <text>
                    「@Query」に一致するトピックはありません。
                    <a href="/tags">タグ</a>の側に @_glossaryHits.Count 件あります
                    （@string.Join("・", _glossaryHits.Take(5))@(_glossaryHits.Count > 5 ? " …" : "")）。
                </text>
            }
            else
            {
                <text>「@Query」に一致するトピックはありませんでした。</text>
            }
        </p>
    }

    @* 2つの見方を切り替える。ツリーは「どの領域が熱いか」(配下込みの話題度)、
       ランキングは「どの用語単体が熱いか」。切り替えはリンク(クエリ)で、JS は使わない *@
    <nav class="view-switch" aria-label="トピック一覧の表示切り替え">
        <a class="@(IsRanking ? "" : "active")" href="/topics">ツリー</a>
        <a class="@(IsRanking ? "active" : "")" href="/topics?view=ranking">ランキング(単体の話題度)</a>
    </nav>

    <form method="post" @formname="save-topic-selection" @onsubmit="SaveSelectionAsync" class="mb-3">
        <AntiforgeryToken />
        <p>チェックボックスで収集したいトピックを選び、「選択を保存」を押してください。</p>

        @if (IsRanking)
        {
            @* 単体の話題度が高い順。構造の語(親)は単体では上がってこない *@
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">収集</th>
                        <th scope="col">タグ</th>
                        <th scope="col" class="text-end">話題度(単体)</th>
                        <th scope="col">更新日時</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var topic in _topics
                        .OrderByDescending(t => t.TrendScore)
                        .ThenBy(t => t.Key, StringComparer.Ordinal))
                    {
                        <tr class="@(_matches.Contains(topic.Key) ? "match" : "")">
                            <td>@Checkbox(topic)</td>
                            <td>@TopicLink(topic)</td>
                            <td class="text-end">@topic.TrendScore.ToString("0.0")</td>
                            <td>@topic.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            @* 親子のツリー。子を持つノードは details/summary で折りたためる(JS 不要)。
               閉じていてもチェックボックスは DOM に残るので、選択の保存はそのまま効く。
               既定で開くのは選択済みを含む木だけ(全部開くと一覧が長くなりすぎる)。
               見た目はテーブル型(各行を同じ列構成のグリッドにして、列を縦にそろえる)。
               字下げは名前のセルの中だけで行う —— 子のコンテナごと下げると話題度や
               日時の列までずれてしまう *@
            <div class="topic-tree">
                <div class="topic-grid topic-header" aria-hidden="true">
                    <span>収集</span>
                    <span>タグ</span>
                    <span class="score-cell">話題度</span>
                    <span class="date-cell">更新日時</span>
                </div>
                @foreach (var root in _roots!)
                {
                    @RenderNode(root, 0)
                }
            </div>
        }

        <button type="submit" class="btn btn-primary">選択を保存</button>
        @if (_selectionMessage is { Length: > 0 })
        {
            <span class="ms-2 text-body-secondary">@_selectionMessage</span>
        }
    </form>
}

@* タグの再正規化に専用ボタンは無い —— 再編成が毎回、保存済みデータのタグを
   生タグ + カタログから作り直す(カタログを編集したら「トピックを再編成」を押せば効く) *@

@* ツリーの1ノード。子があれば折りたたみ(details)、無ければただの行 *@
@{
    RenderFragment RenderNode(TopicNode node, int depth) =>
    @<text>
        @if (node.Children.Count == 0)
        {
            <div class="topic-row topic-leaf">@RowContent(node, depth)</div>
        }
        else
        {
            @* **根は畳み、中は開いた状態にする。** 根を開いた状態にすると全 300 行が
               縦に並んで領域の見分けがつかず、逆に中まで畳むと目的の語に届くまで
               何度も開かないといけない。開けば配下が一望できる、が使いやすい。
               ユーザーが開閉した分はブラウザ(localStorage)が覚えていて、
               topic-tree.js が data-tag をキーに復元する(既定との差分だけを持つ) *@
            @* 検索で当たった枝は開く。**localStorage の復元に勝たせる**ため印を付ける
               (印が無いと、以前に畳んだ枝が復元されて検索結果が隠れる) *@
            <details class="topic-node" data-tag="@node.Topic.Key"
                     open="@(node.ContainsMatch || depth > 0)"
                     data-force-open="@(node.ContainsMatch ? "1" : null)">
                <summary class="topic-row">@RowContent(node, depth)</summary>
                @foreach (var child in node.Children)
                {
                    @RenderNode(child, depth + 1)
                }
            </details>
        }
    </text>;

    RenderFragment RowContent(TopicNode node, int depth) =>
    @<span class="topic-grid @(_matches.Contains(node.Topic.Key) ? "match" : "")">
        <span>@Checkbox(node.Topic)</span>
        <span class="name-cell" style="--depth: @depth">
            @if (node.Children.Count > 0)
            {
                @* 開閉の向きは CSS(details[open])で切り替える *@
                <span class="caret" aria-hidden="true"></span>
            }
            else if (depth > 0)
            {
                <span class="tree-branch" aria-hidden="true">└</span>
            }
            else
            {
                <span class="caret-spacer" aria-hidden="true"></span>
            }
            @TopicLink(node.Topic)
        </span>
        <span class="score-cell" title="配下込みの話題度">@node.Topic.SubtreeTrendScore.ToString("0.0")</span>
        <span class="date-cell">@node.Topic.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
    </span>;

    @* トピックへのリンク。**説明はツールチップに出す** —— 一覧の行に入れると
       話題度・日時の列が押し出され、ツリーの字下げも読めなくなる *@
    RenderFragment TopicLink(Topic topic) =>
    @<span class="topic-name">
        @* 検索の先頭一致に autofocus を置く。**JS を使わずに「開いてフォーカス」を成立させる**
           —— ブラウザが読み込み時に焦点を移し、画面内までスクロールしてくれる *@
        <a href="@TopicHref(topic)" autofocus="@(topic.Key == _firstMatch)">@Label(topic)</a>
        @* 集めた記事の件数。**0 のときは出さない**(ほとんどの行に「記事 0」が並ぶと、
           件数が付いている行を見つけられなくなる)。配下は含めない単体の件数 *@
        @if (topic.ArticleCount > 0)
        {
            <span class="article-count"
                  title="@($"この語がタグに付いた記事の件数（{topic.UpdatedAt.ToLocalTime():yyyy-MM-dd HH:mm} 時点）")">
                記事 @topic.ArticleCount
            </span>
        }
        @if (Description(topic) is { } description)
        {
            @* PC は1行に切ったかっこ書き(全文はツールチップ)。
               **スマホは hover が無いので `?` を押して出すチップにする**(下の popover)。
               どちらを見せるかは CSS のメディアクエリで決める *@
            <span class="topic-note" title="@description">（@description）</span>
            <button class="note-toggle" type="button" popovertarget="@NoteId(topic)"
                    aria-label="@($"{Label(topic)} の説明")">?</button>
            <span class="note-popover" id="@NoteId(topic)" popover>
                <strong>@Label(topic)</strong>
                @description
            </span>
        }
        else
        {
            <span class="no-description" title="説明はまだありません（「トピックを再編成」で埋まります）"
                  aria-hidden="true">?</span>
        }
    </span>;

    RenderFragment Checkbox(Topic topic) =>
    @<input class="form-check-input" type="checkbox" name="SelectedTopics"
            value="@topic.Key" checked="@topic.IsSelected"
            aria-label="@($"{Label(topic)} を収集対象にする")" />;
}

@code {
    IReadOnlyList<Topic>? _topics;
    List<TopicNode>? _roots;
    IReadOnlyList<Tag>? _pending;
    HashSet<string> _matches = new(StringComparer.Ordinal);
    string? _firstMatch;
    IReadOnlyList<string> _glossaryHits = [];
    IReadOnlyList<string> _lastAsked = [];
    DateTimeOffset? _lastAskedAt;
    string? _selectionMessage;

    /// <summary>表示の切り替え(既定はツリー、?view=ranking で単体の話題度順)。</summary>
    [SupplyParameterFromQuery(Name = "view")]
    string? View { get; set; }

    bool IsRanking => View == "ranking";

    /// <summary>検索語(GET の <c>?q=</c>)。別名でも当たる。</summary>
    [SupplyParameterFromQuery(Name = "q")]
    string? Query { get; set; }

    bool HasQuery => !string.IsNullOrWhiteSpace(Query);

    /// <summary>
    /// ツリーの1ノード。ContainsSelected は並び(選択済みの木を先頭に固定)、
    /// ContainsMatch は検索で当たった枝を開くかの判定に使う。
    /// </summary>
    class TopicNode
    {
        public required Topic Topic { get; init; }
        public List<TopicNode> Children { get; } = [];
        public bool ContainsSelected { get; set; }
        public bool ContainsMatch { get; set; }
    }

    [SupplyParameterFromForm(FormName = "save-topic-selection")]
    string[]? SelectedTopics { get; set; }

    /// <summary>
    /// 取り込むファイルを受け取るために要る。**静的 SSR のフォーム束縛はファイルを扱えない**ので、
    /// アップロードは <c>HttpContext.Request.Form.Files</c> から直接読む。
    /// </summary>
    [CascadingParameter]
    HttpContext? HttpContext { get; set; }

    /// <summary>取り込むファイルの上限。持ち出したファイルは数百 KB なので、これで十分に広い。</summary>
    const long MaxImportBytes = 8L * 1024 * 1024;

    string? _importMessage;

    string? _importError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // ジョブはバックグラウンドで走らせる(完了後の一覧は自動リロードの GET が読み直す)
    void Reorganize() => ReorganizationRunner.StartInBackground(
        ct => ReorganizationRunner.RunOnceAsync(ct), JobMessage.Describe);

    /// <summary>
    /// ファイルから語彙と仕分けを取り込む。**ジョブ(バックグラウンド)にしない** ——
    /// 外部へは出ず DB の数回の書き込みで終わるので、押した人がその場で結果を読めるほうがよい。
    /// 取り込んだあとは一覧を読み直す(この時点では読み込み済みの古い一覧が入っている)。
    /// </summary>
    async Task ImportAsync()
    {
        _importMessage = null;
        _importError = null;

        var upload = HttpContext?.Request.Form.Files["file"];
        if (upload is null || upload.Length == 0)
        {
            _importError = "ファイルが選ばれていません。";
            return;
        }

        if (upload.Length > MaxImportBytes)
        {
            _importError = $"ファイルが大きすぎます（{upload.Length / 1024 / 1024} MB）。"
                + "「JSON で書き出す」で作ったファイルをそのまま渡してください。";
            return;
        }

        try
        {
            using var reader = new StreamReader(upload.OpenReadStream());
            var file = TopicExportJson.Deserialize(await reader.ReadToEndAsync());
            var withSelection = HttpContext!.Request.Form["import-selection"] == "true";

            _importMessage = JobMessage.Describe(await Importer.ImportAsync(file, withSelection));
        }
        catch (JsonException error)
        {
            // **理由を画面に出す。** 黙って 0 件にすると「取り込んだのに増えない」で原因が分からない
            _importError = $"ファイルを読めませんでした: {error.Message}";
        }

        await LoadAsync();
    }

    // 画面に出すのはキー(生成ai)ではなくカタログの正式表記(生成AI)
    static string Label(Topic topic) => topic.Display is { Length: > 0 } display ? display : topic.Key;

    static string TopicHref(Topic topic) => $"/topics/{Uri.EscapeDataString(topic.Key)}";

    /// <summary>次の再編成で 1 回に聞く語数(枠に収まる分)。</summary>
    int NextCount => Math.Min(
        _pending?.Count ?? 0, TopicReorganizationRunner.MaxTagsPerClassification);

    /// <summary>枠に収まらず次回以降に回る語数。</summary>
    int NextOverflow => Math.Max(
        0, (_pending?.Count ?? 0) - TopicReorganizationRunner.MaxTagsPerClassification);

    /// <summary>
    /// 候補のバッジ。**どちらの材料で選ばれたのかが分かるように**、件数(集めたデータ)と
    /// 話題度(トレンド由来)を持っている分だけ添える(両方あることもある)。
    /// </summary>
    static string CandidateLabel(Tag tag)
    {
        var reasons = new List<string>(2);
        if (tag.TotalCount > 0)
        {
            reasons.Add($"{tag.TotalCount}件");
        }

        if (tag.TrendScore > 0)
        {
            reasons.Add($"話題度 {tag.TrendScore:0.0}");
        }

        return reasons.Count > 0 ? $"{tag.Key}({string.Join(" / ", reasons)})" : tag.Key;
    }

    /// <summary>用語の一言説明(カタログ。JSON に書いた分と LLM が埋めた分の合成)。</summary>
    string? Description(Topic topic) => Catalog.DescriptionOf(topic.Key);

    /// <summary>
    /// 説明チップ(popover)の id。タグをそのまま使わずエスケープするのは、
    /// `c#` のような記号を含むキーでも一意で妥当な id にするため。
    /// </summary>
    static string NoteId(Topic topic) => $"note-{Uri.EscapeDataString(topic.Key)}";

    /// <summary>
    /// 語彙とタグを読み込む。**一覧は語彙(トピック)そのまま**で、タグは状態ごとに
    /// 用語集へ回す —— タグは 1000 語を超え、混ぜるとツリーの構造が埋まる。
    ///
    /// 話題度で足切りはしない(話題度 0 の子が消えるとツリーが欠け、親を選んだときに
    /// 何が収集対象になるのか分からなくなる)。
    /// </summary>
    async Task LoadAsync()
    {
        _topics = await TopicStore.GetAllAsync();
        _matches = FindMatches(_topics);
        _roots = BuildTree(_topics, _matches);

        // フォーカスは**入力そのもの(別名なら寄せた先)を優先**し、無ければツリーの並びで最初の一致。
        // 部分一致で何件当たっても、探していた語に焦点が合うようにするため
        var resolved = HasQuery ? Catalog.Resolve(Query!) : null;
        _firstMatch = resolved is not null && _matches.Contains(resolved)
            ? resolved
            : FirstMatchInOrder(_roots, _matches);

        // 次に聞く語(語彙に加えようとしている語)だけをこの画面に出す。
        // 状態ごとの一覧は**タグの画面**の担当 —— あれはタグの話で、ここは語彙の話
        var tags = await TagStore.GetAllAsync();
        _pending = await TagStore.GetPendingAsync(
            DateTimeOffset.UtcNow, TopicReorganizationRunner.MinTagCount);

        // 前回 LLM に聞いた語。**プロセス内の記録を優先し、無ければ DB から復元する** ——
        // 記録はアプリを再起動すると消えるが、仕分けは「同じ実行の分は DecidedAt が揃う」
        // ので、いちばん新しい日時の束がそのまま前回の結果になる
        if (ReorganizationRunner.LastClassificationTargets is { Count: > 0 } asked)
        {
            _lastAsked = asked;
            _lastAskedAt = null;
        }
        else if (tags.Any(tag => tag.DecidedBy == DecidedBy.Llm))
        {
            _lastAskedAt = tags.Where(tag => tag.DecidedBy == DecidedBy.Llm).Max(tag => tag.DecidedAt);
            _lastAsked = tags
                .Where(tag => tag.DecidedBy == DecidedBy.Llm && tag.DecidedAt == _lastAskedAt)
                .Select(tag => tag.Key)
                .OrderBy(key => key, StringComparer.Ordinal)
                .ToList();
        }

        // 語彙に無くても、タグの側に当たっていれば案内できる(「なぜ出てこないのか」が分かる)
        _glossaryHits = HasQuery
            ? tags
                .Where(tag => tag.Status != TagStatus.Promoted && Matches(tag.Key))
                .Select(tag => tag.Key)
                .OrderBy(key => key, StringComparer.Ordinal)
                .Take(20)
                .ToList()
            : [];
    }

    /// 検索語に当たるトピックのキー。**別名でも当たる**のがこの検索の要点
    /// (`人工知能` で引いて `AI` に当てたい)。
    ///
    /// 突き合わせは<b>正規化したキーどうしの部分一致</b> —— 表記ゆれ(大小文字・全角半角・
    /// 区切り)を吸収したいので、生の文字列では比べない。`Resolve` を先に通すのは、
    /// 入力が別名そのものだったときに正式表記の行へ確実に当てるため。
    /// </summary>
    HashSet<string> FindMatches(IReadOnlyList<Topic> topics)
    {
        if (!HasQuery)
        {
            return new HashSet<string>(StringComparer.Ordinal);
        }

        var resolved = Catalog.Resolve(Query!);

        return topics
            .Where(topic => topic.Key == resolved || Matches(topic.Key)
                || Catalog.AliasesOf(topic.Key).Any(Matches))
            .Select(topic => topic.Key)
            .ToHashSet(StringComparer.Ordinal);
    }

    /// <summary>検索語が(正規化したうえで)その語に含まれるか。</summary>
    bool Matches(string term)
    {
        var needle = TagNormalizer.ToKey(Query ?? "");

        return needle.Length > 0
            && TagNormalizer.ToKey(term).Contains(needle, StringComparison.Ordinal);
    }

    /// <summary>
    /// ツリーを描く順(深さ優先)で最初の一致を返す。無ければ null。
    /// **`ContainsMatch` は祖先にも立つ**ので、そのノード自身が一致しているかは
    /// 一致集合で確かめる —— 祖先に焦点を移すと、探していた語が画面外に残る。
    /// </summary>
    static string? FirstMatchInOrder(IEnumerable<TopicNode> nodes, HashSet<string> matches)
    {
        foreach (var node in nodes.Where(node => node.ContainsMatch))
        {
            if (matches.Contains(node.Topic.Key))
            {
                return node.Topic.Key;
            }

            if (FirstMatchInOrder(node.Children, matches) is { } inner)
            {
                return inner;
            }
        }

        return null;
    }

    static IReadOnlyList<string> Names(IEnumerable<Topic> topics) => topics
        .Select(topic => Label(topic))
        .OrderBy(name => name, StringComparer.Ordinal)
        .ToList();

    /// <summary>
    /// トピックを親子のツリーに組む。**平らな話題度順だと親子ができてもまとまって見えない**。
    ///
    /// - 並びは配下込みの話題度(SubtreeTrendScore)。選択済みを含む木は先頭に固定する
    ///   (押し出されて見えなくなると、選択の保存で選択ごと外れる)
    /// - 親が取得範囲の外にあるトピックは根として出す(孤児にして消さない)
    /// - LLM 分類の親子が万一循環していても止まるよう、訪問済みを見て打ち切る
    /// </summary>
    static List<TopicNode> BuildTree(IReadOnlyList<Topic> topics, HashSet<string> matches)
    {
        var byTag = topics.ToDictionary(t => t.Key, StringComparer.Ordinal);
        var childrenOf = topics
            .Where(t => t.Parent is { Length: > 0 } parent && parent != t.Key && byTag.ContainsKey(parent))
            .ToLookup(t => t.Parent!, StringComparer.Ordinal);

        var visited = new HashSet<string>(StringComparer.Ordinal);

        TopicNode Build(Topic topic)
        {
            var node = new TopicNode
            {
                Topic = topic,
                ContainsSelected = topic.IsSelected,
                ContainsMatch = matches.Contains(topic.Key),
            };
            foreach (var child in childrenOf[topic.Key]
                .Where(child => visited.Add(child.Key))
                .OrderByDescending(c => c.IsSelected)
                .ThenByDescending(c => c.SubtreeTrendScore)
                .ThenBy(c => c.Key, StringComparer.Ordinal))
            {
                var built = Build(child);
                node.Children.Add(built);
                node.ContainsSelected |= built.ContainsSelected;
                node.ContainsMatch |= built.ContainsMatch;
            }

            return node;
        }

        return topics
            .Where(t => t.Parent is not { Length: > 0 } parent || parent == t.Key || !byTag.ContainsKey(parent))
            .Where(root => visited.Add(root.Key))
            .Select(Build)
            .OrderByDescending(node => node.ContainsSelected)
            .ThenByDescending(node => node.Topic.SubtreeTrendScore)
            .ThenBy(node => node.Topic.Key, StringComparer.Ordinal)
            .ToList();
    }

    /// <summary>
    /// 収集対象を保存する。**親を選んだら配下のトピックも選択に含める**
    /// (`TopicCatalog.ExpandWithDescendants`)。画面側でも JS がチェックを配下へ広げるが、
    /// **保存の正体はこちら** —— JS が動かない環境でも同じ結果になるようにしてある。
    /// </summary>
    async Task SaveSelectionAsync()
    {
        var checkedTags = SelectedTopics ?? [];
        var selected = Catalog.ExpandWithDescendants(checkedTags);
        await TopicStore.UpdateSelectionAsync(selected);

        var added = selected.Count - checkedTags.Length;
        _selectionMessage = selected.Count == 0
            ? "収集対象を空にしました（このままでは何も集まりません）。"
            : $"{selected.Count} 件のトピックを収集対象にしました。"
                + (added > 0 ? $"（うち {added} 件は選んだ親の配下）" : "");
        await LoadAsync();
    }
}
