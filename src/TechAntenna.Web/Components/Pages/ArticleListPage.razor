@page "/recent/articles"
@page "/recent/news"
@page "/interests/papers"
@page "/recent/papers"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IArticleStore ArticleStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject NavigationManager Navigation

@* 記事・ニュース・論文の一覧ページ。種別ごとの違いは「どの Kind を出すか」と
   論文だけにある翻訳ボタンだけなので、3ルートを1コンポーネントにまとめている。
   同じグループの「まとめ」(/recent/general)が一望のハブで、こちらは全量を受け持つ。

   並びは新着順(既定)と話題度順をタブで切り替える(`?sort=popular`。リンクなので
   静的 SSR のまま動く)。かつては新着順だけにしていたが、いま見ているのがどちらの並びか
   タブが示すので、2つ持っても迷わない —— 「読み逃したものを追う(新着)」と
   「反応の大きかったものを拾う(話題度)」はどちらも要る *@

<PageTitle>Tech Antenna — @_title</PageTitle>

<h1>@_title</h1>

@if (_kind is ArticleKind.News or ArticleKind.Article)
{
    <CollectionHint />
}
@if (_kind == ArticleKind.Paper)
{
    @* 興味トピック側の論文。収集を記事と分けてあるのは検索だから ——
       収集対象のトピックが無いと 1 件も集まらない(イベント・書籍と同じ性質) *@
    <CollectionHint Job="論文の収集" />
    <p class="page-note text-muted">
        <strong>収集対象に選んだトピックを検索語</strong>にして arXiv(英語)と
        J-STAGE(日本語)へ問い合わせます —— <a href="/settings/topics">トピック</a>を選んでいないと
        1 件も集まりません。arXiv には<strong>英語表記</strong>を投げます(日本語のままだと 0 件)。
        英語タイトルの翻訳は<a href="/settings/jobs">ジョブ</a>の「論文タイトルの翻訳」で付きます。
        トピックに関係なく話題のものを見たいときは<a href="/recent/papers">トレンド → 論文</a>へ。
    </p>
}
else if (_kind == ArticleKind.TrendingPaper)
{
    @* トレンド側の論文(HF Daily Papers)。収集は「トレンドの収集」、翻訳は「論文タイトルの翻訳」でどちらも設定にある
       (トピックの選択に依存しない巡回なので、ニュース・記事と同じ扱い) *@
    <CollectionHint />
    <p class="page-note text-muted">
        Hugging Face Daily Papers から<strong>トピックの選択に関係なく</strong>拾います
        (投稿と upvote で選ばれた論文)。収集は<a href="/settings/jobs">ジョブ</a>の「トレンドの収集」に、
        英語タイトルの翻訳は同じく<a href="/settings/jobs">ジョブ</a>の「論文タイトルの翻訳」にあります。
        並びは<strong>新着順</strong>が既定で、上のタブで<strong>upvote の多い順</strong>にも
        切り替えられます(どちらの並びでも、upvote の多いものはカードの濃さで目立ちます)。
        日本語の論文は<a href="/interests/papers">興味トピック → 論文</a>の担当です。
    </p>
}

@* トレンド側の3ページだけ並びを切り替えられる。/papers には出さない ——
   arXiv / J-STAGE の論文にはブックマークも upvote も付かないので、
   話題度順にしても新着順とほぼ同じ並びになり、選択肢が嘘になる *@
@if (CanSort)
{
    <nav class="view-switch" aria-label="並び順の切り替え">
        <a class="@(IsPopular ? "" : "active")" href="@_path">新着順</a>
        <a class="@(IsPopular ? "active" : "")" href="@($"{_path}?sort=popular")">話題度順</a>
    </nav>
}

@if (_articles is null)
{
    <p>読み込み中…</p>
}
else if (_articles.Count == 0)
{
    @* 空のときの行き先も種別で変える —— 論文はジョブの「論文の収集」、
       ほかはジョブの「トレンドの収集」で集まる *@
    @if (_kind == ArticleKind.Paper)
    {
        <p>まだありません。<a href="/settings/jobs">ジョブ</a>の「論文の収集」を実行してください
            (<a href="/settings/topics">トピック</a>を選んでいないと集まりません)。</p>
    }
    else
    {
        <p>まだありません。<a href="/settings/jobs">ジョブ</a>の「トレンドの収集」を実行してください。</p>
    }
}
else
{
    <p class="text-muted">
        @if (_kind == ArticleKind.Paper)
        {
            <text>新着順に並べています。<strong>収集対象に選んだトピック（配下のトピックを
                含む）のものだけ</strong>を出しています。</text>
        }
        else
        {
            @if (IsPopular)
            {
                <text><strong>直近 @Limit 件の中で話題度の高い順</strong>に並べています
                    (@PopularityLabel)。流れてきたものはすべて保存しています。</text>
            }
            else
            {
                <text>新着順に並べています。流れてきたものはすべて保存しています。</text>
            }
            @if (_selectedDisplays.Count > 0)
            {
                <text>選んだトピック(@string.Join("・", _selectedDisplays))のものは、
                    配下のトピックも含めて<strong>強調</strong>しています。</text>
            }
            else
            {
                <text><a href="/settings/topics">設定 → トピック</a>でトピックを選ぶと、そのトピックのものが強調されます。</text>
            }
        }
    </p>

    <ul class="list-unstyled">
        @foreach (var article in _articles)
        {
            <ArticleCard Article="article" Selected="IsSelected(article)" SelectedTags="_selected" />
        }
    </ul>
}

@code {
    /// <summary>一覧に出す件数。親ページと違い全量を追う導線なので多めに取る。</summary>
    const int Limit = 100;

    ArticleKind _kind = ArticleKind.Article;

    /// <summary>
    /// 見出し(と `<PageTitle>`)。メニューの親の名前を「/」で頭に付ける ——
    /// 「論文」は軸で2つある(トレンド / 論文 と 興味トピック / 論文)ので、
    /// 名前だけだと開いているのがどちらか読めない。
    /// </summary>
    string _title = "トレンド / 記事";
    string _path = "/recent/articles";
    IReadOnlyList<Article>? _articles;

    /// <summary>並び順。既定(null)は新着順で、"popular" なら話題度順。</summary>
    [SupplyParameterFromQuery(Name = "sort")]
    string? Sort { get; set; }

    bool IsPopular => Sort == "popular";

    /// <summary>話題度で並べ替えられる種別か(数値の付かない /papers では出さない)。</summary>
    bool CanSort => _kind is ArticleKind.News or ArticleKind.Article or ArticleKind.TrendingPaper;

    /// <summary>話題度が何の数かは種別で違う。並びの説明に添える。</summary>
    string PopularityLabel => _kind == ArticleKind.TrendingPaper
        ? "Hugging Face Daily Papers の upvote 数"
        : "はてなブックマーク数";

    /// <summary>収集対象に<b>明示的に</b>選んだトピックの表記。文言で列挙する用(配下まで並べると読めない)。</summary>
    IReadOnlyList<string> _selectedDisplays = [];

    /// <summary>選んだトピック+その配下のキー。強調(★)と /papers の絞り込みに使う。</summary>
    HashSet<string> _selected = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        // どの Kind を出すかはルートで決まる(4ルートを1コンポーネントで受けている)。
        // 「論文」は軸で2つある —— トレンド側(/recent/papers)が HF Daily Papers、
        // 興味トピック側(/interests/papers)がトピック検索の論文。
        // 末尾だけを見ると両方 "papers" で見分けられないので、パス全体で分ける
        (_kind, _title, _path) = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/') switch
        {
            "recent/news" => (ArticleKind.News, "トレンド / ニュース", "/recent/news"),
            "interests/papers" => (ArticleKind.Paper, "興味トピック / 論文", "/interests/papers"),
            "recent/papers" => (ArticleKind.TrendingPaper, "トレンド / 論文", "/recent/papers"),
            _ => (ArticleKind.Article, "トレンド / 記事", "/recent/articles"),
        };

        await LoadAsync();
    }

    // バックグラウンドで走らせる(完了後の一覧は自動リロードの GET が読み直す)
    async Task LoadAsync()
    {
        var selected = await TopicStore.GetSelectedAsync();
        _selectedDisplays = selected.Select(topic => topic.Display).ToList();
        // 強調と絞り込みは配下込み —— 親(AI)を選んだ人にとって、子(LLM・RAG)も興味の範囲
        _selected = Catalog
            .ExpandWithDescendants(selected.Select(topic => topic.Key))
            .ToHashSet(StringComparer.Ordinal);

        // ストアが返すのは新着順。話題度順はその直近 Limit 件の中で並べ替える ——
        // 窓を切らずに全期間から話題度で拾うと、昔の当たり記事が居座って動かなくなる
        // (トレンドが直近 7 日で切っているのと同じ理由)。
        // 話題度ははてブ数と upvote の大きいほう(カードの強調と同じ規則)。
        // 同点(未取得の 0 同士など)は新着順に落ちる
        var articles = await ArticleStore.GetRecentAsync(Limit, _kind);
        if (IsPopular && CanSort)
        {
            articles = articles
                .OrderByDescending(a => Math.Max(a.BookmarkCount ?? 0, a.UpvoteCount ?? 0))
                .ThenByDescending(a => a.PublishedAt ?? a.CollectedAt)
                .ToList();
        }

        // 興味トピック側(/papers)だけは選んだトピック(配下込み)のものに絞る ——
        // トレンド側(/news・/articles・/trending-papers)は選択に関係なく全部出す
        _articles = _kind == ArticleKind.Paper
            ? articles.Where(article => article.Tags.Any(_selected.Contains)).ToList()
            : articles;
    }

    /// <summary>選んだトピック(配下込み)の記事か。強調するかどうかの判定にだけ使う(収集では絞らない)。</summary>
    bool IsSelected(Article article) => article.Tags.Any(_selected.Contains);
}
