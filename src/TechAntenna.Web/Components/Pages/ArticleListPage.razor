@page "/articles"
@page "/news"
@page "/papers"
@page "/trending-papers"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IArticleStore ArticleStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject NavigationManager Navigation
@inject TitleTranslationRunner TranslationRunner
@inject PaperCollectionRunner PaperRunner

@* 記事・ニュース・論文の一覧ページ。種別ごとの違いは「どの Kind を出すか」と
   論文だけにある翻訳ボタンだけなので、3ルートを1コンポーネントにまとめている。
   親(/recent「直近動向」)が一望のハブで、こちらは**新着順の全量**を受け持つ *@

<PageTitle>@_title - tech-antenna</PageTitle>

<h1>@_title</h1>

@if (_kind is ArticleKind.News or ArticleKind.Article)
{
    <CollectionHint />
}
@if (_kind == ArticleKind.Paper)
{
    @* 興味トピック側の論文。**収集を記事と分けてある**のは検索だから ——
       収集対象のトピックが無いと 1 件も集まらない(イベント・書籍と同じ性質) *@
    <JobButton Runner="PaperRunner" FormName="collect-papers" OnRun="Collect" />
    <JobButton Runner="TranslationRunner" FormName="translate-titles" OnRun="Translate" />
    <p class="page-note text-muted">
        <strong>収集対象に選んだトピックを検索語</strong>にして arXiv(英語)と
        J-STAGE(日本語)へ問い合わせます —— <a href="/topics">トピック</a>を選んでいないと
        1 件も集まりません。arXiv には<strong>英語表記</strong>を投げます(日本語のままだと 0 件)。
        トピックに関係なく話題のものを見たいときは<a href="/trending-papers">話題の論文</a>へ。
    </p>
}
else if (_kind == ArticleKind.TrendingPaper)
{
    @* 収集は「記事の収集」に含まれる(設定にある)。翻訳だけはここに置く *@
    <CollectionHint />
    @* 話題の論文。**収集は「記事の収集」に含まれる**(トピックの選択に依存しない巡回なので、
       ニュース・記事と同じ扱い)。翻訳だけはこちらにも置く —— タイトルは英語なので *@
    <JobButton Runner="TranslationRunner" FormName="translate-titles" OnRun="Translate" />
    <p class="page-note text-muted">
        Hugging Face Daily Papers から<strong>トピックの選択に関係なく</strong>拾います
        (投稿と upvote で選ばれた論文)。収集は<a href="/settings">設定</a>の「記事の収集」に
        含まれます。並びは<strong>新着順</strong>で、upvote の多いものはカードの濃さで
        目立ちます(話題度の高い順は<a href="/recent">直近動向</a>)。
        <strong>中身は arXiv への投稿で、事実上すべて英語</strong>です ——
        日本語の論文は<a href="/papers">論文(興味トピック)</a>の担当です。
    </p>
}

@if (_articles is null)
{
    <p>読み込み中…</p>
}
else if (_articles.Count == 0)
{
    @* 空のときの行き先も種別で変える —— 論文は自分のページのボタン、
       ほかは設定の「記事の収集」で集まる *@
    @if (_kind == ArticleKind.Paper)
    {
        <p>まだありません。上の「論文の収集」を実行してください
            (<a href="/topics">トピック</a>を選んでいないと集まりません)。</p>
    }
    else
    {
        <p>まだありません。<a href="/settings">設定</a>の「記事の収集」を実行してください。</p>
    }
}
else
{
    <p class="text-muted">
        新着順に並べています。流れてきたものはすべて保存しています。
        @if (_selected.Count > 0)
        {
            <text>選んだトピック(@string.Join("・", _selected.Select(Catalog.DisplayOf)))のものは<strong>強調</strong>しています。</text>
        }
        else
        {
            <text><a href="/topics">設定 → トピック</a>でトピックを選ぶと、そのトピックのものが強調されます。</text>
        }
    </p>

    <ul class="list-unstyled">
        @foreach (var article in _articles)
        {
            <ArticleCard Article="article" Selected="IsSelected(article)" SelectedTags="_selected" />
        }
    </ul>
}

@code {
    /// <summary>一覧に出す件数。親ページと違い全量を追う導線なので多めに取る。</summary>
    const int Limit = 100;

    ArticleKind _kind = ArticleKind.Article;
    string _title = "記事";
    IReadOnlyList<Article>? _articles;
    HashSet<string> _selected = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        // どの Kind を出すかはルートで決まる(3ルートを1コンポーネントで受けている)
        (_kind, _title) = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/') switch
        {
            "news" => (ArticleKind.News, "ニュース"),
            "papers" => (ArticleKind.Paper, "論文（興味トピック）"),
            "trending-papers" => (ArticleKind.TrendingPaper, "話題の論文"),
            _ => (ArticleKind.Article, "記事"),
        };

        await LoadAsync();
    }

    // バックグラウンドで走らせる(完了後の一覧は自動リロードの GET が読み直す)
    void Collect() => PaperRunner.StartInBackground(
        ct => PaperRunner.RunOnceAsync(ct),
        result => $"{result.Fetched} 件取得、うち {result.Added} 件を新規追加しました。"
            + (result.FailedSources > 0 ? $" {result.FailedSources} 件の収集元が失敗しています。" : ""));

    void Translate() => TranslationRunner.StartInBackground(
        ct => TranslationRunner.RunOnceAsync(ct),
        result => result.Requested == 0
            ? "訳題の付いていない論文はありません。"
            : $"{result.Requested} 件中 {result.Translated} 件に訳題を付けました。");

    async Task LoadAsync()
    {
        // **種別ページは全部**新着順**で統一**(話題度は並びではなくカードの強調に出す)。
        // 「話題度の高い順」は直近動向(/recent)の担当 —— 同じ一覧が2つの並びを持つと、
        // どちらを見ているのか分からなくなる
        _articles = await ArticleStore.GetRecentAsync(Limit, _kind);
        _selected = (await TopicStore.GetSelectedAsync())
            .Select(topic => topic.Key)
            .ToHashSet(StringComparer.Ordinal);
    }

    /// <summary>選んだトピックの記事か。強調するかどうかの判定にだけ使う(収集では絞らない)。</summary>
    bool IsSelected(Article article) => article.Tags.Any(_selected.Contains);
}
