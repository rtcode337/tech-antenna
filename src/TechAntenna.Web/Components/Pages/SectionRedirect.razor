@page "/recent"
@page "/interests"
@page "/classics"
@page "/settings"
@inject NavigationManager Navigation

@* 軸の入口だった URL(`/recent` など)を、その「まとめ」(設定は「全般」)へ送る。

   **メニューの親はページではなくなった**(押すと子が開くだけ)ので、一覧は
   `/recent/general` のような子ページへ移してある(URL は `general` のまま ——
   表示名を変えただけでブックマークを切らさない)。ここが受けるのは
   **ブックマーク・通知・外から貼られたリンク**で、消すと 404 になる。

   `replace: true` にするのは、戻るボタンで古い URL に戻って**また転送される**のを
   避けるため(押しても1つ前に戻れなくなる)。 *@

@code {
    protected override void OnInitialized()
    {
        var path = Navigation
            .ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/');

        Navigation.NavigateTo($"/{path}/general", replace: true);
    }
}
