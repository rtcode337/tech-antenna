@page "/classics/books"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IBookStore BookStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject TimeProvider Clock

@* 定番(第三の軸)の子ページ。中身は「読むべき技術書」を挙げた Qiita 記事から
   名指しされた本を拾ったもの —— 親(定番)はメニューの見出しで、軸の説明は /classics/general が受け持つ。
   興味トピック側の /books と違い、**トピックの選択には依存しない** *@

<PageTitle>Tech Antenna — 定番 / 書籍</PageTitle>

<h1>定番 / 書籍</h1>

<p class="page-note text-muted">
    「読むべき技術書」を挙げた Qiita 記事(ストック数の多いもの)から、
    <strong>名指しされた本</strong>を拾います。<strong>集めるのはトピックの選択に
    依存しません</strong> —— 選んだトピックで検索して集める本は
    <a href="/interests/books">興味トピック → 書籍</a>へ。
    ただし<strong>選んだトピック(配下を含む)に当たるタグは強調</strong>して出すので、
    定番の中から自分の関心に近いものを見つけられます。
</p>

@* 収集のボタンは設定にある(トピック選択と無関係なので、書籍の収集とは別ボタン) *@
<CollectionHint Job="定番の収集" />

@if (_books is null)
{
    <p>読み込み中…</p>
}
else if (_books.Count == 0)
{
    <p>まだありません。<a href="/settings/jobs">ジョブ</a>の「定番の収集」を実行してください。</p>
}
else
{
    <p class="text-muted">
        並びは<strong>薦められている順</strong>(名指しした記事の数)。
        <strong>@MinRecommendations 本以上の記事で名指しされた本</strong>だけを出します ——
        1 本だけの推薦は、まとめ記事が網羅的に貼ったリンクも含まれて薄いため。
        <strong>読み終えた本は右端の「読んだ」で印を付けられます</strong> ——
        印の付いた本は一覧から消えず、<strong>末尾へ回ります</strong>。
    </p>

    @if (_message is { Length: > 0 })
    {
        <p class="notice">@_message</p>
    }

    @* 「読んだ」の切り替えは1ページ1フォーム(/interests/books と同じ流儀)。
       押された本は submit の value で見分ける。**data-keep-focus** は、POST で
       画面が作り直されたときに押した行へ戻すため(keep-focus.js) *@
    <form method="post" @formname="classic-books-read" @onsubmit="ToggleReadAsync" data-keep-focus>
        <AntiforgeryToken />
        <ul class="list-unstyled">
            @foreach (var book in _books)
            {
                @* **一覧は絞らない**(定番は選択に依らない軸)が、**タグの色は選んだトピック
                   +配下で強調する** —— トレンドの★と同じ考え方で、絞らずに「自分の関心に
                   当たるもの」を見つけられるようにするため *@
                <BookItem Book="book" HighlightTags="_interests" ShowReadToggle="true" />
            }
        </ul>
    </form>

    @if (_needsRakutenCredit)
    {
        @* 楽天から取ったデータ(レビューと書影)を出すときはクレジット表記が要る
           (利用規約 Article 13)。指定の HTML は改変不可なので、テキスト版をそのまま置いている *@
        <p class="credit">
            <a href="https://developers.rakuten.com/" target="_blank">Supported by Rakuten Developers</a>
        </p>
    }
}

@code {
    /// <summary>
    /// 出す推薦記事数の下限(/books の「薦められている本」の強調と同じ理由・同じ値)。
    /// </summary>
    const int MinRecommendations = 2;

    /// <summary>読み込む冊数。推薦本は多くても数百なので全量が入る。</summary>
    const int Limit = 400;

    IReadOnlyList<Book>? _books;
    bool _needsRakutenCredit;
    string? _message;

    [SupplyParameterFromForm(FormName = "classic-books-read")]
    string? Action { get; set; }

    /// <summary>選んだトピック+その配下のキー。**一覧の絞り込みではなく強調にだけ使う**。</summary>
    HashSet<string> _interests = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>
    /// 「読んだ」の印を裏返す。押された本は submit の value(`toggle:&lt;Id&gt;`)で分かる。
    /// </summary>
    async Task ToggleReadAsync()
    {
        if (!BookReadAction.TryReadId(Action, out var id))
        {
            return;
        }

        // 見つからないときは黙って読み直すだけ(消えた本の印を画面に残さない)
        _message = await BookStore.ToggleReadAsync(id, Clock.GetUtcNow()) switch
        {
            true => "読んだ本として印を付けました（一覧の末尾へ回ります）。",
            false => "「読んだ」の印を外しました。",
            null => null,
        };

        await LoadAsync();
    }

    // バックグラウンドで走らせる(完了後の一覧は自動リロードの GET が読み直す)
    async Task LoadAsync()
    {
        var books = await BookStore.GetRecentAsync(Limit);
        // 並びは /books と同じ規則(推薦回数 → 読まれている度)
        _books = books
            // 雑誌・ムックは定番の一覧にも出さない(規則を入れる前に集めた本が残っているため)
            .Where(book => !Periodical.IsLikely(book))
            .Where(book => book.RecommendationCount >= MinRecommendations)
            .ByPopularity()
            .ToList();
        // クレジット表記は楽天のデータ(レビュー・書影)を実際に出しているときだけ置く
        _needsRakutenCredit = RakutenCredit.IsRequiredFor(_books);

        // 強調は配下込み —— 親(AI)を選んだ人にとって、子(LLM・RAG)も興味の範囲
        _interests = Catalog
            .ExpandWithDescendants((await TopicStore.GetSelectedAsync()).Select(topic => topic.Key))
            .ToHashSet(StringComparer.Ordinal);
    }
}
