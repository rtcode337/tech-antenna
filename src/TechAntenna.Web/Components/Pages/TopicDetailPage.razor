@page "/settings/topics/{Tag}"
@using TechAntenna.Core
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@inject TopicService TopicService
@inject TopicCatalog Catalog
@inject ITagStore TagStore

<PageTitle>Tech Antenna — トピック / @Title</PageTitle>

<h1>トピック / @Title</h1>

<p><a href="/settings/topics">← トピック一覧</a></p>

@* 語彙としての姿(同義語・ツリー上の位置)を先に出す。**このページは2つの問いに答える**:
   「この語はどう整理されているか」と「この語に何が紐づいているか」。前者が上、後者が下 *@
@if (_structure is { } structure)
{
    @* 用語の一言説明。見慣れない語を開いたときに、まずこれで何の話か分かるようにする *@
    @if (structure.Description is { Length: > 0 } description)
    {
        <p class="topic-description">
            @description
            <span class="text-muted">
                （<code>topic-seed.json</code> に書かれていなければ LLM が付けた説明です）
            </span>
        </p>
    }
    else
    {
        <p class="text-muted">
            この用語の説明はまだありません
            （<a href="/settings/topics">トピック</a>の「タグを仕分けなおす」で LLM が埋めます）。
        </p>
    }

    <h2 class="h4 mt-4">同義語</h2>
    @if (!structure.InCatalog)
    {
        <p class="text-muted">
            この語はまだ語彙(カタログ)に載っていません —— 記事などのタグとしては生きていますが、
            同義語も親子も決まっていない<strong>平置きの語</strong>です。
            <a href="/settings/topics">トピック</a>の「タグを仕分けなおす」で LLM が分類します。
        </p>
    }
    else if (structure.Aliases.Count == 0)
    {
        <p class="text-muted">
            寄せている別名はありません(<code>@structure.Key</code> の表記ゆれだけが吸収されます)。
        </p>
    }
    else
    {
        <p class="text-muted">
            これらの表記は正式表記「@structure.Display」へ寄せて数えます。
            <strong>LLM</strong> と付いた語は仕分けのときに LLM が分類したもので、
            残りは <code>topic-seed.json</code> に人が書いたものです。
        </p>
        <p class="alias-list">
            @foreach (var alias in structure.Aliases)
            {
                @if (_llmAliases.Contains(alias))
                {
                    <span class="badge bg-primary" title="LLM が分類した別名">
                        @alias<span class="alias-origin">LLM</span>
                    </span>
                }
                else
                {
                    <span class="badge" title="カタログ（topic-seed.json）に書いた別名">@alias</span>
                }
            }
        </p>
    }

    <h2 class="h4 mt-4">ツリー構造</h2>
    @if (structure.IsIsolated)
    {
        <p class="text-muted">
            親も子もありません(ツリー上は単独の語です)。
        </p>
    }
    else
    {
        <p class="text-muted">
            上が大きい粒度です。<strong>粒度の違う語は統合しません</strong> ——
            まとめると上位の語だけが巨大化して、何の話題か分からなくなるため。
        </p>
        <div class="topic-path">
            @* 祖先(根 → 直近の親)→ このトピック → 直下の子。
               **孫より下は畳んでおく** —— 「プログラミング」のような大きな語では配下が
               70 語を超え、開いたまま出すと下の記事・イベント・書籍が画面外へ押し出される *@
            @for (var depth = 0; depth < structure.Ancestors.Count; depth++)
            {
                var ancestor = structure.Ancestors[depth];
                <div class="path-row" style="--depth: @depth">
                    @Branch(depth)
                    <a href="@Href(ancestor.Key)">@ancestor.Display</a>
                </div>
            }
            <div class="path-row current" style="--depth: @structure.Ancestors.Count">
                @Branch(structure.Ancestors.Count)
                <strong>@structure.Display</strong>
                <span class="text-muted">（このトピック）</span>
            </div>
            @foreach (var child in structure.Children)
            {
                @RenderChild(child, structure.Ancestors.Count + 1)
            }
        </div>
    }
}

@* 配下の1ノード。子を持つなら折りたたみ(既定は閉じる。JS は使わない) *@
@{
    RenderFragment RenderChild(TopicTreeNode node, int depth) =>
    @<text>
        @if (node.Children.Count == 0)
        {
            <div class="path-row" style="--depth: @depth">
                @Branch(depth)
                <a href="@Href(node.Key)">@node.Display</a>
            </div>
        }
        else
        {
            <details class="path-node">
                <summary class="path-row" style="--depth: @depth">
                    <span class="caret" aria-hidden="true"></span>
                    <a href="@Href(node.Key)">@node.Display</a>
                    <span class="text-muted">（配下 @Count(node) 語）</span>
                </summary>
                @foreach (var child in node.Children)
                {
                    @RenderChild(child, depth + 1)
                }
            </details>
        }
    </text>;

    @* 字下げの頭をそろえる印。深さ 0(根)には引かない *@
    RenderFragment Branch(int depth) =>
    @<span class="tree-branch" aria-hidden="true">@(depth > 0 ? "└" : "")</span>;
}

@if (_detail is null)
{
    <p>読み込み中…</p>
}
else
{
    @* 見出しを「記事」にしない —— この一覧は種別で絞っておらず、ニュースも論文も
       混ざる(実測: `ai` は記事 28 / ニュース 27 / 論文 1)。行ごとの種別はバッジで見分ける *@
    <h2 class="h4 mt-4">記事・ニュース・論文</h2>
    @if (_detail.Articles.Count == 0)
    {
        <p class="text-muted">このトピックの記事・ニュース・論文はまだありません。</p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var article in _detail.Articles)
            {
                <li class="mb-2">
                    <span class="badge kind-badge">@KindLabel(article.Kind)</span>
                    <a href="@article.Url" target="_blank" rel="noopener">@article.Title</a>
                    @if (!string.IsNullOrEmpty(article.Summary))
                    {
                        <div class="text-body-secondary">@article.Summary</div>
                    }
                    <small class="text-muted">@article.SourceName</small>
                </li>
            }
        </ul>
    }

    <h2 class="h4 mt-4">これからのイベント</h2>
    @if (_detail.Events.Count == 0)
    {
        <p class="text-muted">このトピックのイベントはまだありません。</p>
    }
    else
    {
        @* イベントのカードは共通コンポーネント(EventItem)—— 3種を並べて見るページなので、
           イベントの一覧と同じ見た目にする(公式のバッジ・参加者数もそのまま出る) *@
        <ul class="list-unstyled">
            @foreach (var techEvent in _detail.Events)
            {
                <EventItem Event="techEvent" />
            }
        </ul>
    }

    <h2 class="h4 mt-4">書籍</h2>
    @if (_detail.Books.Count == 0)
    {
        <p class="text-muted">このトピックの書籍はまだありません。</p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var book in _detail.Books)
            {
                @* 記事で薦められている本は強調する(/books のトピック一覧と同じ見せ方)。
                   **読んだ本は薄くして末尾へ回す**(並べ替えは TopicService)——
                   印を付け直すのは書籍の一覧(/interests/books・/classics/books)の仕事で、
                   ここは「なぜ下にいるのか」が読めればよい *@
                <li class="mb-2 @(book.RecommendationCount > 0 ? "recommended-book" : "") @(book.IsRead ? "read-book" : "")">
                    @if (book.Url is { } url)
                    {
                        <a href="@url" target="_blank" rel="noopener">@book.Title</a>
                    }
                    else
                    {
                        <span>@book.Title</span>
                    }
                    @if (book.ReadAt is { } readAt)
                    {
                        <span class="read-mark ms-1" title="@($"{JapanTime.FormatDate(readAt)} に読んだ")">✓ 読んだ</span>
                    }
                    <br />
                    <small class="text-muted">
                        @if (book.Authors.Count > 0)
                        {
                            <text>@string.Join("、", book.Authors) — </text>
                        }
                        @(book.Publisher ?? "出版社不明")
                        @if (book.RecommendationCount > 0)
                        {
                            <a class="recommended ms-1" href="@book.RecommendedBy[0]"
                               target="_blank" rel="noopener" title="この本を薦めている記事へ">
                                推薦 @book.RecommendationCount 件
                            </a>
                        }
                    </small>
                </li>
            }
        </ul>
    }
}

@code {
    [Parameter]
    public string Tag { get; set; } = "";

    TopicDetail? _detail;
    TopicStructure? _structure;

    /// <summary>LLM の分類で足された別名。カタログ(JSON)に人が書いた分と見分けるために持つ。</summary>
    HashSet<string> _llmAliases = new(StringComparer.Ordinal);

    static string Href(string key) => $"/settings/topics/{Uri.EscapeDataString(key)}";

    /// <summary>種別のバッジの文字。ナビ・一覧の呼び方と揃える。</summary>
    static string KindLabel(ArticleKind kind) => kind switch
    {
        ArticleKind.News => "ニュース",
        ArticleKind.Paper => "論文",
        ArticleKind.TrendingPaper => "話題の論文",
        _ => "記事",
    };


    /// <summary>そのノードの配下の語数(折りたたみを開く前に規模が分かるように出す)。</summary>
    static int Count(TopicTreeNode node) => node.Children.Count + node.Children.Sum(Count);

    /// <summary>見出しは正式表記(カタログに無い語はキーのまま)。</summary>
    string Title => _structure?.Display is { Length: > 0 } display ? display : Tag;

    protected override async Task OnParametersSetAsync()
    {
        // 語彙としての姿はカタログから引く(LLM の分類は起動時と整備のあとに合成済み)
        _structure = Catalog.StructureOf(Tag);

        // 別名の出どころ(規則 / シード / LLM / 人の手直し)。どちらが付けた別名なのか
        // 画面から分かるようにしておく —— LLM の判定は人が見て直せる必要がある
        var tags = await TagStore.GetAllAsync();
        _llmAliases = tags
            .Where(tag => tag.Status == TagStatus.Alias
                && tag.TopicKey == _structure.Key
                && tag.DecidedBy == DecidedBy.Llm)
            .Select(tag => tag.Key)
            .ToHashSet(StringComparer.Ordinal);

        _detail = await TopicService.GetTopicAsync(Tag, 20);
    }
}
