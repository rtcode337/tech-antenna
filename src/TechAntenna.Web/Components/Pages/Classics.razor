@page "/classics"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IBookStore BookStore
@inject TopicCatalog Catalog
@inject ClassicsCollectionRunner CollectionRunner

@* 「定番」— 第三の軸。トレンド(今なにが話題か)でも興味トピック(選んだ語の検索)でもなく、
   **時間が経っても薦められ続けるもの**を集める。今の中身は書籍だけ ——
   「読むべき技術書」を挙げた Qiita 記事から、名指しされた本を拾う。
   記事・資料に広がったら details のグループに変える(ナビも同様) *@

<PageTitle>定番 - tech-antenna</PageTitle>

<h1>定番</h1>

<p class="page-note text-muted">
    <strong>時間が経っても薦められ続けるもの</strong>を集めます ——
    <a href="/recent">トレンド</a>(今なにが話題か)とも
    <a href="/interests">興味トピック</a>(選んだトピックの検索)とも別の、第三の軸です。
    今は書籍だけ: 「読むべき技術書」を挙げた Qiita 記事(ストック数の多いもの)から、
    <strong>名指しされた本</strong>を拾います。<strong>トピックの選択には依存しません</strong>。
</p>

@* 収集はこのページから(トピック選択と無関係なので、書籍の収集とは別ボタン) *@
<JobButton Runner="CollectionRunner" FormName="collect-classics" OnRun="Collect" />

@if (_books is null)
{
    <p>読み込み中…</p>
}
else if (_books.Count == 0)
{
    <p>まだありません。上の「定番の収集」を実行してください。</p>
}
else
{
    <p class="text-muted">
        並びは<strong>薦められている順</strong>(名指しした記事の数)。
        <strong>@MinRecommendations 本以上の記事で名指しされた本</strong>だけを出します ——
        1 本だけの推薦は、まとめ記事が網羅的に貼ったリンクも含まれて薄いため。
    </p>

    <ul class="list-unstyled">
        @foreach (var book in _books)
        {
            <BookItem Book="book" />
        }
    </ul>

    @if (_hasReviews)
    {
        @* 楽天ウェブサービスのレビューを出すときはクレジット表記が要る(利用規約 Article 13)。
           指定の HTML は改変不可なので、テキスト版をそのまま置いている *@
        <p class="credit">
            <a href="https://developers.rakuten.com/" target="_blank">Supported by Rakuten Developers</a>
        </p>
    }
}

@code {
    /// <summary>
    /// 出す推薦記事数の下限(/books の「薦められている本」の枠と同じ理由・同じ値)。
    /// </summary>
    const int MinRecommendations = 2;

    /// <summary>読み込む冊数。推薦本は多くても数百なので全量が入る。</summary>
    const int Limit = 400;

    IReadOnlyList<Book>? _books;
    bool _hasReviews;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // バックグラウンドで走らせる(完了後の一覧は自動リロードの GET が読み直す)
    void Collect() =>
        CollectionRunner.StartInBackground(ct => CollectionRunner.RunOnceAsync(ct), JobMessage.Describe);

    async Task LoadAsync()
    {
        var books = await BookStore.GetRecentAsync(Limit);
        // 並びは /books と同じ規則(推薦回数 → 読まれている度)
        _books = books
            .Where(book => book.RecommendationCount >= MinRecommendations)
            .ByPopularity()
            .ToList();
        // クレジット表記は楽天のデータを実際に出しているときだけ置く
        _hasReviews = _books.Any(book => book.ReviewCount is > 0);
    }
}
