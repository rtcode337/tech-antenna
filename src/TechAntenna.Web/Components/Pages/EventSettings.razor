@page "/settings/events"
@using TechAntenna.Core
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Web.Services
@inject IEventStore EventStore
@inject ApiCredentials Credentials

@* イベントの集め方と重みづけの設定。購読と主催者を1ページにまとめてある ——
   かつては `/settings/follows` と `/settings/organizers` の2ページだったが、
   互いを行き来しないと決められない: 購読の候補は「公式と判定された主催者」から
   起こすし、公式かどうかは購読で集めたイベントにも効く。名簿を見比べながら直せるよう、
   同じページの2つの節にした(旧 URL はリダイレクトを置いてある)。

   2つとも作りは同じ —— 1行1件のテキストを DB に持ち、再起動なしで効く。
   違うのは購読が初期値を持たないこと(実在の ID は憶測で書けない)。*@

<PageTitle>Tech Antenna — 設定 / イベント</PageTitle>

<h1>設定 / イベント</h1>


<p class="page-note text-muted">
    イベントを<strong>どう集めるか</strong>(購読)と、<strong>どれを重く見るか</strong>(公式の主催者)を決めます。
</p>

@* ---- 購読 ---- *@
<h2 id="follows">
    購読するグループ
    <button class="help-toggle" type="button" popovertarget="follows-help"
            aria-label="「購読するグループ」の説明">?</button>
</h2>

<p class="page-note text-muted">
    ここに載せたグループのイベントは、<strong>収集対象のトピックに当たらなくても集めて表示します</strong>。
</p>

<div class="help-popover" id="follows-help" popover>
    <strong>なぜ購読が要るか</strong>
    <p>
        キーワード検索だけだと、<strong>名前に「AI」「LLM」が入らない大きなカンファレンス</strong>
        (RubyKaigi・DroidKaigi・JJUG CCC など)が構造的に落ちます ——
        検索で拾えるのは「こちらが知っている語」だけなので、
        <strong>知っているグループは名前で直接追う</strong>ほうが確実です。
    </p>
    <ul>
        <li>イベントのカードには、<strong>ここに書いた表示名がそのまま「なぜ載っているか」として出ます</strong>。
            「rubykaigi」ではなく「RubyKaigi」のように、人が読める形で書いてください。</li>
        <li><strong>購読を外しても、すでに集めたイベントは一覧から消えません</strong>
            (外れるのは<strong>これから集める分</strong>だけです)。トピックの選択を外したときは
            表示からも外れるので、そこだけ扱いが違います —— 集めた時点で「わざわざ追いかけると
            決めたもの」だったという事実は、後から変わらないためです。</li>
    </ul>
</div>

@if (_followMessage is { Length: > 0 })
{
    <p class="notice">@_followMessage</p>
}

<form method="post" @formname="followed-groups" @onsubmit="SaveFollowsAsync">
    <AntiforgeryToken />
    <label for="followed-groups">
        <strong>購読するグループ</strong>（1 行に 1 つ。<code>#</code> で始まる行はメモとして無視します）
    </label>
    <textarea id="followed-groups" name="Groups" rows="12" spellcheck="false"
              placeholder="@Placeholder">@Groups</textarea>
    <div class="actions">
        <button type="submit" class="btn btn-primary" name="Action" value="save">名簿を保存</button>
        <button type="submit" class="btn btn-outline-primary" name="Action" value="clear">すべて外す</button>
        <span class="text-muted">
            @if (_followed.All.Count == 0)
            {
                <text>いまは<strong>何も購読していません</strong>（この経路では 1 件も集まりません）。</text>
            }
            else
            {
                <text><strong>@_followed.All.Count 件</strong>を購読しています。</text>
            }
        </span>
    </div>
</form>

@if (_rejected.Count > 0)
{
    <p class="notice">
        <strong>読めなかった行があります</strong>（この行は無視されます）:
        @string.Join(" / ", _rejected)
    </p>
}

@* 公式の名簿から購読の候補を出す。「公式」は集めたイベントに付く印でしかなく、
   提供元のイベントを狙って取りに行く経路は無い —— 一方でグループを購読すれば
   トピックに関係なく全部入るので、すでに集まっているイベントのうち公式と判定された
   主催者のグループを候補にすれば、名簿を人が調べて書き写さずに済む。
   識別子は保存済みイベントの URL から起こす(外部へは問い合わせない) *@
<h3>公式の主催者から足す</h3>

<p class="page-note text-muted">
    集めたイベントのうち、<a href="#organizers">公式と判定された主催者</a>のグループです。
    <strong>購読すればトピックに関係なく全部入る</strong>ので、
    たまたま検索語に当たったときだけ載る状態から抜けられます。
    <strong>すでに購読しているものは出しません</strong>。
</p>

@if (_suggestions is null)
{
    <p>読み込み中…</p>
}
else if (_suggestions.Count == 0)
{
    <p class="text-muted">
        候補はありません（公式と判定された主催者のイベントがまだ集まっていないか、すべて購読済みです）。
        下の<a href="#organizers">公式と見なす主催者</a>に名前を足すと候補が増えることがあります。
    </p>
}
else
{
    @* 名簿のフォームとは別の form(並べるのは正しく、入れ子にするのが不正)。
       名簿は「書いたとおりに保存する」もの、こちらは「選んだ行を足す」ものなので、
       送る中身が別 —— 1 つにまとめると、候補を足すだけのつもりで打ちかけの名簿まで保存される *@
    <form method="post" @formname="follow-suggestions" @onsubmit="AddSuggestedAsync">
        <AntiforgeryToken />
        <ul class="list-unstyled suggestions">
            @foreach (var suggestion in _suggestions)
            {
                <li>
                    <label>
                        <input type="checkbox" name="Selected" value="@($"{suggestion.Source}:{suggestion.Id}")" />
                        <strong>@suggestion.Label</strong>
                        <code>@suggestion.Source:@suggestion.Id</code>
                        <span class="text-muted">集まっているイベント @suggestion.Count 件</span>
                    </label>
                </li>
            }
        </ul>
        <div class="actions">
            <button type="submit" class="btn btn-primary">チェックしたグループを購読する</button>
        </div>
    </form>
}

<h3>書き方</h3>

<p class="text-muted">
    書式は <code>&lt;収集元&gt;:&lt;識別子&gt; &lt;表示名&gt;</code> です（表示名は省略できます）。
    収集元に書けるのは <code>connpass</code> と <code>doorkeeper</code> の 2 つで、
    <strong>どちらもキーの設定が要ります</strong>（<a href="/settings/integrations">設定 → 外部連携</a>）。
</p>

@* スマホでは 1 行 1 枚のカードに畳む(3 列とも長い文なので、詰めると1文字ずつ折り返す) *@
<table class="table stack">
    <thead>
        <tr>
            <th scope="col">収集元</th>
            <th scope="col">識別子に書くもの</th>
            <th scope="col">どこで分かるか</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>connpass</code></td>
            <td data-label="識別子">グループの<strong>サブドメイン</strong>、または<strong>シリーズ ID</strong>（数字）</td>
            <td data-label="どこで分かるか">グループのページの URL <code>https://<strong>ここ</strong>.connpass.com/</code></td>
        </tr>
        <tr>
            <td><code>doorkeeper</code></td>
            <td data-label="識別子">コミュニティの<strong>名前</strong></td>
            <td data-label="どこで分かるか">コミュニティのページの URL <code>https://<strong>ここ</strong>.doorkeeper.jp/</code></td>
        </tr>
    </tbody>
</table>

<p class="text-muted">
    connpass にサブドメインを書いた場合は、収集のときに 1 回だけシリーズ ID へ引き直します
    （<strong>その分リクエストが 1 つ増えます</strong>。数字で書けば増えません）。
    <strong>存在しない識別子の行は黙って飛ばします</strong> ——
    1 行の打ち間違いで収集全体が止まらないようにするためなので、
    集まらないときはここの綴りを確かめてください。
</p>

@* ---- 主催者 ---- *@
<h2 id="organizers">
    公式と見なす主催者
    <button class="help-toggle" type="button" popovertarget="organizers-help"
            aria-label="「公式と見なす主催者」の説明">?</button>
</h2>

<p class="page-note text-muted">
    ここに載せた名前が主催者名に含まれるイベントを<strong>「公式」</strong>として扱います。
</p>

<div class="help-popover" id="organizers-help" popover>
    <strong>「公式」は何に効くか</strong>
    <p>
        <a href="/interests/events">イベント</a>のカードにバッジが付き、カレンダーでは帯に色が付き、
        <strong>注目度順</strong>で上に来ます。載せるのは
        <strong>技術の提供元(ベンダー)の名前</strong>で、ユーザーグループやコミュニティの名前ではありません。
    </p>
    <ul>
        <li>突き合わせは<strong>部分一致</strong>です(「Microsoft」で「日本マイクロソフト株式会社」を
            拾うため)。ただし語の端が英数字のときは境界を見るので、「AI」が「Rails」に当たることはありません。</li>
        <li><strong>主催者名を取れるのは connpass と Doorkeeper だけ</strong>で、TECH PLAY の RSS には
            主催者が入っていません(そのイベントは公式と判定されません)。</li>
        <li><strong>判定は保存しません。</strong>表示のたびに名簿と突き合わせるので、
            ここを直すと過去に集めたイベントにもすぐ効きます。</li>
    </ul>
</div>

@if (_organizerMessage is { Length: > 0 })
{
    <p class="notice">@_organizerMessage</p>
}

<form method="post" @formname="official-organizers" @onsubmit="SaveOrganizersAsync">
    <AntiforgeryToken />
    <label for="organizer-names">
        <strong>公式と見なす主催者</strong>（1 行に 1 つ。<code>#</code> で始まる行はメモとして無視します）
    </label>
    <textarea id="organizer-names" name="Names" rows="12" spellcheck="false">@Names</textarea>
    <div class="actions">
        <button type="submit" class="btn btn-primary" name="Action" value="save">名簿を保存</button>
        @* 空にして保存すると初期値に戻るので、消す操作も同じボタンで足りる。
           それでも明示のボタンを置くのは、初期値がどれか分からなくなったときの戻り道として *@
        <button type="submit" class="btn btn-outline-primary" name="Action" value="reset">初期値に戻す</button>
        <span class="text-muted">
            @if (OrganizerSettings.IsCustomized(Credentials))
            {
                <text>いまは<strong>この画面で設定した名簿</strong>(@_official.Names.Count 件)が効いています。</text>
            }
            else
            {
                <text>いまは<strong>初期値</strong>(@OfficialOrganizers.Defaults.Count 件)が効いています。</text>
            }
        </span>
    </div>
</form>

<h3>集まっているイベントの主催者</h3>

@if (_organizers is null)
{
    <p>読み込み中…</p>
}
else if (_organizers.Count == 0)
{
    <p class="text-muted">主催者の分かるイベントがまだありません
        (<a href="/settings/jobs">ジョブ</a>の「イベントの収集」を実行すると集まります)。</p>
}
else
{
    <p class="text-muted">
        収集済みのイベントに出てくる主催者を、件数の多い順に出しています
        (@_organizers.Count 件のうち、<strong>@_organizers.Count(o => _official.IsOfficial(o.Organizer))
        件が公式</strong>と判定されています)。
    </p>

    <table class="table">
        <thead>
            <tr>
                <th scope="col">主催者</th>
                <th scope="col">イベント数</th>
                <th scope="col">判定</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var organizer in _organizers)
            {
                <tr>
                    <td>@organizer.Organizer</td>
                    <td class="count">@organizer.Count</td>
                    <td>
                        @if (_official.IsOfficial(organizer.Organizer))
                        {
                            <span class="badge bg-success">公式</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    /// <summary>入力欄に出す例。実在の ID は書かない(憶測の値をそのまま保存されると分かりにくい)。</summary>
    const string Placeholder = """
        # 例（グループのページの URL を見て書き換えてください）
        connpass:example-group  例のコミュニティ
        doorkeeper:example      例のコミュニティ
        """;

    /// <summary>保存の結果。節ごとに持つ —— 片方を保存したときに、
    /// もう片方の節へ結果が出ると何を保存したのか読めない。</summary>
    string? _followMessage;

    string? _organizerMessage;

    FollowedGroups _followed = FollowedGroups.Empty;
    IReadOnlyList<string> _rejected = [];

    /// <summary>
    /// 公式の主催者から起こした購読の候補。読み込みが終わるまで null
    /// (`default!` にすると、DB につないだ本番でだけ現れる初回の描画で落ちる)。
    /// </summary>
    IReadOnlyList<FollowSuggestion>? _suggestions;

    IReadOnlyList<OrganizerCount>? _organizers;
    OfficialOrganizers _official = OfficialOrganizers.Default;

    @* フォームが3つあるので、どちらの値かを名前で明示する。省略すると
       「いま送られてきたフォーム」から拾おうとするので、候補を足す POST でも
       名簿の値を拾いに行くことになる(そちらには textarea が無いので空になる) *@
    /// <summary>編集中の購読の名簿。保存してある生のテキストをそのまま出す(コメント行も残す)。</summary>
    [SupplyParameterFromForm(FormName = "followed-groups", Name = "Groups")]
    string? Groups { get; set; }

    /// <summary>購読の名簿で押されたボタン。value で見分ける流儀。</summary>
    [SupplyParameterFromForm(FormName = "followed-groups", Name = "Action")]
    string? FollowAction { get; set; }

    /// <summary>チェックされた候補(<c>&lt;収集元&gt;:&lt;識別子&gt;</c>)。</summary>
    [SupplyParameterFromForm(FormName = "follow-suggestions", Name = "Selected")]
    string[]? Selected { get; set; }

    /// <summary>編集中の主催者の名簿。画面には効いている名簿をそのまま出す(初期値のときは初期値)。</summary>
    [SupplyParameterFromForm(FormName = "official-organizers", Name = "Names")]
    string? Names { get; set; }

    /// <summary>主催者の名簿で押されたボタン。</summary>
    [SupplyParameterFromForm(FormName = "official-organizers", Name = "Action")]
    string? OrganizerAction { get; set; }

    protected override async Task OnInitializedAsync()
    {
        LoadFollows();
        LoadOfficial();
        // POST で戻ってきたときは打ちかけの値を残す(初回だけ保存済みの名簿を流し込む)
        Groups ??= FollowSettings.Raw(Credentials);
        Names ??= OfficialOrganizers.Format(_official.Names);
        await LoadSuggestionsAsync();
        await LoadOrganizersAsync();
    }

    void LoadFollows()
    {
        var raw = FollowSettings.Raw(Credentials);
        _followed = FollowedGroups.Parse(raw);
        _rejected = FollowedGroups.Rejected(raw);
    }

    void LoadOfficial() => _official = OrganizerSettings.Resolve(Credentials);

    async Task LoadOrganizersAsync() => _organizers = await EventStore.GetOrganizerCountsAsync();

    /// <summary>
    /// 候補を作り直す。外部へは問い合わせない —— 集めたイベントを主催者でまとめ、
    /// 公式の名簿と突き合わせ、URL からグループの識別子を起こすだけ。
    /// </summary>
    async Task LoadSuggestionsAsync() =>
        _suggestions = FollowSuggestions.From(
            await EventStore.GetOrganizerGroupsAsync(),
            OrganizerSettings.Resolve(Credentials),
            _followed);

    /// <summary>
    /// チェックした候補を名簿へ足す。書いてある行は消さず、末尾に足すだけ ——
    /// 名簿はメモを添えて育てるもので、画面が整形して書き戻すと書き置きが消える。
    /// </summary>
    async Task AddSuggestedAsync()
    {
        var keys = Selected ?? [];
        var suggestions = _suggestions ?? [];
        var lines = suggestions
            .Where(s => keys.Contains($"{s.Source}:{s.Id}", StringComparer.OrdinalIgnoreCase))
            // 押すまでのあいだに名簿へ手で書かれていることもあるので、ここでも重複を見る
            .Where(s => !FollowedGroups.Parse(Groups).Contains(s.Source, s.Id))
            .Select(s => s.Line)
            .ToList();

        if (lines.Count == 0)
        {
            _followMessage = "足すものがありませんでした（チェックが無いか、すでに名簿にあります）。";
            await LoadSuggestionsAsync();

            return;
        }

        var current = (Groups ?? "").TrimEnd();
        Groups = current.Length == 0 ? string.Join("\n", lines) : $"{current}\n{string.Join("\n", lines)}";
        await Credentials.SetAsync(FollowSettings.GroupsName, Groups);
        _followMessage = $"{lines.Count} 件を購読に足しました。";

        LoadFollows();
        await LoadSuggestionsAsync();
    }

    async Task SaveFollowsAsync()
    {
        if (FollowAction == "clear" || string.IsNullOrWhiteSpace(Groups))
        {
            await Credentials.RemoveAsync(FollowSettings.GroupsName);
            Groups = "";
            _followMessage = "購読をすべて外しました。";
        }
        else
        {
            // 書いたとおりに保存する(コメント行も残す)。名簿はメモを添えて育てるものなので、
            // 保存のたびに整形して書き戻すと「なぜ入れたか」の書き置きが消える
            await Credentials.SetAsync(FollowSettings.GroupsName, Groups);
            _followMessage = $"名簿を保存しました（{FollowedGroups.Parse(Groups).All.Count} 件）。";
        }

        LoadFollows();
        // 名簿が変わると「すでに購読しているもの」も変わるので、候補も作り直す
        await LoadSuggestionsAsync();
    }

    async Task SaveOrganizersAsync()
    {
        // 空で保存したときも初期値に戻す —— 空の名簿を保存できると、「公式が1件も出ない」と
        // 「設定していない」が画面から見分けられなくなる(OfficialOrganizers.Parse と同じ判断)
        var names = OfficialOrganizers.Parse(Names).Names;
        if (OrganizerAction == "reset" || string.IsNullOrWhiteSpace(Names))
        {
            await Credentials.RemoveAsync(OrganizerSettings.OfficialNamesName);
            _organizerMessage = "名簿を初期値に戻しました。";
        }
        else
        {
            await Credentials.SetAsync(
                OrganizerSettings.OfficialNamesName, OfficialOrganizers.Format(names));
            _organizerMessage = $"名簿を保存しました（{names.Count} 件）。";
        }

        LoadOfficial();
        await LoadOrganizersAsync();
        Names = OfficialOrganizers.Format(_official.Names);
        // 公式の判定が変わると購読の候補も変わる
        await LoadSuggestionsAsync();
    }
}
