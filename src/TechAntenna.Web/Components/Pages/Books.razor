@page "/interests/books"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IBookStore BookStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject TimeProvider Clock

<PageTitle>Tech Antenna — 興味トピック / 書籍</PageTitle>

<h1>興味トピック / 書籍</h1>

<CollectionHint Job="書籍の収集" />

@if (_groups is null)
{
    <p>読み込み中…</p>
}
else if (_groups.Count == 0)
{
    <p>まだ書籍がありません。<a href="/settings/topics">設定 → トピック</a>でトピックを選んでから、
        <a href="/settings/jobs">ジョブ</a>の「書籍の収集」を実行してください。</p>
}
else
{
    <p class="text-muted">
        <strong>収集対象に選んだトピックごと</strong>にまとめています。トピック名を押すと開きます。
        <strong>配下のトピックの本は親のグループにまとめて</strong>出し、
        タグのうち<strong>そのグループに反応したもの</strong>を青いバッジで強調しています。
        複数のトピックで見つかった本は、そのすべてに出ます。
        並びは<strong>薦められている順</strong>(記事で名指しされた回数)、次に
        <strong>読まれている順</strong>(レビュー件数と平均評価から算出)です。
        どちらも取れていない本は後ろに置いています。
        記事で薦められている本は、トピックの中でも<strong>強調</strong>しています
        (トピックに関係なく薦められている定番は<a href="/classics/books">定番 → 書籍</a>へ)。
        <strong>雑誌・ムック・増刊は出していません</strong> —— 号を重ねるぶん数が多く、
        「読んでおくべき本」を探すのに埋もれるためです。
        <strong>読み終えた本は右端の「読んだ」で印を付けられます</strong> ——
        印の付いた本は一覧から消えず、<strong>各グループの末尾へ回ります</strong>。
    </p>

    @if (_message is { Length: > 0 })
    {
        <p class="notice">@_message</p>
    }

    @* 記事で薦められた本の枠はここには無い —— 第三の軸として /classics(定番)へ移した。
       トピックの中の強調(左帯)は残す(トピックで絞った上でなら 1 本の推薦でも意味がある) *@
    @* 「読んだ」の切り替えは1ページ1フォーム。行ごとにフォームを作ると @formname が
       冊数ぶん並ぶので、押された本は submit の value(`read:<Id>`)で見分ける
       (タグの画面と同じ流儀)。data-keep-focus を付けるのは、POST で画面が
       作り直されると押した行が画面外へ消えるため(keep-focus.js が同じボタンへ戻す) *@
    <form method="post" @formname="books-read" @onsubmit="ToggleReadAsync" data-keep-focus>
        <AntiforgeryToken />
        @foreach (var group in _groups)
        {
            @* 折りたたみは details/summary。静的 SSR のまま、JS も対話回線も無しで開閉できる。
               既定は全部閉じる(トレンドの書籍と同じ) —— 先頭だけ開けておくと、その
               トピックの冊数ぶんが下のトピックを押し下げ、「どのトピックに何冊あるか」を
               見るのに先頭を畳む操作が要る。
               例外は「読んだ」を押した直後(_openGroups)—— POST で作り直された画面が
               全部畳まれていると、押した本もボタンも見えず、何が起きたのか分からない *@
            <details class="topic-group" open="@_openGroups.Contains(group.Tag)">
                <summary>
                    <span class="topic-name">@group.Display</span>
                    <span class="badge bg-secondary ms-1">@group.Books.Count</span>
                </summary>
                <ul class="list-unstyled">
                    @foreach (var book in group.Books)
                    {
                        <BookItem Book="book" HighlightTags="group.Subtree"
                                  EmphasizeRecommended="true" ShowReadToggle="true" />
                    }
                </ul>
            </details>
        }
    </form>

    @if (_needsRakutenCredit)
    {
        @* 楽天から取ったデータ(レビューと書影)を出すときはクレジット表記が要る
           (利用規約 Article 13)。指定の HTML は改変不可なので、テキスト版をそのまま置いている *@
        <p class="credit">
            <a href="https://developers.rakuten.com/" target="_blank">Supported by Rakuten Developers</a>
        </p>
    }
}

@code {
    /// <summary>読み込む冊数。トピックごとに振り分けるので一覧表示より多めに取る。</summary>
    const int Limit = 400;

    IReadOnlyList<TopicGroup>? _groups;
    bool _needsRakutenCredit;
    string? _message;

    /// <summary>
    /// 開いた状態で描くグループ。「読んだ」を押した直後だけ中身が入る ——
    /// 押した本を含むグループを開き直さないと、POST 後の画面では全部畳まれていて
    /// 結果が見えない。1冊が複数のグループに出るので集合で持つ。
    /// </summary>
    HashSet<string> _openGroups = new(StringComparer.Ordinal);

    [SupplyParameterFromForm(FormName = "books-read")]
    string? Action { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>
    /// 「読んだ」の印を裏返す。押された本は submit の value(`toggle:&lt;Id&gt;`)で分かる。
    /// </summary>
    async Task ToggleReadAsync()
    {
        if (!BookReadAction.TryReadId(Action, out var id))
        {
            return;
        }

        // 見つからないときは黙って読み直すだけ(消えた本の印を画面に残さない)
        _message = await BookStore.ToggleReadAsync(id, Clock.GetUtcNow()) switch
        {
            true => "読んだ本として印を付けました（一覧の末尾へ回ります）。",
            false => "「読んだ」の印を外しました。",
            null => null,
        };

        await LoadAsync();
        // 押した本を含むグループだけ開き直す(押した行のそばに結果が出るようにする)
        _openGroups = _groups!
            .Where(group => group.Books.Any(book => book.Id == id))
            .Select(group => group.Tag)
            .ToHashSet(StringComparer.Ordinal);
    }

    // バックグラウンドで走らせる(完了後の一覧は自動リロードの GET が読み直す)
    async Task LoadAsync()
    {
        // 雑誌・ムックは出さない(Periodical)。収集の側でも落としているが、
        // 規則を入れる前に集めた本が DB に残っているので表示でも外す ——
        // 号を重ねるぶん数の多い雑誌に一覧が埋まると、読むべき本が見つからない
        var books = (await BookStore.GetRecentAsync(Limit))
            .Where(book => !Periodical.IsLikely(book))
            .ToList();
        _groups = Group(books, await TopicStore.GetSelectedAsync());
        // クレジット表記は楽天のデータを実際に出しているときだけ置く
        // レビューだけでなく書影も楽天由来のことがある(openBD は技術書の書影をほぼ持たない)
        _needsRakutenCredit = RakutenCredit.IsRequiredFor(_groups.SelectMany(group => group.Books));
    }

    /// <summary>
    /// 本をトピックごとに振り分ける。グループは収集対象に選んだトピックの分だけで、
    /// 配下のトピックのタグしか持たない本も親のグループへまとめる(グループを
    /// 配下のトピックごとに割ると、AI を選んだだけで LLM・RAG… と小さな見出しが並ぶ)。
    /// どのタグで載ったのかは、本のタグの帯の強調(<see cref="BookItem.HighlightTags"/>)で分かる。
    /// 1冊が複数のグループに出るのは従来どおり(親と子を両方選んでいれば両方に出る)。
    /// 中は<b>読まれている順</b>(<see cref="BookPopularity"/>)。選択を外したトピックで
    /// 過去に集めた本や、タグの無い本(推薦で拾った本に多い)はこのページには出さない
    /// (トピックに寄らない推薦は /classics/books の担当)。
    /// </summary>
    IReadOnlyList<TopicGroup> Group(IReadOnlyList<Book> books, IReadOnlyList<SelectedTopic> selected) =>
        selected
            .Select(topic =>
            {
                // そのトピック自身 + 配下のキー。本のタグとの突き合わせにも、
                // 「反応したタグ」の強調にも同じ集合を使う
                var subtree = Catalog.DescendantKeysOf(topic.Key)
                    .Prepend(topic.Key)
                    .ToHashSet(StringComparer.Ordinal);

                return new TopicGroup(
                    topic.Key,
                    Catalog.DisplayOf(topic.Key),
                    subtree,
                    books.Where(book => book.Tags.Any(subtree.Contains)).ByPopularity().ToList());
            })
            .Where(group => group.Books.Count > 0)
            .OrderByDescending(group => group.Books.Count)
            .ThenBy(group => group.Display, StringComparer.Ordinal)
            .ToList();

    /// <summary>トピック1つぶんの見出しと中身。Subtree はトピック自身+配下のキー。</summary>
    record TopicGroup(
        string Tag, string Display, IReadOnlySet<string> Subtree, IReadOnlyList<Book> Books);
}
