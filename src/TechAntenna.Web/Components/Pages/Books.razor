@page "/books"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IBookStore BookStore
@inject TopicCatalog Catalog
@inject BookCollectionRunner CollectionRunner

<PageTitle>書籍 - tech-antenna</PageTitle>

<h1>書籍</h1>

@* 開発環境では定期実行を止めてあるので(Books:AutoRun)、ここから手動で走らせる *@
<JobButton Runner="CollectionRunner" FormName="collect-books" OnRun="Collect" />

@if (_groups is null)
{
    <p>読み込み中…</p>
}
else if (_groups.Count == 0)
{
    <p>まだ書籍がありません。「設定」でトピックを選んでから「書籍の収集」を実行してください。</p>
}
else
{
    <p class="text-muted">
        トピックごとにまとめています。トピック名を押すと開きます。
        複数のトピックで見つかった本は、そのすべてに出ます。
        並びは<strong>薦められている順</strong>(記事で名指しされた回数)、次に
        <strong>読まれている順</strong>(レビュー件数と平均評価から算出)です。
        どちらも取れていない本は後ろに置いています。
        記事で薦められている本は、トピックの中でも<strong>強調</strong>しています
        (トピックに関係なく薦められている定番は<a href="/classics">定番</a>のページへ)。
    </p>

    @* 記事で薦められた本の枠はここには無い —— 第三の軸として /classics(定番)へ移した。
       トピックの中の強調(左帯)は残す(トピックで絞った上でなら 1 本の推薦でも意味がある) *@
    @foreach (var group in _groups)
    {
        @* 折りたたみは details/summary。静的 SSR のまま、JS も対話回線も無しで開閉できる *@
        <details class="topic-group" open="@(group == _groups[0])">
            <summary>
                <span class="topic-name">@group.Display</span>
                <span class="badge bg-secondary ms-1">@group.Books.Count</span>
            </summary>
            <ul class="list-unstyled">
                @foreach (var book in group.Books)
                {
                    <BookItem Book="book" CurrentTag="@group.Tag" EmphasizeRecommended="true" />
                }
            </ul>
        </details>
    }

    @if (_hasReviews)
    {
        @* 楽天ウェブサービスのレビューを出すときはクレジット表記が要る(利用規約 Article 13)。
           指定の HTML は改変不可なので、テキスト版をそのまま置いている *@
        <p class="credit">
            <a href="https://developers.rakuten.com/" target="_blank">Supported by Rakuten Developers</a>
        </p>
    }
}

@code {
    /// <summary>読み込む冊数。トピックごとに振り分けるので一覧表示より多めに取る。</summary>
    const int Limit = 400;

    IReadOnlyList<TopicGroup>? _groups;
    bool _hasReviews;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // バックグラウンドで走らせる(完了後の一覧は自動リロードの GET が読み直す)
    void Collect() =>
        CollectionRunner.StartInBackground(ct => CollectionRunner.RunOnceAsync(ct), JobMessage.Describe);

    async Task LoadAsync()
    {
        var books = await BookStore.GetRecentAsync(Limit);
        _groups = Group(books);
        // クレジット表記は楽天のデータを実際に出しているときだけ置く
        _hasReviews = books.Any(book => book.ReviewCount is > 0);
    }

    /// <summary>
    /// 本をトピックごとに振り分ける。**1冊が複数のトピックに出る**(タグの数だけ重複して並ぶ)
    /// —— 収集も「AI でも LLM でも当たる本」をどちらのタグでも持たせているため。
    /// 中は<b>読まれている順</b>(<see cref="BookPopularity"/>)。タグが1つも無い本は
    /// 最後の「トピックなし」にまとめる(取りこぼしを見えるようにする)。
    /// </summary>
    IReadOnlyList<TopicGroup> Group(IReadOnlyList<Book> books)
    {
        var groups = books
            .SelectMany(book => book.Tags.Select(tag => (Tag: tag, Book: book)))
            .GroupBy(pair => pair.Tag, StringComparer.Ordinal)
            .Select(g => new TopicGroup(
                g.Key, Catalog.DisplayOf(g.Key), g.Select(pair => pair.Book).ByPopularity().ToList()))
            .OrderByDescending(group => group.Books.Count)
            .ThenBy(group => group.Display, StringComparer.Ordinal)
            .ToList();

        // 推薦で拾った本はタグを持たないことが多いが、あれは /classics(定番)の担当
        var untagged = books
            .Where(book => book.Tags.Count == 0 && book.RecommendationCount == 0)
            .ByPopularity()
            .ToList();
        if (untagged.Count > 0)
        {
            groups.Add(new TopicGroup("", "トピックなし", untagged));
        }

        return groups;
    }

    /// <summary>トピック1つぶんの見出しと中身。</summary>
    record TopicGroup(string Tag, string Display, IReadOnlyList<Book> Books);
}
