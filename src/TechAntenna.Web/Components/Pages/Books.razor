@page "/books"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IBookStore BookStore
@inject TopicCatalog Catalog
@inject BookCollectionRunner CollectionRunner

<PageTitle>書籍 - tech-antenna</PageTitle>

<h1>書籍</h1>

@* 開発環境では定期実行を止めてあるので(Books:AutoRun)、ここから手動で走らせる *@
<JobButton Runner="CollectionRunner" FormName="collect-books"
           Message="@_message" Error="@_error" OnRun="CollectAsync" />

@if (_groups is null)
{
    <p>読み込み中…</p>
}
else if (_groups.Count == 0)
{
    <p>まだ書籍がありません。「設定」でトピックを選んでから「書籍の収集」を実行してください。</p>
}
else
{
    <p class="text-muted">
        トピックごとにまとめています。トピック名を押すと開きます。
        複数のトピックで見つかった本は、そのすべてに出ます。
        並びは<strong>薦められている順</strong>(記事で名指しされた回数)、次に
        <strong>読まれている順</strong>(レビュー件数と平均評価から算出)です。
        どちらも取れていない本は後ろに置いています。
        記事で薦められている本は、トピックの中でも<strong>強調</strong>しています。
    </p>

    @* 記事で薦められた本はトピックの検索で拾ったわけではないのでタグを持たない。
       トピックの折りたたみに混ぜず、独立した枠で先に出す *@
    @if (_recommended is { Count: > 0 })
    {
        <details class="topic-group" open>
            <summary>
                <span class="topic-name">記事で薦められている本</span>
                <span class="badge bg-secondary ms-1">@_recommended.Count</span>
                <small class="text-muted">@MinRecommendations 本以上の記事で名指しされた本</small>
            </summary>
            <ul class="list-unstyled">
                @foreach (var book in _recommended)
                {
                    @RenderBook(book, "", emphasizeRecommended: false)
                }
            </ul>
        </details>
    }

    @foreach (var group in _groups)
    {
        @* 折りたたみは details/summary。静的 SSR のまま、JS も対話回線も無しで開閉できる *@
        <details class="topic-group" open="@(group == _groups[0])">
            <summary>
                <span class="topic-name">@group.Display</span>
                <span class="badge bg-secondary ms-1">@group.Books.Count</span>
            </summary>
            <ul class="list-unstyled">
                @foreach (var book in group.Books)
                {
                    @RenderBook(book, group.Tag, emphasizeRecommended: true)
                }
            </ul>
        </details>
    }

    @if (_hasReviews)
    {
        @* 楽天ウェブサービスのレビューを出すときはクレジット表記が要る(利用規約 Article 13)。
           指定の HTML は改変不可なので、テキスト版をそのまま置いている *@
        <p class="credit">
            <a href="https://developers.rakuten.com/" target="_blank">Supported by Rakuten Developers</a>
        </p>
    }
}

@* 1冊分の表示。トピックの折りたたみと「薦められている本」の枠で同じものを使う。
   currentTag はその見出しのトピック(同じ名前をタグとして繰り返さないため)。
   emphasizeRecommended はトピックの中で推薦本を目立たせるか ——
   「薦められている本」の枠では全冊が該当して意味を成さないので切る *@
@{
    RenderFragment RenderBook(Book book, string currentTag, bool emphasizeRecommended) =>
    @<li class="mb-3 d-flex gap-2 @(emphasizeRecommended && book.RecommendationCount > 0 ? "recommended-book" : "")">
        @if (book.CoverUrl is { } coverUrl)
        {
            <img src="@coverUrl" alt="" width="48" loading="lazy" />
        }
        <div>
            @if (book.Url is { } url)
            {
                <a href="@url" target="_blank" rel="noopener">@book.Title</a>
            }
            else
            {
                <span>@book.Title</span>
            }
            <br />
            <small class="text-muted">
                @if (book.Authors.Count > 0)
                {
                    <text>@string.Join("、", book.Authors) — </text>
                }
                @(book.Publisher ?? "出版社不明")
                @if (book.PublishedOn is { } publishedOn)
                {
                    <text> — @publishedOn.ToString("yyyy-MM")</text>
                }
                @if (book.RecommendationCount > 0)
                {
                    @* レビュー(読まれた量)とは別軸なので、並べて別々に出す *@
                    <a class="recommended ms-1" href="@book.RecommendedBy[0]"
                       target="_blank" rel="noopener" title="この本を薦めている記事へ">
                        推薦 @book.RecommendationCount 件
                    </a>
                }
                @if (book.ReviewCount is { } reviewCount and > 0)
                {
                    <span class="review ms-1">
                        ★ @(book.ReviewAverage?.ToString("0.0") ?? "—")
                        <span class="text-muted">(@reviewCount 件)</span>
                    </span>
                }
                @foreach (var tag in book.Tags.Where(tag => tag != currentTag))
                {
                    <span class="badge bg-light text-dark ms-1">@Catalog.DisplayOf(tag)</span>
                }
            </small>
        </div>
    </li>;
}

@code {
    /// <summary>読み込む冊数。トピックごとに振り分けるので一覧表示より多めに取る。</summary>
    const int Limit = 400;

    /// <summary>
    /// 「薦められている本」の枠に出す推薦記事数の下限。1本だけの推薦は、まとめ記事が
    /// 網羅的に貼ったリンクも含まれて薄い —— 複数の書き手が独立に名指しした本だけを出す。
    /// (トピックの中の強調は 1 本からで、こちらは絞らない)
    /// </summary>
    const int MinRecommendations = 2;

    IReadOnlyList<Book>? _recommended;
    IReadOnlyList<TopicGroup>? _groups;
    bool _hasReviews;
    string? _message;
    string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task CollectAsync()
    {
        try
        {
            _message = JobMessage.Describe(await CollectionRunner.RunOnceAsync());
        }
        catch (Exception ex)
        {
            // 画面に出す。原因が読めないと押した側は打つ手が無い
            _error = ex.Message;
        }

        await LoadAsync();
    }

    async Task LoadAsync()
    {
        var books = await BookStore.GetRecentAsync(Limit);
        _recommended = books
            .Where(book => book.RecommendationCount >= MinRecommendations)
            .ByPopularity()
            .ToList();
        _groups = Group(books);
        // クレジット表記は楽天のデータを実際に出しているときだけ置く
        _hasReviews = books.Any(book => book.ReviewCount is > 0);
    }

    /// <summary>
    /// 本をトピックごとに振り分ける。**1冊が複数のトピックに出る**(タグの数だけ重複して並ぶ)
    /// —— 収集も「AI でも LLM でも当たる本」をどちらのタグでも持たせているため。
    /// 中は<b>読まれている順</b>(<see cref="BookPopularity"/>)。タグが1つも無い本は
    /// 最後の「トピックなし」にまとめる(取りこぼしを見えるようにする)。
    /// </summary>
    IReadOnlyList<TopicGroup> Group(IReadOnlyList<Book> books)
    {
        var groups = books
            .SelectMany(book => book.Tags.Select(tag => (Tag: tag, Book: book)))
            .GroupBy(pair => pair.Tag, StringComparer.Ordinal)
            .Select(g => new TopicGroup(
                g.Key, Catalog.DisplayOf(g.Key), g.Select(pair => pair.Book).ByPopularity().ToList()))
            .OrderByDescending(group => group.Books.Count)
            .ThenBy(group => group.Display, StringComparer.Ordinal)
            .ToList();

        // 推薦で拾った本はタグを持たないが、上の枠で出しているのでここには入れない
        var untagged = books
            .Where(book => book.Tags.Count == 0 && book.RecommendationCount == 0)
            .ByPopularity()
            .ToList();
        if (untagged.Count > 0)
        {
            groups.Add(new TopicGroup("", "トピックなし", untagged));
        }

        return groups;
    }

    /// <summary>トピック1つぶんの見出しと中身。</summary>
    record TopicGroup(string Tag, string Display, IReadOnlyList<Book> Books);
}
