@page "/recent"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IArticleStore ArticleStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject TimeProvider Clock
@inject ArticleCollectionRunner CollectionRunner
@inject SummaryRunner SummaryRunner

@* 「直近動向」— このページだけは、**興味があるとマークしたトピックの外も含めて**
   直近の話題を一望する場所(そもそも記事の収集は選択で絞っていない)。
   並びは新着順のまま、話題度(はてなブックマーク数)をカードの強調で重ねる。
   種別ごとの全量は子ページ(/news・/articles・/papers)が受け持つ *@

<PageTitle>直近動向 - tech-antenna</PageTitle>

<h1>直近動向</h1>

@* 開発環境では定期実行を止めてあるので(Collection:AutoRun / Anthropic:AutoRun)、
   ここから手動で走らせる。論文タイトルの翻訳ボタンは /papers にある *@
<JobButton Runner="CollectionRunner" FormName="collect-articles" OnRun="Collect" />
<JobButton Runner="SummaryRunner" FormName="summarize" OnRun="Summarize" />

@if (_sections is null)
{
    <p>読み込み中…</p>
}
else if (_sections.Count == 0)
{
    <p>まだ記事がありません。「記事の収集」を実行してください。</p>
}
else
{
    <p class="text-muted">
        直近 @WindowDays 日の話題を、興味のあるトピックに限らず新着順で並べています。
        カードの濃さは話題度(はてなブックマーク数)、
        <span class="star" aria-hidden="true">★</span> は興味のあるトピックに当たる記事です。
    </p>

    @* ループ変数を section にすると Razor の @@section ディレクティブと衝突する *@
    @foreach (var kindGroup in _sections)
    {
        <div class="section-heading">
            <h2>@kindGroup.Title</h2>
            <a class="see-all" href="@kindGroup.AllHref">すべて見る →</a>
        </div>
        <ul class="list-unstyled">
            @foreach (var article in kindGroup.Articles)
            {
                <ArticleCard Article="article" Selected="IsSelected(article)"
                             SelectedTags="_selected" EmphasizeByPopularity="true" />
            }
        </ul>
    }

    <p class="papers-link">
        論文はここには出しません(はてブにほぼ載らず、話題度で測れないため)。
        <a href="/papers">論文の一覧 →</a>
    </p>
}

@code {
    /// <summary>セクションごとに出す件数。一望のためのページなので、全量は子ページに任せる。</summary>
    const int PerSection = 10;

    /// <summary>「直近」とみなす公開からの日数。窓が無いと動きの止まった話題が居座る。</summary>
    const int WindowDays = 7;

    IReadOnlyList<Section>? _sections;
    HashSet<string> _selected = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // ジョブはバックグラウンドで走らせる(完了後の一覧は自動リロードの GET が読み直す)
    void Collect() =>
        CollectionRunner.StartInBackground(ct => CollectionRunner.RunOnceAsync(ct), JobMessage.Describe);

    void Summarize() =>
        SummaryRunner.StartInBackground(ct => SummaryRunner.RunOnceAsync(ct), JobMessage.Describe);

    async Task LoadAsync()
    {
        var threshold = Clock.GetUtcNow().AddDays(-WindowDays);
        var sections = new List<Section>();
        foreach (var (kind, title, allHref) in Kinds)
        {
            // 新着順のまま直近の窓で切る(話題度は並びではなくカードの強調に出す)
            var articles = (await ArticleStore.GetRecentAsync(PerSection, kind))
                .Where(a => (a.PublishedAt ?? a.CollectedAt) >= threshold)
                .ToList();
            if (articles.Count > 0)
            {
                sections.Add(new Section(title, allHref, articles));
            }
        }

        _sections = sections;
        _selected = (await TopicStore.GetSelectedAsync())
            .Select(topic => topic.Tag)
            .ToHashSet(StringComparer.Ordinal);
    }

    /// <summary>ニュースが先 —— 動きの速いものから読む。</summary>
    static readonly (ArticleKind Kind, string Title, string AllHref)[] Kinds =
    [
        (ArticleKind.News, "ニュース", "/news"),
        (ArticleKind.Article, "記事", "/articles"),
    ];

    record Section(string Title, string AllHref, IReadOnlyList<Article> Articles);

    /// <summary>興味のあるトピックの記事か。★を付けるかの判定にだけ使う(収集では絞らない)。</summary>
    bool IsSelected(Article article) => article.Tags.Any(_selected.Contains);
}
