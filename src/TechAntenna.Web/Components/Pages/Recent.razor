@page "/recent"
@using System.Globalization
@using Microsoft.Extensions.Options
@using TechAntenna.Core
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IArticleStore ArticleStore
@inject INewReleaseStore NewReleaseStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject TimeProvider Clock
@inject IOptions<NewReleaseOptions> NewReleaseSettings

@* 「トレンド」— このページだけは、**興味があるとマークしたトピックの外も含めて**
   直近の話題を一望する場所(そもそもトレンドの収集は選択で絞っていない)。
   **並びは3セクションとも話題度の高い順**(ニュース・記事ははてブ数、論文は upvote)——
   ここは「何が話題か」に答えるページで、新着順は子ページ(/news・/articles・
   /trending-papers)の担当。役割を分けたので、どちらのページも並びが1つで読める *@

<PageTitle>Tech Antenna — トレンド</PageTitle>

<h1>トレンド</h1>

<CollectionHint />

@if (_sections is null)
{
    <p>読み込み中…</p>
}
else
{
    @* **記事が無くてもテーマの節は出す。** 材料も収集のボタンも別なので、
       片方だけ集めた状態(記事はまだ、出版トレンドはある)が実際に起こる *@
    if (_sections.Count == 0)
    {
        <p>まだ記事がありません。<a href="/settings">設定</a>の「トレンドの収集」を実行してください。</p>
    }
    else
    {
    <p class="text-muted">
        直近 @WindowDays 日の話題を、興味のあるトピックに限らず<strong>話題度の高い順</strong>
        (ニュース・記事ははてなブックマーク数、論文は upvote)で並べています。
        新着順で全部見るには各セクションの「すべて見る」へ。
        <span class="star" aria-hidden="true">★</span> は興味のあるトピックに当たる記事です。
        <strong>話題の論文</strong>も Hugging Face Daily Papers から
        トピックに関係なく拾っています。
    </p>

    @* ループ変数を section にすると Razor の @@section ディレクティブと衝突する *@
    @foreach (var kindGroup in _sections)
    {
        <div class="section-heading">
            <h2>@kindGroup.Title</h2>
            <a class="see-all" href="@kindGroup.AllHref">すべて見る →</a>
        </div>
        <ul class="list-unstyled">
            @foreach (var article in kindGroup.Articles)
            {
                <ArticleCard Article="article" Selected="IsSelected(article)"
                             SelectedTags="_selected" EmphasizeByPopularity="true" />
            }
        </ul>
    }
    }

    @* **出版のテーマ**。記事の話題度が「速い反応」なら、こちらは企画から刊行まで
       数か月かかる**遅くて重い動き** —— 同じ「トレンド」でも別の時間軸なので、
       記事のセクションとは見た目を変えて(カードではなく行)最後に置く *@
    @if (_themes is { Count: > 0 })
    {
        <div class="section-heading">
            <h2>本になっているテーマ</h2>
        </div>
        <p class="text-muted theme-note">
            直近 @_themeWindowMonths か月に出た<strong>本・ムック @_releaseCount 冊</strong>の
            タイトルから、語彙にあるテーマを数えたものです。反応の速さではなく
            <strong>出版側が時間をかけて寄せている先</strong>が出ます
            (出典: <a href="https://ndlsearch.ndl.go.jp/" target="_blank" rel="noopener">国立国会図書館サーチ</a>)。
        </p>
        <ul class="list-unstyled themes">
            @foreach (var theme in _themes)
            {
                <li class="theme @(_selected.Contains(theme.Tag) ? "interested" : "")">
                    <a class="theme-name" href="@($"/settings/topics/{Uri.EscapeDataString(theme.Tag)}")">
                        @if (_selected.Contains(theme.Tag))
                        {
                            <span class="star" aria-hidden="true">★</span>
                        }
                        @Catalog.DisplayOf(theme.Tag)
                    </a>
                    <span class="theme-count">@theme.Count 冊</span>
                    <span class="theme-examples text-muted">
                        @foreach (var example in theme.Examples)
                        {
                            <a href="@example.Url" target="_blank" rel="noopener"
                               title="@Describe(example)">@example.Title</a>
                        }
                    </span>
                </li>
            }
        </ul>
    }

    <p class="papers-link">
        <strong>選んだトピックを深掘る</strong>もの(書籍・イベント・トピック検索の論文)は
        <a href="/interests">興味トピック</a>にまとめてあります。
    </p>
}

@code {
    /// <summary>セクションごとに出す件数。一望のためのページなので、全量は子ページに任せる。</summary>
    const int PerSection = 5;

    /// <summary>
    /// 話題度で並べる前に読む件数。**出す件数には連動させない** —— 直近の窓から
    /// 話題度の高いものを選ぶための母集団なので、表示を減らしたぶん母集団まで
    /// 縮めると「新着 N 件の中の1位」になってしまう。
    /// </summary>
    const int CandidatePool = 50;

    /// <summary>「直近」とみなす公開からの日数。窓が無いと動きの止まった話題が居座る。</summary>
    const int WindowDays = 7;

    /// <summary>テーマを数えるために読む新刊の冊数。NDC 007 は月に 100 件弱なので半年で足りる。</summary>
    const int ReleasePool = 1000;

    IReadOnlyList<Section>? _sections;
    HashSet<string> _selected = new(StringComparer.Ordinal);

    /// <summary>出版のテーマ(最近出た本をタイトルのタグで数えたもの)。</summary>
    IReadOnlyList<PublishingTheme>? _themes;

    /// <summary>集計に使った冊数と窓。**数の出どころを画面に書く**ため(何冊中の N 冊か)。</summary>
    int _releaseCount;

    int _themeWindowMonths;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // ジョブはバックグラウンドで走らせる(完了後の一覧は自動リロードの GET が読み直す)
    async Task LoadAsync()
    {
        var threshold = Clock.GetUtcNow().AddDays(-WindowDays);
        var sections = new List<Section>();
        foreach (var (kind, title, allHref) in Kinds)
        {
            // **話題度の高い順**(ニュース・記事ははてブ数、論文は upvote ——
            // 大きいほうで測るのはカードの強調と同じ規則)。直近の窓で切ってから並べるので、
            // 昔の高スコアの記事が居座ることはない。同点(未取得の 0 同士など)は新着順
            var articles = (await ArticleStore.GetRecentAsync(CandidatePool, kind))
                .Where(a => (a.PublishedAt ?? a.CollectedAt) >= threshold)
                .OrderByDescending(a => Math.Max(a.BookmarkCount ?? 0, a.UpvoteCount ?? 0))
                .ThenByDescending(a => a.PublishedAt ?? a.CollectedAt)
                .Take(PerSection)
                .ToList();
            if (articles.Count > 0)
            {
                sections.Add(new Section(title, allHref, articles));
            }
        }

        _sections = sections;
        // ★の判定は配下込み —— 親(AI)を選んだ人にとって、子(LLM・RAG)の記事も興味の範囲
        _selected = Catalog
            .ExpandWithDescendants((await TopicStore.GetSelectedAsync()).Select(topic => topic.Key))
            .ToHashSet(StringComparer.Ordinal);

        await LoadThemesAsync();
    }

    /// <summary>
    /// 出版のテーマを数える。**窓は記事より長い** —— 本は企画から刊行まで数か月かかるので、
    /// 直近 7 日で切ると 1 冊も出てこない。窓は収集と同じ設定(`NewReleases:WindowMonths`)。
    /// </summary>
    async Task LoadThemesAsync()
    {
        _themeWindowMonths = Math.Max(1, NewReleaseSettings.Value.WindowMonths);
        // 「最近」の境界も日本時間で数える
        var since = DateOnly.FromDateTime(
            JapanTime.To(Clock.GetUtcNow()).AddMonths(-_themeWindowMonths).Date);

        var releases = await NewReleaseStore.GetPublishedSinceAsync(since, ReleasePool);
        _releaseCount = releases.Count;
        _themes = PublishingTrend.Themes(releases);
    }

    /// <summary>代表タイトルのツールチップ(出版者と刊行年月)。</summary>
    static string Describe(NewRelease release) => string.Join(" / ", new[]
    {
        release.Publisher,
        release.PublishedOn?.ToString("yyyy-MM", CultureInfo.InvariantCulture),
    }.Where(part => part is { Length: > 0 }));

    /// <summary>ニュースが先 —— 動きの速いものから読む。</summary>
    /// <summary>
    /// 出す種別と順番。**話題の論文もここに入れる** —— トピックの選択に依存せず
    /// 「外で何が話題か」を映すものなので、トレンドの担当。
    /// 検索で取る論文(<see cref="ArticleKind.Paper"/>)は興味トピック側に置く。
    /// </summary>
    static readonly (ArticleKind Kind, string Title, string AllHref)[] Kinds =
    [
        (ArticleKind.News, "ニュース", "/recent/news"),
        (ArticleKind.Article, "記事", "/recent/articles"),
        (ArticleKind.TrendingPaper, "話題の論文", "/recent/papers"),
    ];

    record Section(string Title, string AllHref, IReadOnlyList<Article> Articles);

    /// <summary>興味のあるトピックの記事か。★を付けるかの判定にだけ使う(収集では絞らない)。</summary>
    bool IsSelected(Article article) => article.Tags.Any(_selected.Contains);
}
