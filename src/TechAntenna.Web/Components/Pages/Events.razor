@page "/events"
@using TechAntenna.Core
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IEventStore EventStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject TimeProvider Clock

<PageTitle>Tech Antenna — イベント</PageTitle>

<h1>これからのイベント</h1>

<CollectionHint Job="イベントの収集" />

@if (_events is null)
{
    <p>読み込み中…</p>
}
else if (_events.Count == 0)
{
    <p>まだイベントがありません。<a href="/topics">設定 → トピック</a>でトピックを選んでから、
        <a href="/settings">設定</a>の「イベントの収集」を実行してください
        (connpass から集めるにはキーの設定も要ります)。</p>
}
else
{
    <p class="text-muted">
        <strong>収集対象に選んだトピック（配下のトピックを含む）</strong>のイベントだけを、
        開催日順に出しています。
    </p>

    <ul class="list-unstyled">
        @foreach (var techEvent in _events)
        {
            <li class="mb-2">
                @* Doorkeeper の API Terms of Use により、イベントには必ず元のイベントページへの
                   リンクを付け、nofollow 等を指定してはならない(rel は noopener までにとどめる) *@
                <a href="@techEvent.Url" target="_blank" rel="noopener">@techEvent.Title</a>
                <br />
                <small class="text-muted">
                    @JapanTime.Format(techEvent.StartsAt)
                    — @(techEvent.IsOnline ? "オンライン" : techEvent.Venue ?? "会場未定")
                    @foreach (var tag in techEvent.Tags)
                    {
                        <span class="badge bg-secondary ms-1">@tag</span>
                    }
                </small>
            </li>
        }
    </ul>
}

@code {
    IReadOnlyList<TechEvent>? _events;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        // 出すのは収集対象に選んだトピック(配下込み)のものだけ ——
        // 選択を外したトピックで過去に集めたイベントは、消さずに表示から外れるだけ
        var selected = Catalog
            .ExpandWithDescendants((await TopicStore.GetSelectedAsync()).Select(topic => topic.Key))
            .ToHashSet(StringComparer.Ordinal);
        _events = (await EventStore.GetUpcomingAsync(Clock.GetUtcNow(), 50))
            .Where(techEvent => techEvent.Tags.Any(selected.Contains))
            .ToList();
    }
}
