@page "/events"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Web.Services
@inject IEventStore EventStore
@inject EventCollectionRunner CollectionRunner
@inject TimeProvider Clock

<PageTitle>イベント - tech-antenna</PageTitle>

<h1>これからのイベント</h1>

@* 開発環境では定期実行を止めてあるので(Collection:AutoRun)、ここから手動で走らせる *@
<JobButton Runner="CollectionRunner" FormName="collect-events"
           Message="@_message" Error="@_error" OnRun="CollectAsync" />

@if (_events is null)
{
    <p>読み込み中…</p>
}
else if (_events.Count == 0)
{
    <p>まだイベントがありません。connpass の API キーが設定されているか確認してください。</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var techEvent in _events)
        {
            <li class="mb-2">
                @* Doorkeeper の API Terms of Use により、イベントには必ず元のイベントページへの
                   リンクを付け、nofollow 等を指定してはならない(rel は noopener までにとどめる) *@
                <a href="@techEvent.Url" target="_blank" rel="noopener">@techEvent.Title</a>
                <br />
                <small class="text-muted">
                    @techEvent.StartsAt.ToString("yyyy-MM-dd HH:mm zzz")
                    — @(techEvent.IsOnline ? "オンライン" : techEvent.Venue ?? "会場未定")
                    @foreach (var tag in techEvent.Tags)
                    {
                        <span class="badge bg-secondary ms-1">@tag</span>
                    }
                </small>
            </li>
        }
    </ul>
}

@code {
    IReadOnlyList<TechEvent>? _events;
    string? _message;
    string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task CollectAsync()
    {
        try
        {
            _message = JobMessage.Describe(await CollectionRunner.RunOnceAsync());
        }
        catch (Exception ex)
        {
            // 画面に出す。原因が読めないと押した側は打つ手が無い
            _error = ex.Message;
        }

        await LoadAsync();
    }

    async Task LoadAsync() => _events = await EventStore.GetUpcomingAsync(Clock.GetUtcNow(), 50);
}
