@page "/settings"
@using TechAntenna.Core
@using TechAntenna.Core.Abstractions
@using TechAntenna.Web.Services
@inject ScheduledJobs Jobs
@inject ScheduleRunner ScheduleRunner
@inject TimeProvider Clock
@inject ApiCredentials Credentials
@inject ITagStore TagStore

<PageTitle>Tech Antenna — 設定</PageTitle>

<h1>設定</h1>

@* 設定は種類ごとにページを分けてある(トピックの一覧は長く、外部連携は表なので、
   1ページに詰めると目的の操作へ辿り着けない)。ここは入口と、手動実行のボタンを持つ。
   サイドバーからも同じページへ直接行ける *@

@* **ジョブのボタンはすべてここに集める。** 一覧を見ている画面にボタンを置くと、
   読みに来た人が押す場所と、集めなおしたい人が探す場所が混ざる —— 各ページには
   `CollectionHint` でここへの導線を出す。
   並びは**サイドバーと同じ順**(ホーム → トレンド → 興味トピック → 定番)にして、
   「どの画面のものを集めるボタンか」を見出しで引けるようにしてある *@
<section class="jobs" aria-labelledby="jobs-heading">
    <h2 id="jobs-heading" class="h5">ジョブ</h2>
    <p class="page-note text-muted">
        <strong>ボタンを押すと、そのジョブがいますぐ走ります</strong>
        (バックグラウンドで走り、進捗と結果がボタンの隣に出ます)。
        <strong>左のチェックを入れたジョブは、下で決めた時刻に自動でも走ります</strong> ——
        チェックの横の数字はそのときに走る順番です(下の「定期実行」を参照)。
        <strong>既定はすべてオフ・時刻なし</strong> —— 消し忘れたサーバーが収集先を
        叩き続けたり、LLM や外部 API の無料枠を使い切らないため。
    </p>

    @* **ページのジョブは1つのフォームにまとめる。** チェックとボタンを横に並べるので、
       部品ごとに form を作ると入れ子になってしまう(HTML として不正)。
       押されたのがどのボタンかは submit の value で見分ける ——
       `run:<キー>` なら1回実行、`save-schedule` なら定期実行の設定を保存。
       **実行を押したときチェックは保存しない**(押した操作だけをする) *@
    <form method="post" @formname="jobs" @onsubmit="SubmitAsync">
        <AntiforgeryToken />

    <h3>ホーム</h3>
    @Rows(JobGroup.Home)
    <p class="page-note text-muted">
        収集済みの情報から<strong>押さえておくべき情報のダイジェスト</strong>を LLM で作り、
        <a href="/">ホーム</a>の「今日のサマリー」に出します。
        <strong>技術界隈全体</strong>(トピックの選択に関係なく話題になっているもの)と
        <strong>興味トピック</strong>(選んだトピックに当たる記事・イベント)の
        <strong>2本</strong>を作り、ntfy へも別々に通知します
        (<a href="/settings/topics">トピック</a>を1つも選んでいないときは全体だけ)。
    </p>

    <h3>トレンド</h3>
    @Rows(JobGroup.Trend)
    <p class="page-note text-muted">
        「トレンドの収集」で<strong>ニュース・記事・話題の論文</strong>(<a href="/recent">トレンド</a>の
        下にあるもの)をまとめて 1 巡します(ブックマーク数の補完も含みます)。
        <strong>トピックの選択には依存しません</strong>。
        「記事の要約」は要約がまだ無いものに LLM で要約を付け、
        「論文タイトルの翻訳」は英語タイトルの論文(話題の論文・arXiv)に訳題を付けます。
    </p>

    <h3>興味トピック</h3>
    @Rows(JobGroup.Interests)
    <p class="page-note text-muted">
        <strong>収集対象に選んだトピックを検索語</strong>にして外部へ問い合わせます ——
        <a href="/settings/topics">トピック</a>を選んでいないと<strong>1 件も集まりません</strong>。
        集めたものは<a href="/interests/papers">論文</a>・<a href="/interests/events">イベント</a>・<a href="/interests/books">書籍</a>に出ます。
    </p>

    <h3>定番</h3>
    @Rows(JobGroup.Classics)
    <p class="page-note text-muted">
        「読むべき技術書」を挙げた Qiita 記事から<strong>名指しされた本</strong>を拾い、
        <a href="/classics/books">定番 → 書籍</a>に出します。
        こちらも<strong>トピックの選択には依存しません</strong>。
    </p>

    <h3>トピック(語彙の整備)</h3>
    <p class="page-note text-muted">
        収集で見かけた語を<strong>語彙(トピックのツリー)へ入れていく</strong>ジョブです。
        中身の確認と手直しは<a href="/settings/topics">トピック</a>と<a href="/settings/tags">タグ</a>の画面で。
    </p>

    @* ボタンの行: ボタン / 説明チップの ? / 副作用の注意。
       説明は details ではなく **? を押して出すチップ(HTML 標準の popover)** —— 手順と
       話題度の算出方法をチップ1つにまとめてある(実装は TopicMaintenanceRunner と
       FetchTrendsAsync。説明を変えるときはそちらと揃えること)。
       **2つのボタンは Runner が同じ1つ**なので、片方が走っていればもう片方も実行中になり、
       二重には走らない *@
    <JobButton Runner="_trendScores.Runner" Name="@_trendScores.Name"
               Action="@($"run:{_trendScores.Key}")" Operation="@_trendScores.Key"
               ScheduleKey="@_trendScores.Key" Order="Jobs.OrderOf(_trendScores)"
               Enabled="ScheduleSettings.IsEnabled(Credentials, _trendScores.Key)">
        <button class="help-toggle" type="button" popovertarget="trend-help"
                aria-label="「話題度を取り直す」の説明">?</button>
        @* 副作用(仕分けまちが増える)はチップの中に隠さない —— 押す前に知っておくべき話 *@
        <span class="job-note text-muted">
            外部トレンドで見つかった新しい語が、仕分けまち(<a href="/settings/tags">タグ</a>)に増えることがあります。
        </span>
        <div class="help-popover" id="trend-help" popover>
            <strong>「話題度を取り直す」は何をしている?</strong>
            <p>
                外部トレンドを引いて鮮度を更新します。<strong>LLM は使いません</strong>。
                新しく現れた語は<strong>仕分けまち</strong>として
                <a href="/settings/tags">タグ</a>の画面に溜まり、そこの「タグを仕分けなおす」で語彙に入ります。
            </p>
            <ol>
                <li><strong>話題度を取得</strong> —— Qiita の新着記事と、はてなブックマークの
                    人気エントリーを<strong>押した時点でその場から</strong>取得します
                    (トレンドの収集をいつ回したかには依存しません)</li>
                <li><strong>タグを観測</strong> —— 保存済みの記事・イベント・書籍に付いたタグの件数と、
                    取ってきた話題度を書き込みます。<strong>ここで次の仕分けの対象が決まります</strong>
                    (<a href="/settings/tags">タグ</a>の画面の「仕分けまち」がその一覧です)</li>
                <li><strong>一覧を組み立てる</strong> —— 語彙・話題度・タグの件数を突き合わせて
                    トピック一覧を書き込みます。話題度は親へも合算します</li>
            </ol>
            <strong>話題度はどう算出している?</strong>
            <ul>
                <li>材料は2つ、どちらも<strong>押した時点でその場から取得</strong>します。
                    <strong>Qiita の新着記事(直近 7 日)</strong>は「いいね数」を、
                    <strong>はてなブックマークの人気エントリー</strong>は「ブックマーク数」を
                    重み(どちらも最低 1)として、記事に付いているタグとタイトルに出てくる
                    トピックへ加算します</li>
                <li>別名(<code>人工知能</code> など)は正式表記(<code>AI</code>)へ寄せてから数えます</li>
                <li>材料ごとに<strong>合計を 100 とした割合</strong>に直してから足し合わせます
                    (数値の桁が違う材料どうしを混ぜられるように。1 材料あたり最大 100)</li>
                <li><strong>ツリー表示の値は配下のトピックも合算</strong>した話題度、
                    <strong>ランキング表示はその用語単体</strong>の話題度です</li>
                <li>このボタンを押した時点の値で、自動では更新されません
                    (「タグを仕分けなおす」でも変わりません)</li>
            </ul>
        </div>
    </JobButton>

    @* **仕分けまちが溜まっていることは、押す場所で知らせる。** かつてはトピックの画面に
       出していたが、そこには押すボタンが無く「見つけたのに何もできない」案内だった。
       中身の確認とゴミの除外は<a href="/settings/tags">タグ</a>の画面 *@
    @if (_pendingCount > 0)
    {
        <p class="pending-notice">
            未仕分けのタグが <strong>@_pendingCount 語</strong>あります。
            下の「タグを仕分けなおす」で語彙に入ります
            (中身の確認と除外は<a href="/settings/tags">タグの画面</a>で)。
        </p>
    }
    @* 仕分けまちの中身とゴミの除外は<a href="/settings/tags">タグ</a>の画面。ここは押す場所だけ持つ *@
    <JobButton Runner="_tagClassification.Runner" Name="@_tagClassification.Name"
               Action="@($"run:{_tagClassification.Key}")" Operation="@_tagClassification.Key"
               ScheduleKey="@_tagClassification.Key" Order="Jobs.OrderOf(_tagClassification)"
               Enabled="ScheduleSettings.IsEnabled(Credentials, _tagClassification.Key)" />

    @* 挙動が画面から分かるようにしておく(説明は TopicMaintenanceRunner の実装と揃えること) *@
    <details class="score-help">
        <summary>「タグを仕分けなおす」は何をしている?</summary>
        <p class="text-muted">
            <strong>外部トレンドは引かない</strong>ので、押しても仕分けまちは増えません ——
            押すぶんだけ減り、いつか空になります。話題度も動きません
            (取り直すのは上の「話題度を取り直す」)。
        </p>
        <ol class="text-muted">
            <li><strong>タグを作り直す(1 回目)</strong> —— 保存済みの記事・イベント・書籍のタグを
                生タグとカタログから組み直します。<strong>仕分けの前に走らせるのが要点</strong> ——
                正規化の規則やカタログを変えると、そこで初めて現れる語があり、
                後段だけで回すとその語は次に押すまで仕分けられません</li>
            <li><strong>仕分けまちの語を LLM が分類</strong> —— <a href="/settings/tags">タグ</a>の
                「仕分けまち」の一覧をそのまま渡します(件数での足切りはしません。目立つ順に 1 回
                @TopicMaintenanceRunner.MaxTagsPerClassification 語まで、残りは次の回に続きから)。
                既存トピックと同じ意味なら<strong>別名として吸収</strong>、
                粒度が違う語なら<strong>親付きの新トピック</strong>としてツリーへ、
                トピックでない語(メディア名・一般語)は<strong>除外</strong>します。
                判断できなかった語は 1 週間おいて再挑戦します。
                LLM が未設定ならこの手順は飛ばします(語は仕分けまちのまま残る)</li>
            <li><strong>同義のトピックを寄せる</strong> —— <code>AI</code> と <code>人工知能</code> が
                別々にできてしまった場合に、片方へ寄せます(収集対象に選んだトピックは寄せません)</li>
            <li><strong>用語の説明を埋める</strong> —— 説明がまだ無い用語に LLM が一言説明を付けます
                (トピック名の後ろのかっこ書きと、詳細ページに出ます)。<strong>新しく見つかった語の説明は
                手順 2(分類)の応答に相乗り</strong>していて追加の呼び出しはありません。ここで聞くのは
                以前から一覧にあって説明だけ無い語で、1 回に 300 語まで・<strong>1 語につき 1 回だけ</strong>
                (結果は保存され、次回は聞き直しません)。収集対象に選んだトピックから先に埋めます</li>
            <li><strong>タグを作り直す(2 回目)</strong> —— 今回の分類で増えた別名を、
                保存済みの記事・イベント・書籍のタグへ反映します</li>
            <li><strong>タグを観測して一覧を組み立てる</strong> —— 件数を数え直します。
                <strong>話題度はいまの値をそのまま保ちます</strong>(取り直しはしません)</li>
        </ol>
    </details>

    <h3>定期実行</h3>
    @* **時刻を決めて、チェックの入ったジョブを通しで走らせる。** かつてはジョブごとに
       「N 分ごと」で回していたが、それだと収集・仕分け・サマリーが互いの結果を待たずに
       走り、サマリーがその日の収集を含まない材料で作られることがあった。
       走る順は ScheduledJobs.InOrder(コード側の1か所)で決まり、各行の番号がそれ *@
    <p class="page-note text-muted">
        設定した時刻になると、<strong>チェックを入れたジョブが番号の順に1回ずつ走ります</strong>。
        後ろのジョブは前のジョブが集めたものを材料にするので、この順番は変えられません
        (収集 → 話題度 → タグの仕分け → 要約・翻訳 → 今日のサマリー)。
        <strong>時刻を1つも設定していなければ、定期実行はしません</strong>。
        保存した内容は再起動なしで効きます。
    </p>

    <div class="schedule-times">
        <label for="schedule-times">実行する時刻(日本時間・いくつでも)</label>
        <input id="schedule-times" name="Times" value="@_timesInput"
               placeholder="07:00, 19:00" aria-describedby="schedule-times-help" />
        <span id="schedule-times-help" class="text-muted">
            <code>HH:mm</code> をカンマか空白で区切って並べます(空にすると止まります)。
        </span>
    </div>

    @* **時刻を待たずに、同じ列をいま走らせる。** 設定した直後に確かめたいときと、
       手で1つずつ押していく手間を省きたいときのため。走るのは<b>チェックの入ったジョブだけ</b>で、
       順番も時刻の回と同じ(中身は ScheduleRunner —— 時刻で走るのと同じ経路)。
       **前回の実行時刻(印)は動かさない** —— 手で押したことで、その日の時刻の回が
       消えてしまわないようにするため *@
    <JobButton Runner="ScheduleRunner" Name="@ScheduleRunner.Name" Action="run-schedule">
        <span class="job-note text-muted">
            チェックの入ったジョブを、番号の順に通しで走らせます(時刻の回とは別に数えます)。
        </span>
    </JobButton>

    @* 保存はチェックと時刻をまとめて書き込む。**チェックは未チェックだと POST に
       乗らない**ので、乗っていないジョブはオフとして保存する *@
    <div>
        <button type="submit" name="Action" value="save-schedule"
                class="btn btn-outline-primary btn-sm">定期実行の設定を保存</button>
        @if (_scheduleError is { Length: > 0 })
        {
            <span class="ms-2 text-danger">@_scheduleError</span>
        }
        else if (_scheduleMessage is { Length: > 0 })
        {
            <span class="ms-2 text-body-secondary">@_scheduleMessage</span>
        }
    </div>
    </form>

    @* 次にいつ走るかを出す —— 設定できているつもりで動いていない、に気づけるように *@
    <p class="page-note text-muted">
        @{
            var times = ScheduleSettings.GetTimes(Credentials);
            var enabledCount = Jobs.InOrder.Count(job => ScheduleSettings.IsEnabled(Credentials, job.Key));
        }
        @if (times.Count == 0)
        {
            <text><strong>いまは定期実行しません</strong>(時刻が未設定)。</text>
        }
        else if (enabledCount == 0)
        {
            <text><strong>時刻は設定されていますが、走るジョブがありません</strong>
                (チェックが1つも入っていません)。</text>
        }
        else if (ScheduleSettings.NextOccurrence(times, Clock.GetUtcNow()) is { } next)
        {
            <text>次は <strong>@JapanTime.Format(next)</strong> に @enabledCount 件のジョブが走ります。</text>
        }
    </p>

    @* 通知は定期実行とは別の話(手動生成でも通知する)なので見出しを分ける。
       オン/オフは接続先の設定(外部連携)とは独立に持つ ——
       接続先を消さなくても一時的に通知だけ止められるようにするため。
       チェックボックスは未チェックだと POST に乗らないので、hidden の印(Submitted)で
       「保存が押されたのに値が無い = オフにした」を見分ける *@
    <h2 class="h5">通知</h2>
    <form method="post" @formname="ntfy-toggle" @onsubmit="SaveNtfyToggleAsync" class="ntfy-toggle">
        <AntiforgeryToken />
        <input type="hidden" name="Submitted" value="true" />
        <label>
            <input type="checkbox" name="NotifyEnabled" value="true"
                   checked="@NtfySettings.IsEnabled(Credentials)" />
            今日のサマリーを ntfy へ通知する
        </label>
        <button type="submit" class="btn btn-outline-primary btn-sm ms-2">保存</button>
        @if (_ntfyMessage is { Length: > 0 })
        {
            <span class="ms-2 text-body-secondary">@_ntfyMessage</span>
        }
        else if (!NtfySettings.IsConfigured(Credentials))
        {
            <span class="ms-2 text-body-secondary">
                通知先が未設定です(<a href="/settings/integrations">外部連携</a>で ntfy のトピック名を設定すると届きます)。
            </span>
        }
    </form>
</section>

<h2 class="h5">設定のページ</h2>

<ul class="settings-links list-unstyled">
    <li>
        <a href="/settings/topics">トピック</a>
        <span class="text-muted">
            何を集めるかの選択(チェックボックス)と、「話題度を取り直す」「タグを仕分けなおす」——
            話題度の取り直し・未知の語の LLM 分類・タグの作り直し。
            トピック名から<strong>同義語と親子ツリー</strong>も見られます。
            その下の<a href="/settings/tags">タグ</a>では、語彙になる前の語を状態ごとに見て、
            <strong>仕分けを手で直せます</strong>。
        </span>
    </li>
    <li>
        <a href="/settings/organizers">主催者</a>
        <span class="text-muted">
            <strong>「公式のイベント」と見なす提供元(ベンダー)の名簿</strong>。
            イベントのバッジ・カレンダーの色・注目度順の並びに効きます。
            集まっているイベントの主催者を件数つきで見ながら直せます。
        </span>
    </li>
    <li>
        <a href="/settings/integrations">外部連携</a>
        <span class="text-muted">
            どこから何を集めているか、キーの要否と設定できているか
            (<strong>キーの値そのものは表示しません</strong>)。
        </span>
    </li>
</ul>

@* グループに属するジョブの行(番号は実行順)。**インラインテンプレートはマークアップ側の
   @@{ } にしか書けない**ので、@@code ではなくここに置く(タグの画面と同じ) *@
@{
    RenderFragment Rows(JobGroup group) =>
    @<text>
        @foreach (var entry in Jobs.InOrder
            .Select((job, index) => (Job: job, Order: index + 1))
            .Where(entry => entry.Job.Group == group))
        {
            <JobButton Runner="entry.Job.Runner" Name="@entry.Job.Name"
                       Action="@($"run:{entry.Job.Key}")" Operation="@entry.Job.Key"
                       ScheduleKey="@entry.Job.Key" Order="entry.Order"
                       Enabled="ScheduleSettings.IsEnabled(Credentials, entry.Job.Key)" />
        }
    </text>;
}

@code {
    string? _scheduleMessage;
    string? _scheduleError;
    string? _ntfyMessage;

    /// <summary>時刻の入力欄。保存済みの値で初期化し、保存に失敗したときは打った文字を残す。</summary>
    string _timesInput = "";

    /// <summary>整備の2行は説明チップ・注意を添えるので、行を明示的に組む(他はグループ単位)。</summary>
    ScheduledJob _trendScores = default!;
    ScheduledJob _tagClassification = default!;

    /// <summary>仕分けまちのタグの語数(0 なら案内を出さない)。</summary>
    int _pendingCount;

    protected override async Task OnInitializedAsync()
    {
        _timesInput = ScheduleSettings.Format(ScheduleSettings.GetTimes(Credentials));
        _trendScores = Jobs.ByKey("trend-scores")!;
        _tagClassification = Jobs.ByKey("tag-classification")!;

        // 「仕分けまち」の語数はタグの画面と同じところ(ITagStore)から数える ——
        // 画面に出す数と、実際に LLM へ流れる対象を1か所から出すため
        _pendingCount = (await TagStore.GetPendingAsync(Clock.GetUtcNow())).Count;
    }

    /// <summary>押されたボタン(<c>run:&lt;キー&gt;</c> か <c>save-schedule</c>)。</summary>
    [SupplyParameterFromForm(FormName = "jobs", Name = "Action")]
    public string? Action { get; set; }

    [SupplyParameterFromForm(FormName = "jobs", Name = "Times")]
    public string? Times { get; set; }

    /// <summary>チェックの入ったジョブのキー(name を共有した checkbox の値)。</summary>
    [SupplyParameterFromForm(FormName = "jobs", Name = "Jobs")]
    public string[]? EnabledJobs { get; set; }

    async Task SubmitAsync()
    {
        if (Action is null)
        {
            return;
        }

        if (Action == "save-schedule")
        {
            await SaveScheduleAsync();
            return;
        }

        // 定期実行の列をいますぐ通す(時刻の回と同じ中身)
        if (Action == "run-schedule")
        {
            ScheduleRunner.StartInBackground(
                ScheduleRunner.OperationName,
                ct => ScheduleRunner.RunAndRecordAsync(
                    ScheduleRunner.OperationName, ScheduleRunner.RunOnceAsync, JobMessage.Describe, ct));
            return;
        }

        // **実行は押した1件だけ。** チェックの保存はしない —— 押した操作以外のことを
        // ついでにやると、何が保存されたのか画面から分からなくなる
        if (Action.StartsWith("run:", StringComparison.Ordinal)
            && Jobs.ByKey(Action["run:".Length..]) is { } job)
        {
            job.Runner.StartInBackground(job.Key, job.RunAsync);
        }
    }

    async Task SaveScheduleAsync()
    {
        _scheduleMessage = null;
        _scheduleError = null;

        // **時刻が読めなければ何も保存しない。** 一部だけ保存すると、画面の表示と
        // 実際に走る設定が食い違う
        if (!ScheduleSettings.TryParseTimes(Times, out var times, out var error))
        {
            _timesInput = Times ?? "";
            _scheduleError = error;
            return;
        }

        var enabled = (EnabledJobs ?? []).ToHashSet(StringComparer.Ordinal);
        foreach (var job in Jobs.InOrder)
        {
            // 無効が既定なので、オンだけ "true" を書き、オフは行を消す(= 既定に戻す)
            await ApplyAsync(ScheduleSettings.EnabledName(job.Key), enabled.Contains(job.Key));
        }

        if (times.Count == 0)
        {
            await Credentials.RemoveAsync(ScheduleSettings.TimesName);
            // **前回の実行時刻も消す。** 残すと、あとで時刻を設定しなおしたときに
            // 「その時刻はもう過ぎている」と判定されて、保存した直後に走り出す
            await Credentials.RemoveAsync(ScheduleSettings.LastRunName);
        }
        else
        {
            await Credentials.SetAsync(ScheduleSettings.TimesName, ScheduleSettings.Format(times));
        }

        _timesInput = ScheduleSettings.Format(times);
        _scheduleMessage = times.Count == 0
            ? "保存しました(時刻が無いので定期実行はしません)。"
            : $"保存しました({enabled.Count} 件のジョブを {_timesInput} に実行します)。";

        Task ApplyAsync(string name, bool on) => on
            ? Credentials.SetAsync(name, "true")
            : Credentials.RemoveAsync(name);
    }

    [SupplyParameterFromForm(FormName = "ntfy-toggle", Name = "Submitted")]
    public string? NtfyToggleSubmitted { get; set; }

    [SupplyParameterFromForm(FormName = "ntfy-toggle", Name = "NotifyEnabled")]
    public string? NotifyEnabled { get; set; }

    async Task SaveNtfyToggleAsync()
    {
        if (NtfyToggleSubmitted is null)
        {
            return;
        }

        // 有効が既定なので、オンは行を消す(= 既定に戻す)、オフだけ "false" を書く
        var enable = NotifyEnabled == "true";
        if (enable)
        {
            await Credentials.RemoveAsync(NtfySettings.EnabledName);
        }
        else
        {
            await Credentials.SetAsync(NtfySettings.EnabledName, "false");
        }

        _ntfyMessage = enable ? "通知を有効にしました。" : "通知を無効にしました(接続先の設定は残ります)。";
    }
}
