@page "/settings"
@using TechAntenna.Web.Services
@inject ArticleCollectionRunner CollectionRunner
@inject SummaryRunner SummaryRunner
@inject TitleTranslationRunner TranslationRunner
@inject DigestRunner DigestRunner
@inject ApiCredentials Credentials
@inject Microsoft.Extensions.Options.IOptions<CollectionOptions> CollectionOptions
@inject Microsoft.Extensions.Options.IOptions<BooksOptions> BooksOptions
@inject Microsoft.Extensions.Options.IOptions<AnthropicOptions> AnthropicOptions
@inject Microsoft.Extensions.Options.IOptions<DigestOptions> DigestOptions

<PageTitle>設定 - tech-antenna</PageTitle>

<h1>設定</h1>

@* 設定は種類ごとにページを分けてある(トピックの一覧は長く、外部連携は表なので、
   1ページに詰めると目的の操作へ辿り着けない)。ここは入口と、手動実行のボタンを持つ。
   サイドバーからも同じページへ直接行ける *@

@* **トレンド側の収集はここに集める。** 一覧を見ている画面にジョブのボタンを置くと、
   読みに来た人が押す場所と、集め直したい人が探す場所が混ざる。
   興味トピック側(論文・イベント・書籍)は<b>トピックの選択と地続き</b>なので各ページに残す *@
<section class="jobs" aria-labelledby="jobs-heading">
    <h2 id="jobs-heading" class="h5">手動で集めなおす</h2>
    <p class="page-note text-muted">
        <strong>収集は自動では走りません</strong>(消し忘れたサーバーが収集先を叩き続けたり、
        LLM の枠を使い切らないようにするため)。集めなおしたいときはここから実行します。
        押すとバックグラウンドで走り、進捗がボタンの隣に出ます。
    </p>

    <JobButton Runner="CollectionRunner" FormName="collect-articles" OnRun="Collect" />
    <JobButton Runner="SummaryRunner" FormName="summarize" OnRun="Summarize" />
    <JobButton Runner="TranslationRunner" FormName="translate-titles" OnRun="Translate" />
    <JobButton Runner="DigestRunner" FormName="compose-digest" OnRun="ComposeDigest" />

    <p class="page-note text-muted">
        「トレンドの収集」で<strong>ニュース・記事・話題の論文</strong>(<a href="/recent">トレンド</a>の
        下にあるもの)をまとめて 1 巡します(ブックマーク数の補完も含みます)。
        「記事の要約」は要約がまだ無いものに LLM で要約を付け、
        「論文タイトルの翻訳」は英語タイトルの論文(話題の論文・arXiv)に訳題を付けます。
        「今日のサマリーの生成」は、収集済みの情報と興味トピックから<strong>押さえておくべき
        情報のダイジェスト</strong>を LLM で作り、<a href="/">ホーム</a>に出します。
        <strong>選んだトピックで検索して集めるもの</strong>は、それぞれのページにボタンがあります ——
        <a href="/papers">論文</a>・<a href="/events">イベント</a>・<a href="/books">書籍</a>、
        推薦本は<a href="/classics/books">定番 → 書籍</a>、
        語彙の整理は<a href="/topics">トピック</a>の「話題度を取り直す」「タグを仕分けなおす」です。
    </p>

    <h2 class="h5">定期実行</h2>
    <p class="page-note text-muted">
        チェックを入れたジョブは間隔ごとに自動で走ります(<strong>既定はすべて無効</strong> ——
        消し忘れたサーバーが収集先を叩き続けたり、LLM や外部 API の無料枠を使い切らないため)。
        切り替えは保存した直後から効きます(再起動不要)。
    </p>
    @* チェックボックスは未チェックだと POST に乗らないため、hidden の印(Submitted)で
       「保存が押された」ことを見分け、乗っていない項目をオフとして保存する *@
    <form method="post" @formname="auto-run" @onsubmit="SaveAutoRunAsync" class="auto-run">
        <AntiforgeryToken />
        <input type="hidden" name="Submitted" value="true" />
        <label>
            <input type="checkbox" name="CollectionAutoRun" value="true"
                   checked="@AutoRunSettings.IsEnabled(Credentials, AutoRunSettings.CollectionName)" />
            トレンドとイベントの収集(@CollectionOptions.Value.IntervalMinutes 分ごと)
        </label>
        <label>
            <input type="checkbox" name="BooksAutoRun" value="true"
                   checked="@AutoRunSettings.IsEnabled(Credentials, AutoRunSettings.BooksName)" />
            書籍の収集(@BooksOptions.Value.IntervalHours 時間ごと)
        </label>
        <label>
            <input type="checkbox" name="SummaryAutoRun" value="true"
                   checked="@AutoRunSettings.IsEnabled(Credentials, AutoRunSettings.SummaryName)" />
            記事の要約(@AnthropicOptions.Value.IntervalMinutes 分ごと。LLM のキーが要る)
        </label>
        <label>
            <input type="checkbox" name="DigestAutoRun" value="true"
                   checked="@AutoRunSettings.IsEnabled(Credentials, AutoRunSettings.DigestName)" />
            今日のサマリーの生成(@DigestOptions.Value.IntervalHours 時間ごと。LLM のキーが要る)
        </label>
        <div>
            <button type="submit" class="btn btn-outline-primary btn-sm">保存</button>
            @if (_autoRunMessage is { Length: > 0 })
            {
                <span class="ms-2 text-body-secondary">@_autoRunMessage</span>
            }
        </div>
    </form>

    @* 通知は定期実行とは別の話(手動生成でも通知する)なので見出しを分ける。
       オン/オフは接続先の設定(外部連携)とは独立に持つ ——
       接続先を消さなくても一時的に通知だけ止められるようにするため。
       チェックボックスは未チェックだと POST に乗らないので、hidden の印(Submitted)で
       「保存が押されたのに値が無い = オフにした」を見分ける *@
    <h2 class="h5">通知</h2>
    <form method="post" @formname="ntfy-toggle" @onsubmit="SaveNtfyToggleAsync" class="ntfy-toggle">
        <AntiforgeryToken />
        <input type="hidden" name="Submitted" value="true" />
        <label>
            <input type="checkbox" name="NotifyEnabled" value="true"
                   checked="@NtfySettings.IsEnabled(Credentials)" />
            今日のサマリーを ntfy へ通知する
        </label>
        <button type="submit" class="btn btn-outline-primary btn-sm ms-2">保存</button>
        @if (_ntfyMessage is { Length: > 0 })
        {
            <span class="ms-2 text-body-secondary">@_ntfyMessage</span>
        }
        else if (!NtfySettings.IsConfigured(Credentials))
        {
            <span class="ms-2 text-body-secondary">
                通知先が未設定です(<a href="/integrations">外部連携</a>で ntfy のトピック名を設定すると届きます)。
            </span>
        }
    </form>
</section>

<h2 class="h5">設定のページ</h2>

<ul class="settings-links list-unstyled">
    <li>
        <a href="/topics">トピック</a>
        <span class="text-muted">
            何を集めるかの選択(チェックボックス)と、「話題度を取り直す」「タグを仕分けなおす」——
            話題度の取り直し・未知の語の LLM 分類・タグの作り直し。
            トピック名から<strong>同義語と親子ツリー</strong>も見られます。
            その下の<a href="/tags">タグ</a>では、語彙になる前の語を状態ごとに見て、
            <strong>仕分けを手で直せます</strong>。
        </span>
    </li>
    <li>
        <a href="/integrations">外部連携</a>
        <span class="text-muted">
            どこから何を集めているか、キーの要否と設定できているか
            (<strong>キーの値そのものは表示しません</strong>)。
        </span>
    </li>
</ul>

@code {
    string? _autoRunMessage;
    string? _ntfyMessage;

    [SupplyParameterFromForm(FormName = "auto-run", Name = "Submitted")]
    public string? AutoRunSubmitted { get; set; }

    [SupplyParameterFromForm(FormName = "auto-run", Name = "CollectionAutoRun")]
    public string? CollectionAutoRun { get; set; }

    [SupplyParameterFromForm(FormName = "auto-run", Name = "BooksAutoRun")]
    public string? BooksAutoRun { get; set; }

    [SupplyParameterFromForm(FormName = "auto-run", Name = "SummaryAutoRun")]
    public string? SummaryAutoRun { get; set; }

    [SupplyParameterFromForm(FormName = "auto-run", Name = "DigestAutoRun")]
    public string? DigestAutoRun { get; set; }

    async Task SaveAutoRunAsync()
    {
        if (AutoRunSubmitted is null)
        {
            return;
        }

        // 無効が既定なので、オンだけ "true" を書き、オフは行を消す(= 既定に戻す)
        await ApplyAsync(AutoRunSettings.CollectionName, CollectionAutoRun == "true");
        await ApplyAsync(AutoRunSettings.BooksName, BooksAutoRun == "true");
        await ApplyAsync(AutoRunSettings.SummaryName, SummaryAutoRun == "true");
        await ApplyAsync(AutoRunSettings.DigestName, DigestAutoRun == "true");

        _autoRunMessage = "保存しました。次の周回から反映されます。";

        Task ApplyAsync(string name, bool enabled) => enabled
            ? Credentials.SetAsync(name, "true")
            : Credentials.RemoveAsync(name);
    }


    [SupplyParameterFromForm(FormName = "ntfy-toggle", Name = "Submitted")]
    public string? NtfyToggleSubmitted { get; set; }

    [SupplyParameterFromForm(FormName = "ntfy-toggle", Name = "NotifyEnabled")]
    public string? NotifyEnabled { get; set; }

    async Task SaveNtfyToggleAsync()
    {
        if (NtfyToggleSubmitted is null)
        {
            return;
        }

        // 有効が既定なので、オンは行を消す(= 既定に戻す)、オフだけ "false" を書く
        var enable = NotifyEnabled == "true";
        if (enable)
        {
            await Credentials.RemoveAsync(NtfySettings.EnabledName);
        }
        else
        {
            await Credentials.SetAsync(NtfySettings.EnabledName, "false");
        }

        _ntfyMessage = enable ? "通知を有効にしました。" : "通知を無効にしました(接続先の設定は残ります)。";
    }

    void Collect() =>
        CollectionRunner.StartInBackground(ct => CollectionRunner.RunOnceAsync(ct), JobMessage.Describe);

    void Translate() => TranslationRunner.StartInBackground(
        ct => TranslationRunner.RunOnceAsync(ct),
        result => result.Requested == 0
            ? "訳題の付いていない論文はありません。"
            : $"{result.Requested} 件中 {result.Translated} 件に訳題を付けました。");

    void Summarize() =>
        SummaryRunner.StartInBackground(ct => SummaryRunner.RunOnceAsync(ct), JobMessage.Describe);

    void ComposeDigest() =>
        DigestRunner.StartInBackground(ct => DigestRunner.RunOnceAsync(ct), result => result.Describe());
}
