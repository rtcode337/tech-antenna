@page "/settings/integrations"
@using TechAntenna.Web.Services
@inject IntegrationCatalog Catalog
@inject ApiCredentials Credentials

<PageTitle>Tech Antenna — 設定 / 外部連携</PageTitle>

<h1>設定 / 外部連携</h1>

@* **AI の選択を一番上に置く。** 「どの相手に書かせるか」と「どこから集めるか」は
   どちらも外の相手の設定で、別ページに分けていた頃は要約が動かないときに見る場所が
   2つに割れていた。キーの表より先に出すのは、**相手を決めるのが先**だから *@
<AiBackendSection />

@* **LLM のキーはこの表に出さない。** 相手の行(「どの AI に書かせるか」)のボタンから
   モーダルで設定する —— 「選べない理由がキー未設定」と分かった直後に、同じ行で
   入れられるようにするため。入口を2つ持つと、どちらで入れた値が効くのかを
   画面が説明し続けることになる(`IntegrationCatalog.LlmPurpose` で軸の表から外す) *@
<form method="post" @formname="secrets" @onsubmit="HandleSecretAsync">
    <AntiforgeryToken />

    <h2 class="axis">どこから集めるか</h2>

<p class="text-muted">
    どこから何を集めていて、キーが要るのか・設定できているのかをまとめています。
    <strong>キー・トークンの値そのものは表示しません</strong>(有無だけを見ています)。
    秘匿値でないもの(ntfy のベース URL・トピック名)だけは、保存済みの値を入力欄に出して
    <strong>「コピー」で写せます</strong>。
    キーは各表の<strong>「キーの設定」列</strong>から入れます —— 暗号化して DB に保存され、
    再起動なしですぐ効きます。<strong>設定の入口はこの画面だけ</strong>で、
    環境変数や .env では渡せません(実値をリポジトリや設定ファイルに置かないため)。
</p>

<p class="text-muted">
    <strong>面掃き</strong>(月ごと・期間ごとに全件なめて、参加者数の多いものだけを残す経路)は
    <strong>「状態」列の「動かす」で入れます</strong> ——
    検索語も購読の名簿も要らないので、<strong>名前を知らない大型イベントを拾える唯一の経路</strong>ですが、
    1 回の収集で数十リクエストかかるため<strong>既定では走りません</strong>。
    こちらも再起動なしで効きます(参加者数のしきい値と何か月ぶん見るかは設定ファイル側です)。
</p>

@if (_secretError is { Length: > 0 })
{
    <p class="text-danger">@_secretError</p>
}
else if (_secretMessage is { Length: > 0 })
{
    <p class="text-body-secondary">@_secretMessage</p>
}

@* **画面と同じ3軸で分ける。** 「トレンドが動かない」「興味トピックが動かない」
   「定番が動かない」で見る場所が変わるので、どちらの軸で使う連携なのかを先に示す。
   **複数の軸で使うものは、その全部の節に出す**(片方だけに置くと、もう片方から辿れない)

   キーの入力は各行の「キーの設定」列。**フォームはページ全体で1つ**にして、押した
   ボタンの value(save:<節>:<キー> / clear:<節>:<キー>)で行を見分ける(タグの画面と
   同じ流儀 —— 行ごとにフォームを作ると @@formname が数十個になる)。同じ連携が複数の節に
   出るぶん input の name が重複しないよう、節(軸)の番号を名前に含めている ——
   重複すると Request.Form が複数の値をカンマで連結し、保存した値が壊れる *@
    @AxisSection(IntegrationAxis.Trending, "トレンドで使う",
        "トピックの選択に関係なく集めるもの(ニュース・記事・話題の論文)。")
    @AxisSection(IntegrationAxis.Interests, "興味トピックで使う",
        "選んだトピックを検索語にして集めるもの(書籍・イベント・論文)。")
    @AxisSection(IntegrationAxis.Classics, "定番で使う",
        "時間が経っても薦められ続けるもの(推薦本)。トピックの選択には依存しない。")
</form>

@* 用途ごとの表。1つの軸の中を用途で束ねる *@
@{
    RenderFragment AxisSection(IntegrationAxis axis, string title, string note) =>
    @<text>
        @* AI の節と「どこから集めるか」が h2 になったので、軸は h3・用途は h4 に下げる *@
        <h3 class="axis">@title</h3>
        <p class="text-muted axis-note">
            @note
            @{
                // LLM は上の節へ移したので、ここで数えるのは軸をまたぐ残り(話題度・書誌の補完)だけ
                var shared = _all.Count(i =>
                    i.Axis == IntegrationAxis.Both
                    && i.Axis.HasFlag(axis)
                    && i.Purpose != IntegrationCatalog.LlmPurpose);
            }
            @if (shared > 0)
            {
                <text>両方の軸で使う @shared 件もここに含めています。</text>
            }
        </p>
        @* LLM の用途はこの表から外す(上の「どの AI に書かせるか」の節に出してある) *@
        @foreach (var group in _all
            .Where(i => i.Axis.HasFlag(axis) && i.Purpose != IntegrationCatalog.LlmPurpose)
            .GroupBy(integration => integration.Purpose))
        {
            @PurposeTable(axis, group)
        }
    </text>;

    RenderFragment PurposeTable(
        IntegrationAxis axis, IGrouping<string, Integration> group, bool showHeading = true) =>
    @<text>
        @if (showHeading)
        {
            <h4 class="purpose">@group.Key</h4>
        }
    @* スマホでは 1 行 1 枚のカードに畳む(5 列 + 入力欄は詰めても収まらない。app.css の .table.stack) *@
    <table class="table align-middle stack">
        <thead>
            <tr>
                <th scope="col">連携先</th>
                <th scope="col">キー</th>
                <th scope="col">未設定・無効のとき</th>
                <th scope="col">状態</th>
                <th scope="col">キーの設定</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var integration in group)
            {
                <tr>
                    <td>@integration.Name</td>
                    <td data-label="キー">@NeedLabel(integration.Need)</td>
                    @* 説明文の `**強調**` と `` `コード` `` は HTML に直して出す
                       (そのままだと記号が画面に見える。InlineMarkup) *@
                    <td class="text-muted effect" data-label="未設定のとき">
                        @InlineMarkup.ToHtml(integration.Effect)
                    </td>
                    @* 状態はキーの設定の隣に置く —— 「未設定を見つける → その場で入れる」が
                       視線の移動なしにつながるようにするため *@
                    <td data-label="状態">
                        <span class="badge @StatusClass(integration)">@StatusLabel(integration)</span>
                        @* **オン/オフを持つ連携(面掃き)は、状態の隣で切り替える。**
                           1 クリックで反転させる —— キーのように打ち込む値が無く、
                           「保存」を挟むと押したのに効いていない状態が生まれるため。
                           押した行は value に設定パスを入れて見分ける(キーの保存と同じ流儀) *@
                        @if (integration.ToggleName is { Length: > 0 } toggleName)
                        {
                            <button type="submit" class="btn btn-outline-secondary btn-sm toggle"
                                    name="Action" value="toggle:@((int)axis):@toggleName">
                                @(integration.Enabled ? "止める" : "動かす")
                            </button>
                        }
                    </td>
                    <td class="secret-cell" data-label="キーの設定">
                        @if (integration.SecretNames is { Count: > 0 } secretNames)
                        {
                            @* ほとんどの連携はキー 1 つだが、ntfy は接続先一式で複数持つ。
                               複数のときはどの欄か分かるようラベルを添えて縦に並べる *@
                            @foreach (var secretName in secretNames)
                            {
                                var editable = IntegrationCatalog.EditableSecrets
                                    .First(secret => secret.SecretName == secretName);
                                @* 入力欄に出す値。「生成」で作った値はまだ保存していないので、
                                   保存済みの値より優先して見せる(保存を押すまでは効かない) *@
                                var shown = editable.Sensitive
                                    ? null
                                    : _generated.GetValueOrDefault(secretName) ?? Credentials.Get(secretName);
                                <div class="secret-row">
                                    @if (secretNames.Count > 1)
                                    {
                                        <span class="secret-label text-muted">@editable.Label</span>
                                    }
                                    @* 秘匿値は入力欄に受けるだけで画面に残さない。ブラウザにも覚えさせない。
                                       秘匿値でないもの(ntfy の URL・トピック名)は**保存済みの値を出す** ——
                                       打った値が見えるほうが打ち間違いに気づけるし、後から
                                       「今どこへ通知しているのか」を確かめる先がこの画面しかないため *@
                                    <input type="@(editable.Sensitive ? "password" : "text")"
                                           id="value-@((int)axis)-@secretName"
                                           name="value-@((int)axis)-@secretName"
                                           value="@shown"
                                           autocomplete="@(editable.Sensitive ? "new-password" : "off")"
                                           placeholder="@(editable.Hint ?? "新しい値")"
                                           aria-label="@editable.Label" />
                                    @* コピーは JS の上乗せ(hidden で描き copy-field.js が出す)。
                                       ntfy のトピック名を購読側の端末へ渡すのに要る *@
                                    @if (!editable.Sensitive && Credentials.Has(secretName))
                                    {
                                        <button type="button" hidden
                                                data-copy-target="value-@((int)axis)-@secretName"
                                                class="btn btn-outline-secondary btn-sm copy-field">コピー</button>
                                    }
                                    @* 自分で決めてよい値(ntfy のトピック名)は乱数で作れる。
                                       作るだけで保存はしない —— 気に入らなければ押し直せるし、
                                       設定済みのトピックを1クリックで置き換えてしまわないため *@
                                    @if (editable.Generate is not null)
                                    {
                                        <button type="submit" name="Action" value="generate:@((int)axis):@secretName"
                                                class="btn btn-outline-secondary btn-sm">生成</button>
                                    }
                                    <button type="submit" name="Action" value="save:@((int)axis):@secretName"
                                            class="btn btn-outline-primary btn-sm">保存</button>
                                    @if (Credentials.Has(secretName))
                                    {
                                        <button type="submit" name="Action" value="clear:@((int)axis):@secretName"
                                                class="btn btn-outline-secondary btn-sm">削除</button>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </text>;
}

@code {
    IReadOnlyList<Integration> _all = [];

    string? _secretMessage;
    string? _secretError;

    /// <summary>「生成」で作ったが、まだ保存していない値(キー → 値)。この 1 リクエストだけ持つ。</summary>
    readonly Dictionary<string, string> _generated = [];

    [CascadingParameter]
    HttpContext? HttpContext { get; set; }

    /// <summary>押されたボタンの値(save:&lt;節&gt;:&lt;キー&gt; / clear:&lt;節&gt;:&lt;キー&gt;)。</summary>
    [SupplyParameterFromForm(FormName = "secrets")]
    public string? Action { get; set; }

    protected override void OnInitialized() =>
        // 並びは収集の流れ(記事 → ニュース → 話題の論文 → 書籍 → …)のまま出す
        _all = Catalog.GetAll();

    async Task HandleSecretAsync()
    {
        if (Action is null)
        {
            return;
        }

        // "save:2:Connpass:ApiKey" → 動詞・節(軸)の番号・設定パス。
        // パスにもコロンが入るので 3 分割まで(3つ目以降はパスとして丸ごと残す)
        var parts = Action.Split(':', 3);
        var name = parts.Length > 2 ? parts[2] : "";

        // **切り替えはキーの解決より前に処理する** —— 面掃きのオン/オフは
        // 打ち込む値ではないので EditableSecrets には載っていない
        if (parts[0] == "toggle")
        {
            var integration = _all.FirstOrDefault(i => i.ToggleName == name);
            if (integration is null)
            {
                _secretError = "不明な切り替えです。";

                return;
            }

            await SweepSettings.SetAsync(Credentials, name, !integration.Enabled);
            _secretError = null;
            _secretMessage = integration.Enabled
                ? $"{integration.Name} を止めました。次の収集からは走りません。"
                : $"{integration.Name} を動かします。再起動なしで、次の収集から走ります。";
            _all = Catalog.GetAll();

            return;
        }

        var editable = IntegrationCatalog.EditableSecrets
            .FirstOrDefault(secret => secret.SecretName == name);
        if (editable is null)
        {
            _secretError = "不明なキーです。";
            return;
        }

        if (parts[0] == "generate")
        {
            if (editable.Generate is null)
            {
                _secretError = $"{editable.Label}: このキーは生成できません。";
                return;
            }

            // 入力欄に入れるだけで保存はしない(押した人が見てから「保存」を押す)
            _generated[name] = editable.Generate();
            _secretError = null;
            _secretMessage = $"{editable.Label} を作りました。「保存」を押すまでは有効になりません。";

            return;
        }

        if (parts[0] == "save")
        {
            // 値の束縛はせず HttpContext から読む —— [SupplyParameterFromForm] のプロパティを
            // キーごとに生やさないため。値をモデルに持たないので、再描画で画面に漏れることもない。
            // 節の番号まで含めた name で引くので、他の節にある同じキーの空欄と混ざらない
            var value = HttpContext?.Request.Form[$"value-{parts[1]}-{name}"].ToString();
            if (string.IsNullOrWhiteSpace(value))
            {
                _secretError = $"{editable.Label}: 値が空です。";
                return;
            }

            await Credentials.SetAsync(name, value);
            _secretMessage = $"{editable.Label} を保存しました。再起動なしで反映されます。";
        }
        else
        {
            await Credentials.RemoveAsync(name);
            _secretMessage = $"{editable.Label} の画面設定を削除しました。";
        }

        _secretError = null;
        // 状態の列にも今の状態を映す
        _all = Catalog.GetAll();
    }

    static string NeedLabel(CredentialNeed need) => need switch
    {
        CredentialNeed.Required => "必須",
        CredentialNeed.EitherRequired => "どちらか必須",
        CredentialNeed.Optional => "任意",
        _ => "不要",
    };

    // 状態は「キーの要否」と「そもそも使う設定か」の掛け合わせ。
    // 使わない設定にしてある連携は、キーの有無より先にそれを出す
    static string StatusLabel(Integration integration) => integration switch
    {
        { Enabled: false } => "無効",
        { Need: CredentialNeed.NotNeeded } => "キー不要",
        { Configured: true } => "設定済み",
        // 「どちらか必須」は、もう一方が設定済みなら未設定でも困っていない
        { Need: CredentialNeed.EitherRequired, AlternativeConfigured: true } => "未設定（もう一方で動作）",
        { Need: CredentialNeed.Required or CredentialNeed.EitherRequired } => "未設定（動かない）",
        // 任意キーが未設定 = この連携はキー無しでも動く(上限・機能が増えないだけ)
        _ => "未設定（無くても動く）",
    };

    static string StatusClass(Integration integration) => integration switch
    {
        { Enabled: false } => "bg-secondary",
        { Need: CredentialNeed.NotNeeded } => "bg-success",
        { Configured: true } => "bg-success",
        // 「もう一方で動作」は問題の印ではないので、警告色ではなく控えめな色
        { Need: CredentialNeed.EitherRequired, AlternativeConfigured: true } => "bg-secondary",
        { Need: CredentialNeed.Required or CredentialNeed.EitherRequired } => "bg-danger",
        _ => "bg-warning text-dark",
    };
}
