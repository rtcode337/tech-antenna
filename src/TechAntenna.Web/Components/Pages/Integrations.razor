@page "/integrations"
@using TechAntenna.Web.Services
@inject IntegrationCatalog Catalog

<PageTitle>外部連携 - tech-antenna</PageTitle>

<h1>外部連携</h1>

<p class="text-muted">
    どこから何を集めていて、キーが要るのか・設定できているのかをまとめています。
    <strong>キーの値そのものは表示しません</strong>(有無だけを見ています)。
    設定は環境変数か user-secrets で渡します —— 実値はリポジトリに置きません。
</p>

@* **画面と同じ2軸で分ける。** 「トレンドが動かない」と「興味トピックが動かない」で
   見る場所が変わるので、どちらの軸で使う連携なのかを先に示す。
   **両方で使うものは両方の節に出す**(片方だけに置くと、もう片方から辿れない) *@
@AxisSection(IntegrationAxis.Trending, "トレンドで使う",
    "トピックの選択に関係なく集めるもの(ニュース・記事・話題の論文)。")
@AxisSection(IntegrationAxis.Interests, "興味トピックで使う",
    "選んだトピックを検索語にして集めるもの(書籍・イベント・論文)。")

@* 用途ごとの表。1つの軸の中を用途で束ねる *@
@{
    RenderFragment AxisSection(IntegrationAxis axis, string title, string note) =>
    @<text>
        <h2 class="axis">@title</h2>
        <p class="text-muted axis-note">
            @note
            @{
                var shared = _all.Count(i => i.Axis == IntegrationAxis.Both && i.Axis.HasFlag(axis));
            }
            @if (shared > 0)
            {
                <text>両方の軸で使う @shared 件(話題度・LLM)もここに含めています。</text>
            }
        </p>
        @foreach (var group in _all.Where(i => i.Axis.HasFlag(axis))
            .GroupBy(integration => integration.Purpose))
        {
            @PurposeTable(group)
        }
    </text>;

    RenderFragment PurposeTable(IGrouping<string, Integration> group) =>
    @<text>
        <h3 class="purpose">@group.Key</h3>
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">連携先</th>
                <th scope="col">キー</th>
                <th scope="col">状態</th>
                <th scope="col">設定する環境変数</th>
                <th scope="col">未設定・無効のとき</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var integration in group)
            {
                <tr>
                    <td>@integration.Name</td>
                    <td>@NeedLabel(integration.Need)</td>
                    <td><span class="badge @StatusClass(integration)">@StatusLabel(integration)</span></td>
                    <td>
                        @if (integration.SettingKey is { } key)
                        {
                            <code>@key</code>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-muted">@integration.Effect</td>
                </tr>
            }
        </tbody>
    </table>
    </text>;
}

@code {
    IReadOnlyList<Integration> _all = [];

    protected override void OnInitialized() =>
        // 並びは収集の流れ(記事 → ニュース → 話題の論文 → 書籍 → …)のまま出す
        _all = Catalog.GetAll();

    static string NeedLabel(CredentialNeed need) => need switch
    {
        CredentialNeed.Required => "必須",
        CredentialNeed.Optional => "任意",
        _ => "不要",
    };

    // 状態は「キーの要否」と「そもそも使う設定か」の掛け合わせ。
    // 使わない設定にしてある連携は、キーの有無より先にそれを出す
    static string StatusLabel(Integration integration) => integration switch
    {
        { Enabled: false } => "無効",
        { Need: CredentialNeed.NotNeeded } => "キー不要",
        { Configured: true } => "設定済み",
        { Need: CredentialNeed.Required } => "未設定（動かない）",
        _ => "未設定（一部だけ）",
    };

    static string StatusClass(Integration integration) => integration switch
    {
        { Enabled: false } => "bg-secondary",
        { Need: CredentialNeed.NotNeeded } => "bg-success",
        { Configured: true } => "bg-success",
        { Need: CredentialNeed.Required } => "bg-danger",
        _ => "bg-warning text-dark",
    };
}
