@page "/articles"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IArticleStore ArticleStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject ArticleCollectionRunner CollectionRunner
@inject SummaryRunner SummaryRunner
@inject TitleTranslationRunner TranslationRunner

<PageTitle>記事 - tech-antenna</PageTitle>

<h1>最新記事</h1>

@* 開発環境では定期実行を止めてあるので(Collection:AutoRun / Anthropic:AutoRun)、
   ここから手動で走らせる *@
<JobButton Runner="CollectionRunner" FormName="collect-articles"
           Message="@_collectMessage" Error="@_collectError" OnRun="CollectAsync" />
<JobButton Runner="SummaryRunner" FormName="summarize"
           Message="@_summaryMessage" Error="@_summaryError" OnRun="SummarizeAsync" />
<JobButton Runner="TranslationRunner" FormName="translate-titles"
           Message="@_translateMessage" Error="@_translateError" OnRun="TranslateAsync" />

@if (_sections is null)
{
    <p>読み込み中…</p>
}
else if (_sections.Count == 0)
{
    <p>まだ記事がありません。「記事の収集」を実行してください。</p>
}
else
{
    <p class="text-muted">
        流れてきたものはすべて並べています。
        @if (_selected.Count > 0)
        {
            <text>選んだトピック(@string.Join("・", _selected.Select(Catalog.DisplayOf)))のものは<strong>強調</strong>しています。</text>
        }
        else
        {
            <text><a href="/settings">設定</a>でトピックを選ぶと、そのトピックのものが強調されます。</text>
        }
    </p>

    @* ループ変数を section にすると Razor の @@section ディレクティブと衝突する *@
    @foreach (var kindGroup in _sections)
    {
        <h2 class="section-heading">@kindGroup.Title <span class="badge bg-secondary">@kindGroup.Articles.Count</span></h2>
        <ul class="list-unstyled">
            @foreach (var article in kindGroup.Articles)
            {
                <li class="article @(IsSelected(article) ? "selected" : "")">
                    @* 訳題があればそれを見出しにし、原題は下に小さく残す
                       —— 原題を消すと他の文献と突き合わせられなくなる *@
                    @if (article.TitleJa is { Length: > 0 } titleJa)
                    {
                        <a href="@article.Url" target="_blank" rel="noopener">@titleJa</a>
                        <div class="original-title">@article.Title</div>
                    }
                    else
                    {
                        <a href="@article.Url" target="_blank" rel="noopener">@article.Title</a>
                    }
                    @if (!string.IsNullOrEmpty(article.Summary))
                    {
                        <div class="text-body-secondary">@article.Summary</div>
                    }
                    <small class="text-muted">
                        @article.SourceName
                        @if (article.PublishedAt is { } publishedAt)
                        {
                            <text> — @publishedAt.ToString("yyyy-MM-dd HH:mm zzz")</text>
                        }
                        @* 選んだトピックのタグだけ色を変える(なぜ強調されているかが分かるように) *@
                        @foreach (var tag in article.Tags)
                        {
                            <span class="badge ms-1 @(_selected.Contains(tag) ? "bg-primary" : "bg-secondary")">@tag</span>
                        }
                    </small>
                </li>
            }
        </ul>
    }
}

@code {
    /// <summary>種別ごとに読み込む件数。混ぜて上位 N 件にすると、更新の速いニュースが記事を押し出す。</summary>
    const int PerKind = 30;

    IReadOnlyList<Section>? _sections;
    /// <summary>選択中のトピックのキー(記事の正規化済みタグと突き合わせる)。</summary>
    HashSet<string> _selected = new(StringComparer.Ordinal);
    string? _collectMessage;
    string? _collectError;
    string? _summaryMessage;
    string? _summaryError;
    string? _translateMessage;
    string? _translateError;

    protected override async Task OnInitializedAsync() => await LoadArticlesAsync();

    async Task CollectAsync()
    {
        try
        {
            _collectMessage = JobMessage.Describe(await CollectionRunner.RunOnceAsync());
        }
        catch (Exception ex)
        {
            _collectError = ex.Message;
        }

        await LoadArticlesAsync();
    }

    async Task TranslateAsync()
    {
        try
        {
            var result = await TranslationRunner.RunOnceAsync();
            _translateMessage = result.Requested == 0
                ? "訳題の付いていない論文はありません。"
                : $"{result.Requested} 件中 {result.Translated} 件に訳題を付けました。";
            _translateError = null;
        }
        catch (Exception ex)
        {
            _translateError = ex.Message;
        }

        await LoadArticlesAsync();
    }

    async Task SummarizeAsync()
    {
        try
        {
            _summaryMessage = JobMessage.Describe(await SummaryRunner.RunOnceAsync());
        }
        catch (Exception ex)
        {
            _summaryError = ex.Message;
        }

        await LoadArticlesAsync();
    }

    async Task LoadArticlesAsync()
    {
        // 種別ごとに引く(混ぜて上位 N 件にすると、件数の多い種別に埋もれる)
        var sections = new List<Section>();
        foreach (var (kind, title) in Kinds)
        {
            var articles = await ArticleStore.GetRecentAsync(PerKind, kind);
            if (articles.Count > 0)
            {
                sections.Add(new Section(title, articles));
            }
        }

        _sections = sections;
        _selected = (await TopicStore.GetSelectedAsync())
            .Select(topic => topic.Tag)
            .ToHashSet(StringComparer.Ordinal);
    }

    static readonly (ArticleKind Kind, string Title)[] Kinds =
    [
        (ArticleKind.Article, "記事"),
        (ArticleKind.News, "ニュース"),
        (ArticleKind.Paper, "論文"),
    ];

    /// <summary>種別1つぶんの見出しと中身。</summary>
    record Section(string Title, IReadOnlyList<Article> Articles);

    /// <summary>選んだトピックの記事か。強調するかどうかの判定にだけ使う(収集では絞らない)。</summary>
    bool IsSelected(Article article) => article.Tags.Any(_selected.Contains);
}
