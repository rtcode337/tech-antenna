@page "/articles"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IArticleStore ArticleStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject TimeProvider Clock
@inject ArticleCollectionRunner CollectionRunner
@inject SummaryRunner SummaryRunner

<PageTitle>記事 - tech-antenna</PageTitle>

<h1>記事・ニュース</h1>

@* 開発環境では定期実行を止めてあるので(Collection:AutoRun / Anthropic:AutoRun)、
   ここから手動で走らせる。論文タイトルの翻訳ボタンは /papers にある *@
<JobButton Runner="CollectionRunner" FormName="collect-articles"
           Message="@_collectMessage" Error="@_collectError" OnRun="CollectAsync" />
<JobButton Runner="SummaryRunner" FormName="summarize"
           Message="@_summaryMessage" Error="@_summaryError" OnRun="SummarizeAsync" />

@if (_featured is null)
{
    <p>読み込み中…</p>
}
else if (_featured.Count == 0)
{
    <p>まだ記事がありません。「記事の収集」を実行してください。</p>
}
else
{
    <p class="text-muted">
        直近 @WindowDays 日でブックマークが多いものを出しています。
        すべての一覧は各セクションの「すべて見る」からどうぞ。
        @if (_selected.Count > 0)
        {
            <text>選んだトピック(@string.Join("・", _selected.Select(Catalog.DisplayOf)))のものは<strong>強調</strong>しています。</text>
        }
    </p>

    @* ループ変数を section にすると Razor の @@section ディレクティブと衝突する *@
    @foreach (var kindGroup in _featured)
    {
        <div class="section-heading">
            <h2>注目の@(kindGroup.Title)</h2>
            <a class="see-all" href="@kindGroup.AllHref">すべて見る →</a>
        </div>
        <ul class="list-unstyled">
            @foreach (var article in kindGroup.Articles)
            {
                <ArticleCard Article="article" Selected="IsSelected(article)" SelectedTags="_selected" />
            }
        </ul>
    }

    <p class="papers-link">
        論文は注目には出しません(はてブにほぼ載らないため)。
        <a href="/papers">論文の一覧 →</a>
    </p>
}

@code {
    /// <summary>セクションごとに出す件数。ハブなので少なめにして、全量は子ページに任せる。</summary>
    const int FeaturedCount = 5;

    /// <summary>注目の対象にする公開からの日数。窓が無いと古い有名記事が居座り続ける。</summary>
    const int WindowDays = 7;

    /// <summary>窓の中から候補にする件数(新着順で先頭から)。</summary>
    const int CandidateCount = 100;

    IReadOnlyList<Section>? _featured;
    HashSet<string> _selected = new(StringComparer.Ordinal);
    string? _collectMessage;
    string? _collectError;
    string? _summaryMessage;
    string? _summaryError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task CollectAsync()
    {
        try
        {
            _collectMessage = JobMessage.Describe(await CollectionRunner.RunOnceAsync());
        }
        catch (Exception ex)
        {
            _collectError = ex.Message;
        }

        await LoadAsync();
    }

    async Task SummarizeAsync()
    {
        try
        {
            _summaryMessage = JobMessage.Describe(await SummaryRunner.RunOnceAsync());
        }
        catch (Exception ex)
        {
            _summaryError = ex.Message;
        }

        await LoadAsync();
    }

    async Task LoadAsync()
    {
        var sections = new List<Section>();
        foreach (var (kind, title, allHref) in Kinds)
        {
            var articles = await Pick(kind);
            if (articles.Count > 0)
            {
                sections.Add(new Section(title, allHref, articles));
            }
        }

        _featured = sections;
        _selected = (await TopicStore.GetSelectedAsync())
            .Select(topic => topic.Tag)
            .ToHashSet(StringComparer.Ordinal);
    }

    /// <summary>
    /// 直近 <see cref="WindowDays"/> 日の中からブックマーク数の多い順に選ぶ。
    /// まだ件数が入っていない環境では全件が同率になり、自然に新着順の先頭が出る
    /// (空のセクションを出すより、収集直後から画面が埋まるほうがよい)。
    /// </summary>
    async Task<IReadOnlyList<Article>> Pick(ArticleKind kind)
    {
        var threshold = Clock.GetUtcNow().AddDays(-WindowDays);

        return (await ArticleStore.GetRecentAsync(CandidateCount, kind))
            .Where(a => (a.PublishedAt ?? a.CollectedAt) >= threshold)
            .OrderByDescending(a => a.BookmarkCount ?? -1)
            .ThenByDescending(a => a.PublishedAt ?? a.CollectedAt)
            .Take(FeaturedCount)
            .ToList();
    }

    static readonly (ArticleKind Kind, string Title, string AllHref)[] Kinds =
    [
        (ArticleKind.Article, "記事", "/articles/list"),
        (ArticleKind.News, "ニュース", "/news"),
    ];

    record Section(string Title, string AllHref, IReadOnlyList<Article> Articles);

    /// <summary>選んだトピックの記事か。強調するかどうかの判定にだけ使う(収集では絞らない)。</summary>
    bool IsSelected(Article article) => article.Tags.Any(_selected.Contains);
}
