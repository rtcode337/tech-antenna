@page "/articles"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject IArticleStore ArticleStore
@inject ITopicStore TopicStore
@inject TopicCatalog Catalog
@inject ArticleCollectionRunner CollectionRunner
@inject SummaryRunner SummaryRunner

<PageTitle>記事 - tech-antenna</PageTitle>

<h1>最新記事</h1>

@* 開発環境では定期実行を止めてあるので(Collection:AutoRun / Anthropic:AutoRun)、
   ここから手動で走らせる *@
<JobButton Runner="CollectionRunner" FormName="collect-articles"
           Message="@_collectMessage" Error="@_collectError" OnRun="CollectAsync" />
<JobButton Runner="SummaryRunner" FormName="summarize"
           Message="@_summaryMessage" Error="@_summaryError" OnRun="SummarizeAsync" />

@if (_articles is null)
{
    <p>読み込み中…</p>
}
else if (_articles.Count == 0)
{
    <p>まだ記事がありません。収集ジョブの巡回を待ってください。</p>
}
else
{
    <p class="text-muted">
        流れてきた記事はすべて並べています。
        @if (_selected.Count > 0)
        {
            <text>選んだトピック(@string.Join("・", _selected.Select(Catalog.DisplayOf)))の記事は<strong>強調</strong>しています。</text>
        }
        else
        {
            <text><a href="/settings">設定</a>でトピックを選ぶと、その記事が強調されます。</text>
        }
    </p>

    <ul class="list-unstyled">
        @foreach (var article in _articles)
        {
            <li class="article @(IsSelected(article) ? "selected" : "")">
                <a href="@article.Url" target="_blank" rel="noopener">@article.Title</a>
                @if (!string.IsNullOrEmpty(article.Summary))
                {
                    <div class="text-body-secondary">@article.Summary</div>
                }
                <small class="text-muted">
                    @article.SourceName
                    @if (article.PublishedAt is { } publishedAt)
                    {
                        <text> — @publishedAt.ToString("yyyy-MM-dd HH:mm zzz")</text>
                    }
                    @* 選んだトピックのタグだけ色を変える(なぜ強調されているかが分かるように) *@
                    @foreach (var tag in article.Tags)
                    {
                        <span class="badge ms-1 @(_selected.Contains(tag) ? "bg-primary" : "bg-secondary")">@tag</span>
                    }
                </small>
            </li>
        }
    </ul>
}

@code {
    IReadOnlyList<Article>? _articles;
    /// <summary>選択中のトピックのキー(記事の正規化済みタグと突き合わせる)。</summary>
    HashSet<string> _selected = new(StringComparer.Ordinal);
    string? _collectMessage;
    string? _collectError;
    string? _summaryMessage;
    string? _summaryError;

    protected override async Task OnInitializedAsync() => await LoadArticlesAsync();

    async Task CollectAsync()
    {
        try
        {
            _collectMessage = JobMessage.Describe(await CollectionRunner.RunOnceAsync());
        }
        catch (Exception ex)
        {
            _collectError = ex.Message;
        }

        await LoadArticlesAsync();
    }

    async Task SummarizeAsync()
    {
        try
        {
            _summaryMessage = JobMessage.Describe(await SummaryRunner.RunOnceAsync());
        }
        catch (Exception ex)
        {
            _summaryError = ex.Message;
        }

        await LoadArticlesAsync();
    }

    async Task LoadArticlesAsync()
    {
        _articles = await ArticleStore.GetRecentAsync(50);
        _selected = (await TopicStore.GetSelectedAsync())
            .Select(topic => topic.Tag)
            .ToHashSet(StringComparer.Ordinal);
    }

    /// <summary>選んだトピックの記事か。強調するかどうかの判定にだけ使う(収集では絞らない)。</summary>
    bool IsSelected(Article article) => article.Tags.Any(_selected.Contains);
}
