@page "/"
@using TechAntenna.Core
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@inject ITopicStore TopicStore
@inject IDigestStore DigestStore

<PageTitle>Tech Antenna — 技術アンテナ</PageTitle>

<div class="home-layout">
    <div class="home-main">
        <header class="home-heading">
            <p class="eyebrow">YOUR TECH RADAR</p>
            <h1>いま気になる技術を、ひとつの導線に。</h1>
        </header>

        @* **サマリーは2枚に分ける。** 界隈全体と自分の興味では読む目的が違い、
           1枚にまとめると興味の話が全体の話に埋もれる(通知も別々に届く)。
           興味トピックのほうは**トピックを選んでいなければ出さない** ——
           生成もされないので、空の枠だけ置いても案内にならない *@
        @SummaryCard(DigestScope.Overall, "DAILY SUMMARY", "overall")

        @if (_interests is not null || _hasSelectedTopics)
        {
            @SummaryCard(DigestScope.Interests, "YOUR INTERESTS", "interests")
        }

    </div>

    <aside class="topic-rail" aria-labelledby="topic-rail-heading">
        <div class="topic-rail-heading">
            @* eyebrow は**見出しの英訳**にそろえる(サマリーの DAILY SUMMARY と同じ流儀)——
               ここだけ EXPLORE という性格の表示になっていて、見出しと対応していなかった *@
            <div>
                <p class="eyebrow">TRENDING TOPICS</p>
                <h2 id="topic-rail-heading">話題のトピック</h2>
            </div>
            <a href="/settings/topics">一覧を管理</a>
        </div>

        @if (_topics is null)
        {
            <p class="topic-empty">読み込み中…</p>
        }
        else if (_topics.Count == 0)
        {
            @* **話題度が付いていないだけ**のこともあるので、行き先を書く ——
               収集しただけでは話題度は付かず、「話題度を取り直す」で外部トレンドを引く *@
            <p class="topic-empty">
                まだ話題度の付いたトピックがありません。<a href="/settings/jobs">ジョブ</a>の
                「話題度を取り直す」を実行すると、ここに並びます。
            </p>
        }
        else
        {
            <ul class="topic-list">
                @foreach (var topic in _topics)
                {
                    <li>
                        <a href="@($"/settings/topics/{Uri.EscapeDataString(topic.Key)}")">
                            <span>@(topic.Display is { Length: > 0 } display ? display : topic.Key)</span>
                            <small>話題度 @(topic.TrendScore.ToString("0.0"))</small>
                        </a>
                    </li>
                }
            </ul>
        }
    </aside>
</div>

@* サマリー1枚。中身は範囲によらず同じ形なので、見出しと文言だけ差し替える *@
@{
    RenderFragment DigestBody(Digest digest) =>
    @<text>
        @if (digest.Lead is { Length: > 0 })
        {
            <p class="digest-lead">@digest.Lead</p>
        }
        <ul class="digest-items list-unstyled">
            @foreach (var item in digest.Items)
            {
                <li>
                    <strong>@item.Title</strong>
                    <p>
                        @item.Body
                        @if (item.Url is { Length: > 0 } url)
                        {
                            <a href="@url" target="_blank" rel="noopener">出典 →</a>
                        }
                    </p>
                </li>
            }
        </ul>
        <p class="digest-meta">
            @digest.GeneratorName で生成。再生成は<a href="/settings/jobs">ジョブ</a>から。
        </p>
    </text>;

    RenderFragment SummaryCard(DigestScope scope, string eyebrow, string id) =>
    @<text>
        <section class="summary-card" aria-labelledby="summary-heading-@id">
            @{
                var digests = LatestRun(scope);
                var digest = digests.FirstOrDefault();
            }
            <div class="section-heading">
                @* **生成時刻は eyebrow(DAILY SUMMARY)と同じ行に置く。** 見出しと同じ行に
                   並べていた頃は、狭い画面で見出しのほうが縮んで「今日のサマリー」が
                   途中で改行されていた —— eyebrow は字数が少なく、隣に印を置いても
                   まだ余るので、見出しは丸ごと次の行を使える *@
                <p class="section-eyebrow-row">
                    <span class="eyebrow">@eyebrow</span>
                    @if (digest is not null)
                    {
                        @* 生成時刻を出す —— 定期実行でも手動でも、いつの状況の
                           まとめなのかが分からないと鵜呑みにできない。**2枚は別々に作られる**
                           (材料が無い日は片方だけ)ので、時刻も枚数ぶん出す *@
                        <span class="status-pill">@JapanTime.FormatShort(digest.GeneratedAt) 生成</span>
                    }
                    else
                    {
                        <span class="status-pill">未生成</span>
                    }
                </p>
                <h2 id="summary-heading-@id">今日のサマリー<small>@scope.Label()</small></h2>
            </div>
            @if (digest is null)
            {
                <div class="summary-placeholder">
                    <span aria-hidden="true">✦</span>
                    <p>
                        @if (scope == DigestScope.Interests)
                        {
                            <text>
                                選んだ<a href="/settings/topics">興味トピック</a>に当たる記事とイベントから、
                                あなた向けのまとめを LLM が作ります。
                            </text>
                        }
                        else
                        {
                            <text>
                                トピックの選択に関係なく、話題になっている記事・ニュース・論文から
                                技術界隈の動きを LLM がまとめます。
                            </text>
                        }
                        <a href="/settings/jobs">ジョブ</a>の「今日のサマリーの生成」で作れます
                        (LLM の設定が必要です。同じ画面の「定期実行」で時刻を決めておくこともできます)。
                    </p>
                </div>
            }
            else if (digests.Count == 1)
            {
                @DigestBody(digest)
            }
            else
            {
                @* **複数の AI に同じ材料で書かせた回**。AI ごとの折りたたみ(`details`)で読み比べる
                   —— **かつてはタブの帯**にしていたが、生成者の名前はモデル名まで入って長く、
                   スマホでは帯が折り返して「タブに見えない」状態になっていた。折りたたみなら
                   名前の長さに関係なく1行1人で並び、**画面外に隠れる相手もいない**。
                   開いているのはメイン(先頭)だけで、他は押したときだけ開く ——
                   全部開いた状態で出すと、ホームが AI の数だけ縦に伸びる。
                   JS は使わない(サイドバーの開閉・書籍の一覧と同じ流儀) *@
                <div class="digest-compare">
                    @for (var i = 0; i < digests.Count; i++)
                    {
                        var one = digests[i];
                        <details class="digest-one" open="@(i == 0)">
                            <summary>
                                @* 三角は自前で描く(標準マーカーは実寸がブラウザ任せで字下げが合わない) *@
                                <span class="caret" aria-hidden="true"></span>
                                <span class="digest-generator">@one.GeneratorName</span>
                                @if (one.IsPrimary)
                                {
                                    @* **どれがメインか**を出す —— 通知に届くのと同じ1本がどれか
                                       分からないと、読み比べても基準が決まらない *@
                                    <span class="digest-primary">メイン</span>
                                }
                            </summary>
                            @DigestBody(one)
                        </details>
                    }
                </div>
            }
        </section>
    </text>;
}

@code {
    IReadOnlyList<Topic>? _topics;

    /// <summary>技術界隈全体のサマリー(最新の回。メインが先頭、後ろにサブの AI の分)。</summary>
    IReadOnlyList<Digest> _overall = [];

    /// <summary>興味トピックのサマリー(同上)。トピック未選択なら作られないので空のまま。</summary>
    IReadOnlyList<Digest> _interests = [];

    /// <summary>興味トピックが1つでも選ばれているか。**未生成の枠を出すかの判断に使う** ——
    /// 選んでいなければ生成もされないので、枠ごと出さない。</summary>
    bool _hasSelectedTopics;

    /// <summary>範囲に対応する最新の回(枚ごとの描画から引く)。先頭がメイン。</summary>
    IReadOnlyList<Digest> LatestRun(DigestScope scope) =>
        scope == DigestScope.Interests ? _interests : _overall;

    /// <summary>ホームに並べるトピックの数。</summary>
    const int Limit = 10;

    protected override async Task OnInitializedAsync()
    {
        // **話題度の高い順**に並べる。ストアが返す並びは「選択済みを先頭に固定」
        // (収集対象の選択を保存する画面の都合)なので、ここで並べ替え直す ——
        // 「話題のトピック」と名乗る以上、興味の有無ではなく話題度で並べる。
        // 見るのは**単体の話題度**(行に出している数字と同じもの)—— 配下込みだと
        // 「プログラミング」のような大きな親ばかりが並ぶ。
        // **話題度 0 は出さない**(話題になっていないので。まだ 1 件も無いときは
        // 「話題度を取り直す」への案内が出る)
        _topics = (await TopicStore.GetAllAsync())
            .Where(topic => topic.TrendScore > 0)
            .OrderByDescending(topic => topic.TrendScore)
            .ThenBy(topic => topic.Key, StringComparer.Ordinal)
            .Take(Limit)
            .ToList();
        // 出すのは範囲ごとに**最新の回**だけ(履歴は保存してあるが、ホームは「いま」に答える場所)。
        // 複数の AI に書かせている場合はその回の全員が入る(先頭がメイン)
        _overall = await DigestStore.GetLatestRunAsync(DigestScope.Overall);
        _interests = await DigestStore.GetLatestRunAsync(DigestScope.Interests);
        _hasSelectedTopics = (await TopicStore.GetSelectedAsync()).Count > 0;
    }
}
