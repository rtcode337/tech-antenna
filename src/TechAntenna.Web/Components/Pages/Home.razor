@page "/"
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Topics
@inject ITopicStore TopicStore

<PageTitle>tech-antenna</PageTitle>

<div class="home-layout">
    <div class="home-main">
        <header class="home-heading">
            <p class="eyebrow">YOUR TECH RADAR</p>
            <h1>いま気になる技術を、ひとつの導線に。</h1>
            <p>記事・イベント・書籍を、あなたの関心からつなげます。</p>
        </header>

        <section class="summary-card" aria-labelledby="summary-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">DAILY SUMMARY</p>
                    <h2 id="summary-heading">今日のサマリー</h2>
                </div>
                <span class="status-pill">準備中</span>
            </div>
            <div class="summary-placeholder">
                <span aria-hidden="true">✦</span>
                <p>関心トピックに沿って、いま読むべき記事と近いイベントをここへ届けます。</p>
            </div>
        </section>

    </div>

    <aside class="topic-rail" aria-labelledby="topic-rail-heading">
        <div class="topic-rail-heading">
            <div>
                <p class="eyebrow">EXPLORE</p>
                <h2 id="topic-rail-heading">トピック</h2>
            </div>
            <a href="/topics">一覧を管理</a>
        </div>

        @if (_topics is null)
        {
            <p class="topic-empty">読み込み中…</p>
        }
        else if (_topics.Count == 0)
        {
            <p class="topic-empty">収集が進むと、ここにトピックが並びます。</p>
        }
        else
        {
            <ul class="topic-list">
                @foreach (var topic in _topics)
                {
                    <li>
                        <a href="@($"/topics/{Uri.EscapeDataString(topic.Tag)}")">
                            <span>@(topic.Display is { Length: > 0 } display ? display : topic.Tag)</span>
                            <small>話題度 @(topic.TrendScore.ToString("0.0"))</small>
                        </a>
                    </li>
                }
            </ul>
        }
    </aside>
</div>

@code {
    IReadOnlyList<StoredTopic>? _topics;
    protected override async Task OnInitializedAsync()
    {
        _topics = await TopicStore.GetTopicsAsync(10);
    }
}
