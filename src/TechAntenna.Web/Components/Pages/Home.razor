@page "/"
@using TechAntenna.Core
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@inject ITopicStore TopicStore
@inject IDigestStore DigestStore

<PageTitle>Tech Antenna — 技術アンテナ</PageTitle>

<div class="home-layout">
    <div class="home-main">
        <header class="home-heading">
            <p class="eyebrow">YOUR TECH RADAR</p>
            <h1>いま気になる技術を、ひとつの導線に。</h1>
            <p>記事・イベント・書籍を、あなたの関心からつなげます。</p>
        </header>

        <section class="summary-card" aria-labelledby="summary-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">DAILY SUMMARY</p>
                    <h2 id="summary-heading">今日のサマリー</h2>
                </div>
                @if (_digest is not null)
                {
                    @* 生成時刻を出す —— 定期実行でも手動でも、いつの状況の
                       まとめなのかが分からないと鵜呑みにできない *@
                    <span class="status-pill">@JapanTime.FormatShort(_digest.GeneratedAt) 生成</span>
                }
                else
                {
                    <span class="status-pill">未生成</span>
                }
            </div>
            @if (_digest is null)
            {
                <div class="summary-placeholder">
                    <span aria-hidden="true">✦</span>
                    <p>
                        収集した情報と興味トピックから、押さえておくべき情報を LLM がまとめます。
                        <a href="/settings">設定</a>の「今日のサマリーの生成」で作れます
                        (LLM の設定が必要です。同じ画面の「定期実行」で時刻を決めておくこともできます)。
                    </p>
                </div>
            }
            else
            {
                @if (_digest.Lead is { Length: > 0 })
                {
                    <p class="digest-lead">@_digest.Lead</p>
                }
                <ul class="digest-items list-unstyled">
                    @foreach (var item in _digest.Items)
                    {
                        <li>
                            <strong>@item.Title</strong>
                            <p>
                                @item.Body
                                @if (item.Url is { Length: > 0 } url)
                                {
                                    <a href="@url" target="_blank" rel="noopener">出典 →</a>
                                }
                            </p>
                        </li>
                    }
                </ul>
                <p class="digest-meta">
                    @_digest.GeneratorName で生成。再生成は<a href="/settings">設定</a>から。
                </p>
            }
        </section>

    </div>

    <aside class="topic-rail" aria-labelledby="topic-rail-heading">
        <div class="topic-rail-heading">
            <div>
                <p class="eyebrow">EXPLORE</p>
                <h2 id="topic-rail-heading">トピック</h2>
            </div>
            <a href="/topics">一覧を管理</a>
        </div>

        @if (_topics is null)
        {
            <p class="topic-empty">読み込み中…</p>
        }
        else if (_topics.Count == 0)
        {
            <p class="topic-empty">収集が進むと、ここにトピックが並びます。</p>
        }
        else
        {
            <ul class="topic-list">
                @foreach (var topic in _topics)
                {
                    <li>
                        <a href="@($"/topics/{Uri.EscapeDataString(topic.Key)}")">
                            <span>@(topic.Display is { Length: > 0 } display ? display : topic.Key)</span>
                            <small>話題度 @(topic.TrendScore.ToString("0.0"))</small>
                        </a>
                    </li>
                }
            </ul>
        }
    </aside>
</div>

@code {
    IReadOnlyList<Topic>? _topics;
    Digest? _digest;

    protected override async Task OnInitializedAsync()
    {
        _topics = (await TopicStore.GetAllAsync()).Take(10).ToList();
        // 出すのは最新の1件だけ(履歴は保存してあるが、ホームは「いま」に答える場所)
        _digest = await DigestStore.GetLatestAsync();
    }
}
