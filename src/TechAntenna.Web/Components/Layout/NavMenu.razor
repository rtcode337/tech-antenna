@inject NavigationManager Navigation

<div class="top-row">
    <a class="brand" href="">
        @* アンテナ（支柱＋左右へ広がる電波）。マークとワードマークで 1 つのロゴ *@
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <g class="mast" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                <path d="M12 11.2V20" />
                <path d="M9.2 20h5.6" />
            </g>
            <g class="waves" fill="none" stroke-width="1.7" stroke-linecap="round">
                <path d="M8.46 4.96A5 5 0 0 0 8.46 12.04" />
                <path d="M15.54 4.96A5 5 0 0 1 15.54 12.04" />
                <path d="M6.34 2.84A8 8 0 0 0 6.34 14.16" />
                <path d="M17.66 2.84A8 8 0 0 1 17.66 14.16" />
            </g>
            <circle class="hub" cx="12" cy="8.5" r="2.1" />
        </svg>
        <span class="brand-text">
            <span class="brand-name"><span class="brand-name-sub">tech</span>antenna</span>
            <span class="brand-tagline">記事 / イベント / 書籍</span>
        </span>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" id="navbar-toggler" />

@* 階層は details/summary の折りたたみ。**開いているページのグループを既定で開く**が、
   もう一方も三角を押せば開ける —— 開いているページのグループしか出さないと、設定の下に
   いるあいだ記事や書籍へ辿れなくなる。静的 SSR のまま JS を使わずに済む。 *@
@* リンクを押しても閉じない(雛形にあった onclick でのトグルは外した) —— スマホでは
   メニューから続けて別のページへ移ることが多く、そのたびにハンバーガーを開き直すのは煩わしい。
   開閉の状態は遷移後も保つ(復元は wwwroot/nav-menu.js) *@
<div class="nav-scrollable">
    <nav class="nav flex-column">
        <details class="nav-group" open="@InHome">
            <summary class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> ホーム
                </NavLink>
            </summary>
            @* 直近動向(一望のハブ)の下に、種別ごとの一覧をさらに1段下げてぶら下げる。
               ニュースが先 —— 動きの速いものから読む *@
            <div class="nav-item nav-child px-3">
                <NavLink class="nav-link" href="recent">直近動向</NavLink>
            </div>
            <div class="nav-item nav-child nav-grandchild px-3">
                <NavLink class="nav-link" href="news">ニュース</NavLink>
            </div>
            <div class="nav-item nav-child nav-grandchild px-3">
                <NavLink class="nav-link" href="articles">記事</NavLink>
            </div>
            <div class="nav-item nav-child nav-grandchild px-3">
                <NavLink class="nav-link" href="papers">論文</NavLink>
            </div>
            <div class="nav-item nav-child px-3">
                <NavLink class="nav-link" href="books">書籍</NavLink>
            </div>
            <div class="nav-item nav-child px-3">
                <NavLink class="nav-link" href="events">イベント</NavLink>
            </div>
        </details>

        <details class="nav-group" open="@InSettings">
            <summary class="nav-item px-3">
                <NavLink class="nav-link" href="settings">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> 設定
                </NavLink>
            </summary>
            @* トピック(何を集めるかの選択と語彙の再編成)。トピックの詳細もこの下に属する *@
            <div class="nav-item nav-child px-3">
                <NavLink class="nav-link" href="topics">トピック</NavLink>
            </div>
            <div class="nav-item nav-child px-3">
                <NavLink class="nav-link" href="integrations">外部連携</NavLink>
            </div>
        </details>
    </nav>
</div>

@code {
    /// <summary>ホームの下にぶら下げるページ。</summary>
    static readonly string[] HomeChildren =
        ["recent", "news", "articles", "papers", "books", "events"];

    /// <summary>設定の下にぶら下げるページ。トピックの詳細(`/topics/…`)もここに属する。</summary>
    static readonly string[] SettingsChildren = ["topics", "integrations"];

    bool InHome => IsCurrent("") || HomeChildren.Any(IsCurrent);

    bool InSettings => IsCurrent("settings") || SettingsChildren.Any(IsCurrent);

    /// <summary>現在のパスがそのページ(またはその配下)か。`/topics/生成ai` は `topics` に含める。</summary>
    bool IsCurrent(string path)
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

        return path.Length == 0
            ? current.Length == 0
            : current.Equals(path, StringComparison.OrdinalIgnoreCase)
                || current.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
    }
}
