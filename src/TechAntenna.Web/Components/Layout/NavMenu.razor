@code {
    @* **URL の階層が軸の階層と一致している**ので、開くグループの判定は親のパスだけで足りる
       —— かつては軸ごとに子ページの名前を並べた配列を持っていたが(`/news` が
       トレンドの子、という対応をコード側で覚えていた)、いまは `/recent/news` の
       ように URL 自体が親を含むため、名前の一覧をここに書き写す必要が無い *@
    bool InTrending => IsCurrent("recent");

    bool InInterests => IsCurrent("interests");

    bool InClassics => IsCurrent("classics");

    bool InSettings => IsCurrent("settings");

    /// <summary>現在のパスがそのページ(またはその配下)か。`/settings/topics/生成ai` は `settings` に含める。</summary>
    bool IsCurrent(string path)
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

        return path.Length == 0
            ? current.Length == 0
            : current.Equals(path, StringComparison.OrdinalIgnoreCase)
                || current.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
    }
}
