@using TechAntenna.Core
@using TechAntenna.Core.Abstractions
@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@using TechAntenna.Web.Services
@inject TopicCatalog Catalog

@* 1冊分の表示。/books(トピックの折りたたみ)と /classics/books(定番の書籍)で
   同じものを使う —— 別々に書くと本の見た目がページごとにずれる。
   タグは全部出し、HighlightTags に入っているものだけ強調する(記事カードの
   「選んだトピックのタグ」と同じ文法)—— /books は配下のトピックを親のグループへ
   まとめるので、どのタグでそのグループに載ったのかがタグの帯から分かるようにする。
   EmphasizeEndorsed はトピックの中で「記事に名指しされた本」を目立たせるか ——
   推薦本だけを並べる枠では全冊が該当して意味を成さないので切る *@
<li class="mb-3 d-flex gap-2 @(EmphasizeEndorsed && BookPopularity.Endorsements(Book) > 0 ? "endorsed-book" : "") @(Book.IsRead ? "read-book" : "")">
    @if (Book.CoverUrl is { } coverUrl)
    {
        <img src="@coverUrl" alt="" width="48" loading="lazy" />
    }
    <div>
        @* 書名は書誌の詳細ページ(引用で拾った本は ISBN しか持たないのでリンクにならない)。
           その横の印が「この本について AI に聞く」——「押したら別の場所へ飛ぶ」を
           書名そのものに背負わせない(押す人が期待するのは本のページ) *@
        @if (Book.Url is { } url)
        {
            <a href="@url" target="_blank" rel="noopener">@Book.Title</a>
        }
        else
        {
            <span>@Book.Title</span>
        }
        @AskAi(Book)
        <br />
        <small class="text-muted">
            @if (Book.Authors.Count > 0)
            {
                <text>@string.Join("、", Book.Authors) — </text>
            }
            @(Book.Publisher ?? "出版社不明")
            @if (Book.PublishedOn is { } publishedOn)
            {
                <text> — @publishedOn.ToString("yyyy-MM")</text>
            }
            @if (Book.RecommendationCount > 0)
            {
                @* レビュー(読まれた量)とは別軸なので、並べて別々に出す。
                   出典は「推薦 N 件」を押して開く折りたたみにする —— 番号(1・2・3)を
                   並べていた頃は、押す前にどこで薦められているのか分からなかった
                   (どこで薦められたかは本を選ぶ材料そのもの)。畳んでおくのは、1 冊に
                   何本も出典が付くと一覧が出典で埋まるため。JS は使わない *@
                @Sources("sources-recommended", "推薦", Book.RecommendedBy)
            }
            @if (Book.CitationCount > 0)
            {
                @* 引用は推薦と別のバッジにする —— 並べ替えでは1票ずつ合算するが、
                   「まとめ記事が薦めた」のと「そのトピックの記事が引き合いに出した」のは
                   別の話で、1つの数にまとめると出どころが読めなくなる *@
                @Sources("sources-cited", "引用", Book.CitedBy)
            }
            @foreach (var tag in Book.Tags)
            {
                <span class="badge ms-1 @(HighlightTags.Contains(tag) ? "bg-primary" : "bg-light text-dark")">@Catalog.DisplayOf(tag)</span>
            }
        </small>
    </div>
    @* 「読んだ」の印。行の右端に固定する(タグの数で位置が動かないよう、
       メタ行の中ではなく flex の3つ目の子として置く)。
       押せるのは ShowReadToggle を立てたページだけ —— 出版トレンドの書籍
       (TrendBooks)は NewRelease を Book の形に写しただけで保存された本ではなく、
       押しても記録する先が無い。押せないページでも印は出す(下に沈む理由が読める) *@
    @if (ShowReadToggle)
    {
        @* value は状態で変えない(`toggle:<Id>` のまま)—— keep-focus.js は押した値で
           ボタンを探し直すので、`read:` ↔ `unread:` と入れ替わると POST 後に見つからず、
           数百行の一覧の先頭へ戻ってしまう。裏返す判断は保存先が持つ(IBookStore) *@
        <button type="submit" class="btn btn-sm read-toggle @(Book.IsRead ? "is-read" : "")"
                name="Action" value="@BookReadAction.Value(Book.Id)"
                aria-pressed="@(Book.IsRead ? "true" : "false")"
                title="@ToggleHint()">
            @(Book.IsRead ? "✓ 読んだ" : "読んだ")
        </button>
    }
    else if (Book.IsRead)
    {
        <span class="read-mark" title="@ToggleHint()">✓ 読んだ</span>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public Book Book { get; set; } = default!;

    /// <summary>
    /// 強調するタグ(正規化済みキー)。/books では「そのグループに反応したタグ」
    /// (グループのトピック+配下)が入る。空なら全タグを控えめに出すだけ。
    /// </summary>
    [Parameter]
    public IReadOnlySet<string> HighlightTags { get; set; } = new HashSet<string>();

    /// <summary>記事に名指しされた本(推薦・引用)を左帯 + 薄い面で目立たせるか。</summary>
    [Parameter]
    public bool EmphasizeEndorsed { get; set; }

    /// <summary>
    /// 「この本について AI に聞く」印。書名の横に置く小さなリンクで、押すと
    /// <see cref="BookAiQuestion"/> の問いを持って Google の AI モードが開く。
    ///
    /// 字を持たない印なので <c>aria-label</c> でどの本の話かを言う ——
    /// 一覧には同じ印が冊数ぶん並ぶので、「AI に聞く」だけでは読み上げで区別できない。
    /// </summary>
    public static RenderFragment AskAi(Book book) =>
        @<a class="ask-ai" href="@BookAiQuestion.Url(book)" target="_blank" rel="noopener"
            title="この本について AI に聞く(Google の AI モードが開きます)"
            aria-label="@($"『{book.Title}』について AI に聞く")">
            @* 印は文字ではなく SVG で描く —— ✦ のような記号は持っていない環境で豆腐になる。
               currentColor なのでダークモードでも色が付いてくる(ロゴと同じ流儀) *@
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                <path fill="currentColor"
                      d="M12 1.5c0 4.7 3.8 8.5 8.5 10-4.7 1.5-8.5 5.3-8.5 10-0-4.7-3.8-8.5-8.5-10 4.7-1.5 8.5-5.3 8.5-10z" />
            </svg>
        </a>;

    /// <summary>
    /// 出典の折りたたみ(推薦・引用)。中身が同じ形なので1か所から描く ——
    /// 2つ書き分けると、題名の代替や折りたたみの作りが片方だけずれる。
    /// </summary>
    RenderFragment Sources(string kind, string label, IReadOnlyList<SourceArticle> articles) =>
        @<details class="sources @kind ms-1">
            <summary>@label @articles.Count 件</summary>
            <ul class="sources-list list-unstyled">
                @foreach (var article in articles)
                {
                    <li>
                        <a href="@article.Url" target="_blank" rel="noopener">
                            @* 題名はこの列より前に集めた分には無い。URL で代替する ——
                               押せない行にはしない(次の収集で題名が入る) *@
                            @(string.IsNullOrWhiteSpace(article.Title) ? article.Url : article.Title)
                        </a>
                    </li>
                }
            </ul>
        </details>;

    /// <summary>
    /// 「読んだ」を押せるようにするか。押すのはページのフォームへの submit なので、
    /// 立てるページは <c>&lt;form method="post"&gt;</c> で囲み、<c>Action</c> を
    /// <c>read:&lt;Id&gt;</c> / <c>unread:&lt;Id&gt;</c> として受けること。
    /// </summary>
    [Parameter]
    public bool ShowReadToggle { get; set; }

    /// <summary>印の吹き出し。いつ読んだかは日本時間で出す(JapanTime)。</summary>
    string ToggleHint() =>
        Book.ReadAt is { } readAt
            ? $"{JapanTime.FormatDate(readAt)} に読んだ" + (ShowReadToggle ? "(押すと戻す)" : "")
            : "読んだ本として印を付ける(一覧では下に回ります)";
}
