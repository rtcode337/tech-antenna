@using TechAntenna.Core.Models
@using TechAntenna.Core.Topics
@inject TopicCatalog Catalog

@* 1冊分の表示。/books(トピックの折りたたみ)と /classics/books(定番の書籍)で
   同じものを使う —— 別々に書くと本の見た目がページごとにずれる。
   タグは全部出し、HighlightTags に入っているものだけ強調する(記事カードの
   「選んだトピックのタグ」と同じ文法)—— /books は配下のトピックを親のグループへ
   まとめるので、どのタグでそのグループに載ったのかがタグの帯から分かるようにする。
   EmphasizeRecommended はトピックの中で推薦本を目立たせるか ——
   推薦本だけを並べる枠では全冊が該当して意味を成さないので切る *@
<li class="mb-3 d-flex gap-2 @(EmphasizeRecommended && Book.RecommendationCount > 0 ? "recommended-book" : "")">
    @if (Book.CoverUrl is { } coverUrl)
    {
        <img src="@coverUrl" alt="" width="48" loading="lazy" />
    }
    <div>
        @if (Book.Url is { } url)
        {
            <a href="@url" target="_blank" rel="noopener">@Book.Title</a>
        }
        else
        {
            <span>@Book.Title</span>
        }
        <br />
        <small class="text-muted">
            @if (Book.Authors.Count > 0)
            {
                <text>@string.Join("、", Book.Authors) — </text>
            }
            @(Book.Publisher ?? "出版社不明")
            @if (Book.PublishedOn is { } publishedOn)
            {
                <text> — @publishedOn.ToString("yyyy-MM")</text>
            }
            @if (Book.RecommendationCount > 0)
            {
                @* レビュー(読まれた量)とは別軸なので、並べて別々に出す。
                   **出典は全部たどれるようにする** —— 1 本目だけをリンクにしていた頃は、
                   「3 件」と数だけ見えて残り 2 本へ行けなかった(どこで薦められているかは
                   本を選ぶ材料そのもの)。記事の題名は保存していない(複製にしないため)ので、
                   番号で並べる *@
                <span class="recommended ms-1">
                    推薦 @Book.RecommendationCount 件
                    @for (var i = 0; i < Book.RecommendedBy.Count; i++)
                    {
                        <a href="@Book.RecommendedBy[i]" target="_blank" rel="noopener"
                           title="この本を薦めている記事 @(i + 1)">@(i + 1)</a>
                    }
                </span>
            }
            @if (Book.ReviewCount is { } reviewCount and > 0)
            {
                <span class="review ms-1">
                    ★ @(Book.ReviewAverage?.ToString("0.0") ?? "—")
                    <span class="text-muted">(@reviewCount 件)</span>
                </span>
            }
            @foreach (var tag in Book.Tags)
            {
                <span class="badge ms-1 @(HighlightTags.Contains(tag) ? "bg-primary" : "bg-light text-dark")">@Catalog.DisplayOf(tag)</span>
            }
        </small>
    </div>
</li>

@code {
    [Parameter, EditorRequired]
    public Book Book { get; set; } = default!;

    /// <summary>
    /// 強調するタグ(正規化済みキー)。/books では「そのグループに反応したタグ」
    /// (グループのトピック+配下)が入る。空なら全タグを控えめに出すだけ。
    /// </summary>
    [Parameter]
    public IReadOnlySet<string> HighlightTags { get; set; } = new HashSet<string>();

    /// <summary>推薦本を左帯 + 薄い面で目立たせるか。</summary>
    [Parameter]
    public bool EmphasizeRecommended { get; set; }
}
