<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TechAntenna.Core\TechAntenna.Core.csproj" />
    <ProjectReference Include="..\TechAntenna.Infrastructure\TechAntenna.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ランタイムの EF Core と版をそろえる。Npgsql.EntityFrameworkCore.PostgreSQL(10.0.3)が
      要求する EF Core は [10.0.4, 11.0.0) の範囲なので、ここで指した版に全部そろう
      (実測: Design を 10.0.11 にすると EntityFrameworkCore と .Relational も 10.0.11 に統一され、
      警告 0 でビルドが通る)。
      かつて 10.0.4 に留めていたのは、.Relational が 10.0.4 と 10.0.11 で衝突して MSB3277 が
      出たため。Npgsql の範囲が広がって解消したので、その制約は外してある。
      Npgsql が 11 系(= EF Core 11)へ上がるときは、こちらも一緒に上げること。
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- 開発ビルドでは静的アセットを事前圧縮しない。MapStaticAssets は
         ビルド時に作った .gz/.br を配信するので、アプリを動かしたままビルドし直すと
         (dotnet watch を止め忘れる・watch だけ落ちてアプリが残る)、動いているプロセスが
         覚えている指紋と obj 側の圧縮ファイルが食い違い、gzip を要求したクライアントに
         中身が空の CSS を返す —— ブラウザだけスタイルが全部消えて、curl では再現しない
         という分かりにくい壊れ方になる。事前圧縮を切っても UseResponseCompression が
         その場で圧縮するので、開発中に困ることはない(発行=Release では事前圧縮が効く)。 -->
    <CompressionEnabled Condition="'$(Configuration)' == 'Debug'">false</CompressionEnabled>
  </PropertyGroup>


  <ItemGroup>
    <!-- トピックの語彙と別名の対応表。実行時に読むので発行物に含める -->
    <Content Update="topic-seed.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
