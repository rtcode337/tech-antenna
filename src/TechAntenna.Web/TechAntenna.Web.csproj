<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TechAntenna.Core\TechAntenna.Core.csproj" />
    <ProjectReference Include="..\TechAntenna.Infrastructure\TechAntenna.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- **開発ビルドでは静的アセットを事前圧縮しない。** MapStaticAssets は
         ビルド時に作った .gz/.br を配信するので、**アプリを動かしたままビルドし直す**と
         (dotnet watch を止め忘れる・watch だけ落ちてアプリが残る)、動いているプロセスが
         覚えている指紋と obj 側の圧縮ファイルが食い違い、**gzip を要求したクライアントに
         中身が空の CSS を返す** —— ブラウザだけスタイルが全部消えて、curl では再現しない
         という分かりにくい壊れ方になる。事前圧縮を切っても UseResponseCompression が
         その場で圧縮するので、開発中に困ることはない(発行=Release では事前圧縮が効く)。 -->
    <CompressionEnabled Condition="'$(Configuration)' == 'Debug'">false</CompressionEnabled>
  </PropertyGroup>


  <ItemGroup>
    <!-- トピックの語彙と別名の対応表。実行時に読むので発行物に含める -->
    <Content Update="topic-seed.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
