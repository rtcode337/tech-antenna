# User secrets are stored outside the repo, but never commit a stray copy
secrets.json

# Environment / local config
.env
.env.local
# 単体定義は値を直書きする(パスワードやキーがそのまま入る)ため、
# リポジトリに置くのは docker-compose.standalone.example.yml の方だけにする
docker-compose.standalone.yml

# CLI ブリッジへ渡す認証情報を置いていた場所。**いまは使わない**(CLI を同梱して
# プロセスで起動する方式に戻し、トークンは子プロセスの環境変数で渡す)が、
# 以前の版で動かした環境には OAuth トークンを含む settings.db が残っている ——
# 無視しておかないと、更新した人が git add -A でそれを拾う
/state/

# コンテナのデータ置き場(Postgres のデータと Data Protection の鍵)。
# 名前付きボリュームではなくここへバインドしてあるので、丸ごとコピーすればバックアップになる。
# 先頭の / でリポジトリ直下だけに限る(付けないと全階層の data/ を無言で無視する)
/data/

# EF Core
*.mdf
*.ldf
*.ndf

# OS
.DS_Store
Thumbs.db

# クラッシュ時のコアダンプ(.NET は起動ディレクトリに core.<pid> を吐き、数百 MB になる)
core.*

# Python(tools/ のアイコン生成スクリプト)のバイトコードキャッシュ
__pycache__/
