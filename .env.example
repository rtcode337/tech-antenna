# docker compose で使う設定の雛形。コピーして .env を作り、実値を入れる:
#
#   cp .env.example .env
#
# .env はコミットしない(.gitignore 済み)。コメントアウトしてある項目は既定値のままでよい。

# --- DB ---
# 変えるなら**初回起動の前に**(data/postgres を作るときにしか効かず、後から変えても
# DB 側は変わらないまま接続文字列だけがずれる)
# POSTGRES_PASSWORD=techantenna
# POSTGRES_USER=techantenna
# POSTGRES_DB=techantenna
# docker-compose.dev.yml を重ねたときにホスト側で開くポート(127.0.0.1 のみ)。
# 手元で別の何かが 7021 を使っているときだけ変える(コンテナ内は 7021 固定)
# POSTGRES_PORT=7021

# --- 待ち受け ---
# ホスト側のポート(コンテナ内は 7020 固定)
# PORT=7020
# TZ=Asia/Tokyo

# --- 定期実行(既定はすべて無効。収集も要約も画面のボタンを押したときだけ動く)---
# 外部 API や LLM の無料枠を意図せず使い切らないための既定。定期実行にするときだけ true
# 記事とイベントの収集
# COLLECTION_AUTORUN=false
# 書籍の収集
# BOOKS_AUTORUN=false
# 記事の要約
# SUMMARY_AUTORUN=false

# --- 外部 API のキー(未設定ならその収集ジョブが動かないだけ)---
# connpass API v2 の API キー
CONNPASS_API_KEY=
# Doorkeeper の Public API アクセストークン
DOORKEEPER_ACCESS_TOKEN=
# Google Books API キー(未設定だと検索が常に 429 になるため、書籍収集には必須)
GOOGLE_BOOKS_API_KEY=
# 楽天ウェブサービスのアプリ ID。書籍のレビュー件数(読まれている度合い)の取得に使う。
# 未設定なら書籍は集まるが、読まれている順に並べられない
RAKUTEN_APPLICATION_ID=
# 楽天のアクセスキー。アプリ ID と一緒に発行されている場合だけ入れる
RAKUTEN_ACCESS_KEY=
# Qiita のアクセストークン(任意)。推薦本の収集は未設定でも動くが、
# API の上限が 60 → 1000 リクエスト/時になる
QIITA_ACCESS_TOKEN=

# --- 記事の要約(どちらか一方でよい。両方あれば Claude Code が優先される)---
# 1) Claude Code のヘッドレス実行。従量課金にならずサブスクリプションの枠で動く。
#    Claude Code にログイン済みの端末で `claude setup-token` を実行して得たトークンを入れる
CLAUDE_CODE_OAUTH_TOKEN=
# 要約に使うモデル。空なら CLI の既定
# CLAUDE_CODE_MODEL=claude-haiku-4-5
#
# 2) Anthropic API キー。従量課金
ANTHROPIC_API_KEY=
# 要約に使うモデル。コストを抑えるなら claude-haiku-4-5
# ANTHROPIC_MODEL=claude-opus-5

# --- リバースプロキシ配下に置く場合 ---
# X-Forwarded-* を信頼する(プロキシ以外から直接叩けない構成のときだけ true)
# FORWARDED_HEADERS_ENABLED=false

# --- イメージ ---
# 特定のコミットのイメージへ戻すときだけ指定する
# TECH_ANTENNA_IMAGE=ghcr.io/rtcode337/tech-antenna:sha-xxxxxxx
