# docker compose で使う設定の雛形。コピーして .env を作り、実値を入れる:
#
#   cp .env.example .env
#
# .env はコミットしない(.gitignore 済み)。コメントアウトしてある項目は既定値のままでよい。

# --- DB ---
# 変えるなら初回起動の前に(data/postgres を作るときにしか効かず、後から変えても
# DB 側は変わらないまま接続文字列だけがずれる)
# POSTGRES_PASSWORD=techantenna
# POSTGRES_USER=techantenna
# POSTGRES_DB=techantenna
# docker-compose.dev.yml を重ねたときにホスト側で開くポート(127.0.0.1 のみ)。
# 手元で別の何かが 7021 を使っているときだけ変える(コンテナ内は 7021 固定)
# POSTGRES_PORT=7021

# --- 待ち受け ---
# ホスト側のポート(コンテナ内は 7020 固定)
# PORT=7020
# TZ=Asia/Tokyo

# --- 定期実行 ---
# オン/オフは画面(設定)のチェックボックスで切り替える(既定はすべて無効)。
# ここで設定するものは無い

# --- 外部 API のキー ---
# キーはここでは渡せない。起動後に画面(設定 → 外部連携)の「キーの設定」列から
# 入れる —— 暗号化して DB に保存され、再起動なしで効く。実値を設定ファイルに置かない

# --- LLM の相手を Chiezo から選ぶ(任意)---
# Chiezo(LAN 内の知識サーバー)の URL。入れると「設定 → 外部連携」の一番上で相手(Gemini・Claude Code・
# 推論サーバ…)を選べる。鍵は Chiezo 側が持っているので、こちらにキーは要らない。
# 空でも、同梱の Claude Code CLI と Anthropic API は画面から選べる。
# chiezo-api のルート URL を書く(`/v1` は付けない)。アプリのコンテナから届く
# アドレスにすること(localhost はコンテナ自身を指すので不可)
# CHIEZO_URL=http://192.168.1.10:7010

# --- 記事の要約(モデルの選択。トークン・キー自体は画面から設定する)---
# Claude Code 方式で使うモデル。既定は claude-sonnet-5 —— CLI の既定に任せると
# 重いモデル(実測 claude-fable-5)になり、サブスクの週間枠を消費しすぎるため明示している
# CLAUDE_CODE_MODEL=claude-sonnet-5
# Claude Code の CLI はイメージに同梱してある(アプリがプロセスとして起動する)。
# 別の場所へ入れているときだけ実行ファイルのパスを渡す
# ClaudeCode__ExecutablePath=claude
# 1回の呼び出しの上限(秒)。ブリッジ側の保険の既定値として渡す
# CLAUDE_CODE_TIMEOUT_SECONDS=300
# Anthropic API 方式で使うモデル。コストを抑えるなら claude-haiku-4-5
# ANTHROPIC_MODEL=claude-opus-5

# --- 今日のサマリーの ntfy 通知 ---
# 接続先(ベース URL・トピック名・トークン)は画面(設定 → 外部連携)から設定する。
# 通知のオン/オフも画面(設定)から。ここに残るのはタップで開く URL だけ
# (「この環境の公開 URL」というデプロイ側の事実のため)
NTFY_CLICK_URL=

# --- リバースプロキシ配下に置く場合 ---
# X-Forwarded-* を信頼する(プロキシ以外から直接叩けない構成のときだけ true)
# FORWARDED_HEADERS_ENABLED=false

# --- イメージ ---
# 特定のコミットのイメージへ戻すときだけ指定する
# TECH_ANTENNA_IMAGE=ghcr.io/rtcode337/tech-antenna:sha-xxxxxxx

# data/ に書き込むときのユーザー。未設定なら 10001:10001(ホストに実在しない番号)。
# data/ をホストから直接編集・書き戻ししたいときだけ `id -u` / `id -g` を設定する
# (所有者合わせは起動前に init サービスが自動で行う)
#TECH_ANTENNA_UID=1000
#TECH_ANTENNA_GID=1000
